{
  "permissions": {
    "allow": [
      "Bash(uv run *)",
      "Bash(pkill -f 'sass --watch')",
      "Bash(xargs -r kill)",
      "Bash(node --test tests/)",
      "Bash(node --test)",
      "Bash(npx sass *)",
      "Bash(awk -F: '{print $3}')",
      "Bash(python3 -)",
      "Bash(npm test *)",
      "Bash(curl -s http://127.0.0.1:5099/)",
      "Bash(kill %1)",
      "Bash(npm run *)",
      "Bash(git rm *)",
      "Bash(node --test tests/color-drift.test.js)",
      "Bash(gh repo *)",
      "Bash(sort -t: -k3)",
      "Bash(uniq -c -f2)",
      "Bash(git mv *)",
      "Bash(uv sync *)",
      "Bash(git add *)",
      "Bash(npm -v)",
      "WebFetch(domain:docs.npmjs.com)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "/home/javier/.local/bin/headroom wrap selfheal --marker headroom-wrap-selfheal",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "env": {
    "ANTHROPIC_BASE_URL": "http://127.0.0.1:8787",
    "ENABLE_TOOL_SEARCH": "true"
  }
}
