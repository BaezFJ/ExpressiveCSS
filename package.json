{
  "name": "routeplatecss",
  "version": "0.1.0",
  "description": "RoutePlateCSS - a Material Design 3 front-end framework.",
  "type": "module",
  "main": "./dist/js/routeplate.cjs",
  "module": "./dist/js/routeplate.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/js/routeplate.mjs",
      "require": "./dist/js/routeplate.cjs",
      "default": "./dist/js/routeplate.mjs"
    },
    "./css": "./dist/css/routeplate.css",
    "./css/min": "./dist/css/routeplate.min.css",
    "./scss": "./src/sass/routeplate.scss",
    "./scss/*": "./src/sass/*"
  },
  "files": [
    "dist",
    "src/sass",
    "src/ts"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "run-s clean build:css build:js build:types",
    "build:css": "run-s build:css:expanded build:css:min",
    "build:css:expanded": "sass src/sass/routeplate.scss dist/css/routeplate.css --style=expanded --source-map --load-path=src/sass",
    "build:css:min": "sass src/sass/routeplate.scss dist/css/routeplate.min.css --style=compressed --source-map --load-path=src/sass",
    "build:js": "run-s build:js:esm build:js:cjs build:js:iife build:js:iife-min",
    "build:js:esm": "esbuild src/ts/index.ts --bundle --format=esm --target=es2020 --outfile=dist/js/routeplate.mjs --sourcemap",
    "build:js:cjs": "esbuild src/ts/index.ts --bundle --format=cjs --target=es2020 --outfile=dist/js/routeplate.cjs --sourcemap",
    "build:js:iife": "esbuild src/ts/index.ts --bundle --format=iife --global-name=RoutePlate --target=es2020 --outfile=dist/js/routeplate.js --sourcemap",
    "build:js:iife-min": "esbuild src/ts/index.ts --bundle --format=iife --global-name=RoutePlate --target=es2020 --outfile=dist/js/routeplate.min.js --minify --sourcemap",
    "build:types": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "run-s build:js:esm test:run",
    "test:run": "node --test",
    "test:watch": "node --test --watch",
    "watch": "run-p watch:css watch:js",
    "watch:css": "sass --watch src/sass/routeplate.scss:dist/css/routeplate.css --style=expanded --source-map --load-path=src/sass",
    "watch:js": "esbuild src/ts/index.ts --bundle --format=iife --global-name=RoutePlate --target=es2020 --outfile=dist/js/routeplate.js --sourcemap --watch=forever"
  },
  "engines": {
    "node": ">=20"
  },
  "browserslist": [
    "last 5 Chrome versions",
    "last 5 Firefox versions",
    "not IE 11",
    "not dead"
  ],
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.3",
    "sass": "^1.102.0",
    "typescript": "^7.0.2"
  }
}
