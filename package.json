{
  "name": "@expressivecss/expressive",
  "version": "0.7.0",
  "description": "ExpressiveCSS - a Material Design 3 front-end framework.",
  "license": "MIT",
  "author": "BaezFJ <baezdevs@gmail.com>",
  "homepage": "https://www.expressivecss.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BaezFJ/ExpressiveCSS.git"
  },
  "bugs": {
    "url": "https://github.com/BaezFJ/ExpressiveCSS/issues"
  },
  "keywords": [
    "css",
    "sass",
    "scss",
    "material-design",
    "material-design-3",
    "md3",
    "front-end",
    "framework",
    "ui",
    "components",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/js/expressive.cjs",
  "module": "./dist/js/expressive.mjs",
  "types": "./dist/types/index.d.ts",
  "unpkg": "./dist/js/expressive.min.js",
  "jsdelivr": "./dist/js/expressive.min.js",
  "sideEffects": [
    "./dist/js/*",
    "*.css",
    "*.scss"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/js/expressive.mjs",
      "require": "./dist/js/expressive.cjs",
      "default": "./dist/js/expressive.mjs"
    },
    "./css": "./dist/css/expressive.css",
    "./css/min": "./dist/css/expressive.min.css",
    "./scss": "./src/sass/expressive.scss",
    "./scss/*": "./src/sass/*"
  },
  "files": [
    "dist",
    "src/sass",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "npm run build",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "run-s clean build:css build:js build:types",
    "build:css": "run-s build:css:expanded build:css:min",
    "build:css:expanded": "sass src/sass/expressive.scss dist/css/expressive.css --style=expanded --source-map --load-path=src/sass",
    "build:css:min": "sass src/sass/expressive.scss dist/css/expressive.min.css --style=compressed --source-map --load-path=src/sass",
    "build:js": "run-s build:js:esm build:js:cjs build:js:iife build:js:iife-min",
    "build:js:esm": "esbuild src/ts/index.ts --bundle --format=esm --target=es2020 --outfile=dist/js/expressive.mjs --sourcemap",
    "build:js:cjs": "esbuild src/ts/index.ts --bundle --format=cjs --target=es2020 --outfile=dist/js/expressive.cjs --sourcemap",
    "build:js:iife": "esbuild src/ts/index.ts --bundle --format=iife --global-name=Expressive --target=es2020 --outfile=dist/js/expressive.js --sourcemap",
    "build:js:iife-min": "esbuild src/ts/index.ts --bundle --format=iife --global-name=Expressive --target=es2020 --outfile=dist/js/expressive.min.js --minify --sourcemap",
    "build:types": "tsc -p tsconfig.build.json",
    "build:semantics": "node scripts/gen-semantics.mjs",
    "build:llms": "uv run python scripts/gen_llms.py",
    "docs:dev": "run-s build docs:watch",
    "docs:watch": "run-p watch:css watch:js docs:server",
    "docs:server": "astro dev --root docs",
    "docs:build": "astro build --root docs",
    "docs:preview": "astro preview --root docs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "run-s build:js build:css test:run",
    "test:run": "node --test",
    "test:watch": "node --test --watch",
    "test:visual": "node visual/run.mjs",
    "test:visual:report": "playwright show-report visual/report",
    "watch": "run-p watch:css watch:js",
    "watch:css": "sass --watch src/sass/expressive.scss:dist/css/expressive.css --style=expanded --source-map --load-path=src/sass",
    "watch:js": "esbuild src/ts/index.ts --bundle --format=iife --global-name=Expressive --target=es2020 --outfile=dist/js/expressive.js --sourcemap --watch=forever"
  },
  "engines": {
    "node": ">=20"
  },
  "browserslist": [
    "last 5 Chrome versions",
    "last 5 Firefox versions",
    "not IE 11",
    "not dead"
  ],
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "astro": "^7.2.8",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.3",
    "sass": "^1.102.0",
    "typescript": "^7.0.2"
  }
}
