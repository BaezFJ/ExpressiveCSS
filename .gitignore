# Dependencies
node_modules/

# Build output and generated assets
dist/
build/
*.tsbuildinfo
*.map
.sass-cache/

# Frozen copies of files that already live in this repository. The freeze
# writes them (the deploy copies website/ verbatim) but committing them would
# put ~570 KB of duplicated prose in git and rewrite it on every docs change.
# website/llms.txt is deliberately not here: it is small and generated, and a
# reader should see it. Same arrangement as website/dist/, covered by `dist/`.
website/llm.md
website/m3-guidelines.md
website/llms-full.txt

# Python environments, bytecode, and packaging
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
pip-wheel-metadata/

# Visual regression. Nothing here is committed on purpose: __shots__/ is the
# base revision photographed at the start of each run (100+ MB of PNG),
# .visual-base/ is the git worktree it was served from, and report/ and
# results/ are that run's output. See visual/run.mjs.
#
# test-results/ is Playwright's default outputDir. visual/playwright.config.js
# points outputDir at visual/results/ instead, so nothing writes it during a
# normal run -- but any invocation that does not pass that config falls back to
# the default and drops a .last-run.json at the repo root.
visual/__shots__/
visual/report/
visual/results/
test-results/
.visual-base/

