---
import type { Sections } from "../lib/sections";

/**
 * The page's table of contents and content column.
 *
 * The TOC is generated from the same objects the sections are rendered from,
 * so a section and its entry cannot disagree. It comes first in the document
 * so keyboard and screen reader users reach it before the content; from
 * Large up docs.css places it in a sticky column beside the content, and
 * below that it is a closed disclosure under the page header. The
 * `toc-extra` slot takes extra entries (an off-site link, say). `wide`
 * gives pages with wide, interactive demos a wider content column.
 */
interface Props {
  sections: Sections;
  wide?: boolean;
}

const { sections, wide = false } = Astro.props;
---
<div class="accordion docs-toc">
  <details>
    <summary>On this page</summary>
    <nav aria-label="On this page">
      <ul class="section table-of-contents">
        {Object.values(sections).map((s) => (
          <li><a href={`#${s.id}`}>{s.label}</a></li>
        ))}
        <slot name="toc-extra" />
      </ul>
    </nav>
  </details>
</div>
<div class:list={["docs-page-content", { wide }]}>
  <slot />
</div>
