---
/**
 * A code sample. Write the markup for real -- the component escapes it -- and
 * keep the body flush left: <pre> preserves the indentation it is given.
 *
 * The sample is an explicit template literal so its whitespace stays the
 * author's rather than the formatter's.
 *
 * tests/semantics.test.js checks every one of these against SEMANTICS.md. A
 * sample that deliberately shows non-conforming markup -- a migration
 * before/after, say -- opts out with a reason:
 *
 *     <Code check={false} reason="0.7.0 markup, shown for migration" code={`…`} />
 *
 * The reason is required; the test fails on a bare opt-out, so an exemption
 * always says why it is still earned. Neither argument renders.
 */
import { Code as Shiki } from "astro:components";

interface Props {
  code: string;
  // fallow-ignore-next-line unused-component-props
  check?: boolean;
  // fallow-ignore-next-line unused-component-props
  reason?: string;
}

const { code } = Astro.props;
const source = code.trim();

// Samples do not name their language, so it is guessed from the source.
// Anything unrecognised stays plain text.
const LANGUAGES = [
  ["html", /^<[!/a-z]/i],
  ["scss", /^@use\b/],
  ["css", /^(?:@media\b|:root\b|(?:html|body)(?:\s|,|\{)|[.#][\w-]+[\s:{.#>[+~])/i],
  ["bash", /^(?:npm|npx|pnpm|yarn)\s/],
  ["javascript", /\b(?:const|let|var|function|import|new|document|Expressive)\b|^(?:instance|dialog|list)\./m],
] as const;
const lang = LANGUAGES.find(([, test]) => test.test(source))?.[0] ?? "plaintext";
---
{/* Highlighted at build time. The css-variables theme leaves the colors to docs.css. */}
<Shiki code={source} lang={lang} theme="css-variables" />
