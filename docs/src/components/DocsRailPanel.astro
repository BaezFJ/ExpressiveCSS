---
import type { DocsGroup, DocsPage } from "../data/nav";
import { route, sectionsOf } from "../lib/catalogue";

/**
 * The contents of one category's side panel in the docs rail: its pages,
 * with each section as a dropdown that starts open when it holds the
 * current page. The popover itself stays in DocsNavigation so the page's
 * popovertarget ids resolve in one file.
 */
interface Props {
  group: DocsGroup;
  current: string;
}

const { group, current } = Astro.props;
const link = (page: DocsPage) => ({
  href: route(page.id),
  "aria-current": current === page.id ? "page" : undefined,
});
---
{sectionsOf(group).map((run) => run.label ? (
  <details open={run.pages.some((page) => page.id === current)}>
    <summary>{run.label}</summary>
    {run.pages.map((page) => <a {...link(page)}>{page.label}</a>)}
  </details>
) : run.pages.map((page) => <a {...link(page)}>{page.label}</a>))}
