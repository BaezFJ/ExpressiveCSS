---
/** Plugin options. The header carries no information beyond its rows, so it lives here once instead of being retyped per page. */
---
<table class="striped">
  <thead>
    <tr>
      <th>Name</th>
      <th>Type</th>
      <th>Default</th>
      <th>Description</th>
    </tr>
  </thead>
  <tbody>
    <slot />
  </tbody>
</table>
