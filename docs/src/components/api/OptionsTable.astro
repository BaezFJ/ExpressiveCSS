---
/**
 * Plugin options. The header carries no information beyond its rows, so it
 * lives here once instead of being retyped per page. The table scrolls in
 * place when its code values are wider than a compact window.
 */
---
<div class="docs-table-scroll">
<table class="striped">
  <thead>
    <tr>
      <th>Name</th>
      <th>Type</th>
      <th>Default</th>
      <th>Description</th>
    </tr>
  </thead>
  <tbody>
    <slot />
  </tbody>
</table>
</div>
