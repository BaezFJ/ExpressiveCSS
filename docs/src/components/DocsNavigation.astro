---
import { NAV } from "../data/nav";
import { groupOf, route, sectionsOf } from "../lib/catalogue";

/**
 * Site navigation. From Expanded up a collapsed rail holds the catalogue
 * groups; from Large up the current group's pages stay beside it. Below
 * Large the app bar's menu button opens the same catalogue as a modal sheet.
 */
interface Props {
  current: string;
}

const { current } = Astro.props;
const currentGroup = groupOf(current);
const id = (label: string) => `docs-group-${label.toLowerCase()}`;
---
<div class="docs-navigation-wide">
  <nav class="navigation-rail no-autoinit docs-category-rail" aria-label="Documentation categories">
    {NAV.map((group) => (
      <a
        href={route(group.pages[0].id)}
        class={group === currentGroup ? "active" : undefined}
        aria-current={group === currentGroup ? "true" : undefined}
      >
        <span class="material-symbols" aria-hidden="true">{group.icon}</span>
        {group.label}
      </a>
    ))}
  </nav>
  <nav class="docs-page-navigation" aria-labelledby="docs-page-navigation-title">
    <h2 id="docs-page-navigation-title" class="title-medium">{currentGroup.label}</h2>
    {sectionsOf(currentGroup).map((run) => (
      <Fragment>
        {run.label && <h3 class="label-large on-surface-variant-text">{run.label}</h3>}
        <ul class="list">
          {run.pages.map((page) => (
            <li>
              <a href={route(page.id)} aria-current={current === page.id ? "page" : undefined}>
                {page.label}
              </a>
            </li>
          ))}
        </ul>
      </Fragment>
    ))}
  </nav>
</div>

<dialog id="docs-navigation-dialog" class="side-sheet start docs-navigation-dialog" aria-labelledby="docs-navigation-title">
  <header>
    <h2 id="docs-navigation-title">Browse documentation</h2>
    <form method="dialog">
      <button type="submit" aria-label="Close navigation">
        <span class="material-symbols" aria-hidden="true">close</span>
      </button>
    </form>
  </header>
  <div>
  <nav aria-label="Documentation pages">
    <div class="accordion">
      {NAV.map((group) => (
        <details open={group === currentGroup} id={id(group.label)}>
          <summary>
            <span class="material-symbols" aria-hidden="true">{group.icon}</span>
            {group.label}
          </summary>
          {sectionsOf(group).map((run) => (
            <Fragment>
              {run.label && <h3 class="label-large on-surface-variant-text">{run.label}</h3>}
              <ul class="list">
                {run.pages.map((page) => (
                  <li>
                    <a href={route(page.id)} aria-current={current === page.id ? "page" : undefined}>
                      {page.label}
                    </a>
                  </li>
                ))}
              </ul>
            </Fragment>
          ))}
        </details>
      ))}
    </div>
  </nav>
  </div>
</dialog>
