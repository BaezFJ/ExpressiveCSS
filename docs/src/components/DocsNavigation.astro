---
import { NAV, type DocsPage } from "../data/nav";
import { groupOf, route, sectionsOf } from "../lib/catalogue";

/**
 * Site navigation. From Expanded up a collapsed rail holds the catalogue
 * groups; each opens a side panel of its pages on hover or click, with a
 * section as a dropdown that starts open when it holds the current page.
 * Below Large the app bar's menu button also opens the whole catalogue as a
 * modal sheet.
 */
interface Props {
  current: string;
}

const { current } = Astro.props;
const currentGroup = groupOf(current);
const id = (label: string) => `docs-group-${label.toLowerCase()}`;
const panelId = (label: string) => `docs-rail-panel-${label.toLowerCase()}`;
const link = (page: DocsPage) => ({
  href: route(page.id),
  "aria-current": current === page.id ? "page" : undefined,
});
---
<div class="docs-navigation-wide">
  <nav class="navigation-rail docs-category-rail" aria-label="Documentation categories">
    {NAV.map((group) => (
      <Fragment>
        <button
          type="button"
          popovertarget={panelId(group.label)}
          class={group === currentGroup ? "active" : undefined}
          aria-current={group === currentGroup ? "true" : undefined}
        >
          <span class="material-symbols" aria-hidden="true">{group.icon}</span>
          {group.label}
        </button>
        <div id={panelId(group.label)} class="navigation-rail-panel" popover>
          {sectionsOf(group).map((run) => run.label ? (
            <details open={run.pages.some((page) => page.id === current)}>
              <summary>{run.label}</summary>
              {run.pages.map((page) => <a {...link(page)}>{page.label}</a>)}
            </details>
          ) : run.pages.map((page) => <a {...link(page)}>{page.label}</a>))}
        </div>
      </Fragment>
    ))}
  </nav>
</div>

<dialog id="docs-navigation-dialog" class="side-sheet start docs-navigation-dialog" aria-labelledby="docs-navigation-title">
  <header>
    <h2 id="docs-navigation-title">Browse documentation</h2>
    <form method="dialog">
      <button type="submit" aria-label="Close navigation">
        <span class="material-symbols" aria-hidden="true">close</span>
      </button>
    </form>
  </header>
  <div>
  <nav aria-label="Documentation pages">
    <div class="accordion">
      {NAV.map((group) => (
        <details open={group === currentGroup} id={id(group.label)}>
          <summary>
            <span class="material-symbols" aria-hidden="true">{group.icon}</span>
            {group.label}
          </summary>
          {sectionsOf(group).map((run) => (
            <Fragment>
              {run.label && <h3 class="label-large on-surface-variant-text">{run.label}</h3>}
              <ul class="list">
                {run.pages.map((page) => (
                  <li>
                    <a href={route(page.id)} aria-current={current === page.id ? "page" : undefined}>
                      {page.label}
                    </a>
                  </li>
                ))}
              </ul>
            </Fragment>
          ))}
        </details>
      ))}
    </div>
  </nav>
  </div>
</dialog>
