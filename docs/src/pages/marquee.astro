---
import DocsLayout from "../layouts/DocsLayout.astro";
import PageBody from "../components/PageBody.astro";
import Section from "../components/Section.astro";
import Code from "../components/Code.astro";
import TokenTable from "../components/api/TokenTable.astro";
import { defineSections } from "../lib/sections";

const S = defineSections([
  { id: "anatomy", label: "Anatomy", heading: false },
  { id: "direction", label: "Direction and speed" },
  { id: "vertical", label: "Vertical" },
  { id: "pause", label: "Pause button" },
  { id: "accessibility", label: "Accessibility" },
  { id: "tokens", label: "Tokens" },
]);

const brands = [
  ["rocket_launch", "Launchpad"],
  ["bolt", "Voltage"],
  ["eco", "Greenleaf"],
  ["diamond", "Facet"],
  ["waves", "Tidewater"],
  ["landscape", "Summit"],
];
const photos = [1015, 1016, 1018, 1019];

const pauseScript = `const button = document.getElementById('marquee-pause');
const marquee = document.getElementById('paused-marquee');
button.addEventListener('click', () => {
  const paused = button.getAttribute('aria-pressed') !== 'true';
  button.setAttribute('aria-pressed', String(paused));
  marquee.classList.toggle('paused', paused);
});`;
---
<DocsLayout page="marquee">
<PageBody sections={S}>
  <Section {...S.anatomy}>
        <p class="flow-text">
          A <code>.marquee</code> scrolls a row of logos, images or text
          without end.
        </p>
        <p>
          Write the items twice, as two identical
          <code>&lt;ul class="marquee-content"&gt;</code> groups. The second
          is a copy that fills the gap as the first scrolls out, so mark it
          <code>aria-hidden="true"</code> and give each link or button in it
          <code>tabindex="-1"</code>. Each group is at least as wide as the
          strip and spreads short content out, so one copy is enough. Add
          <code>fade</code> to fade the items out at both edges. Hovering
          over the strip or focusing a link inside stops it. CSS only.
        </p>
        <div class="marquee fade" data-markdown-ignore>
          <ul class="marquee-content" aria-label="Customers">
            {brands.map(([icon, name]) => <li class="title-medium valign-wrapper" style="gap: 8px"><span class="material-symbols-outlined" aria-hidden="true">{icon}</span>{name}</li>)}
          </ul>
          <ul class="marquee-content" aria-hidden="true">
            {brands.map(([icon, name]) => <li class="title-medium valign-wrapper" style="gap: 8px"><span class="material-symbols-outlined" aria-hidden="true">{icon}</span>{name}</li>)}
          </ul>
        </div>
<Code code={`
<div class="marquee fade">
  <ul class="marquee-content" aria-label="Customers">
    <li><img src="launchpad.svg" alt="Launchpad"></li>
    <li><img src="voltage.svg" alt="Voltage"></li>
    <li><a href="/customers/greenleaf"><img src="greenleaf.svg" alt="Greenleaf"></a></li>
  </ul>
  <ul class="marquee-content" aria-hidden="true">
    <li><img src="launchpad.svg" alt="Launchpad"></li>
    <li><img src="voltage.svg" alt="Voltage"></li>
    <li><a href="/customers/greenleaf" tabindex="-1"><img src="greenleaf.svg" alt="Greenleaf"></a></li>
  </ul>
</div>
`} />
  </Section>
  <Section {...S.direction}>
        <p>
          A strip scrolls toward the start of the line: left, or right on a
          right-to-left page. Add <code>reverse</code> to scroll the other
          way. <code>--md-comp-marquee-duration</code> is the time one group
          takes to pass, so a longer group needs a longer duration to keep
          the same speed.
        </p>
        <div class="marquee reverse" style="--md-comp-marquee-duration: 40s" data-markdown-ignore>
          <ul class="marquee-content">
            <li class="headline-small">Free shipping on orders over $50</li>
            <li class="headline-small">New arrivals every Friday</li>
            <li class="headline-small">Returns within 30 days</li>
          </ul>
          <ul class="marquee-content" aria-hidden="true">
            <li class="headline-small">Free shipping on orders over $50</li>
            <li class="headline-small">New arrivals every Friday</li>
            <li class="headline-small">Returns within 30 days</li>
          </ul>
        </div>
<Code code={`
<div class="marquee reverse" style="--md-comp-marquee-duration: 40s">
  <ul class="marquee-content">
    <li>Free shipping on orders over $50</li>
    <li>New arrivals every Friday</li>
    <li>Returns within 30 days</li>
  </ul>
  <ul class="marquee-content" aria-hidden="true">
    <li>Free shipping on orders over $50</li>
    <li>New arrivals every Friday</li>
    <li>Returns within 30 days</li>
  </ul>
</div>
`} />
  </Section>
  <Section {...S.vertical}>
        <p>
          <code>vertical</code> scrolls up, or down with <code>reverse</code>.
          The strip is 320px tall; set <code>height</code> to change it.
        </p>
        <div class="marquee vertical fade" style="height: 360px; max-width: 320px" data-markdown-ignore>
          <ul class="marquee-content">
            {photos.map((id) => <li><img src={`https://picsum.photos/id/${id}/320/200`} alt="" width="320" height="200" style="display: block; border-radius: 16px" /></li>)}
          </ul>
          <ul class="marquee-content" aria-hidden="true">
            {photos.map((id) => <li><img src={`https://picsum.photos/id/${id}/320/200`} alt="" width="320" height="200" style="display: block; border-radius: 16px" /></li>)}
          </ul>
        </div>
<Code code={`
<div class="marquee vertical fade" style="height: 360px">
  <ul class="marquee-content">
    <li><img src="lake.jpg" alt=""></li>
    <li><img src="forest.jpg" alt=""></li>
  </ul>
  <ul class="marquee-content" aria-hidden="true">
    <li><img src="lake.jpg" alt=""></li>
    <li><img src="forest.jpg" alt=""></li>
  </ul>
</div>
`} />
  </Section>
  <Section {...S.pause}>
        <p>
          Add <code>paused</code> to stop the strip. When it runs next to
          other content for more than five seconds, give people a button that
          stops it, and keep the button outside the strip so it stays put.
        </p>
        <div style="display: flex; align-items: center; gap: 8px" data-markdown-ignore>
          <button type="button" class="icon-button" id="marquee-pause" aria-label="Pause scrolling" aria-pressed="false">
            <span class="material-symbols-outlined" aria-hidden="true">pause</span>
          </button>
          <div class="marquee fade" id="paused-marquee" style="flex: 1">
            <ul class="marquee-content">
              {brands.map(([icon, name]) => <li class="title-medium valign-wrapper" style="gap: 8px"><span class="material-symbols-outlined" aria-hidden="true">{icon}</span>{name}</li>)}
            </ul>
            <ul class="marquee-content" aria-hidden="true">
              {brands.map(([icon, name]) => <li class="title-medium valign-wrapper" style="gap: 8px"><span class="material-symbols-outlined" aria-hidden="true">{icon}</span>{name}</li>)}
            </ul>
          </div>
        </div>
<script is:inline set:html={`{\n${pauseScript}\n}`}></script>
<Code code={`
<button type="button" class="icon-button" id="marquee-pause"
        aria-label="Pause scrolling" aria-pressed="false">
  <span class="material-symbols-outlined" aria-hidden="true">pause</span>
</button>
<div class="marquee" id="paused-marquee">…</div>

<script>
${pauseScript.replace(/^/gm, "  ")}
</script>
`} />
  </Section>
  <Section {...S.accessibility}>
        <ul>
          <li>
            Screen readers read the first group once and skip the
            <code>aria-hidden</code> copy. Name the first list when its
            purpose is not clear from the page, as in
            <code>aria-label="Customers"</code>.
          </li>
          <li>
            Give each logo image the brand's name as its <code>alt</code>
            text. Decorative photos take <code>alt=""</code>.
          </li>
          <li>
            Hover and keyboard focus inside the strip pause it. A link in
            the copy has <code>tabindex="-1"</code>, so Tab reaches each link
            once, and clicking the copy still follows it.
          </li>
          <li>
            With reduced motion the strip stops, the copy is hidden and the
            strip scrolls by hand when its items overflow.
          </li>
          <li>
            Do not put information people need only in a marquee. Each item
            is on screen for a few seconds at a time.
          </li>
        </ul>
  </Section>
  <Section {...S.tokens}>
        <p>Set these on the <code>.marquee</code>.</p>
        <TokenTable>
          <tr>
            <td><code>--md-comp-marquee-duration</code></td>
            <td>20s; the time one group takes to pass</td>
          </tr>
          <tr>
            <td><code>--md-comp-marquee-gap</code></td>
            <td>32px; space between items and between the two groups</td>
          </tr>
          <tr>
            <td><code>--md-comp-marquee-fade-size</code></td>
            <td>48px; length of each edge fade with <code>fade</code></td>
          </tr>
        </TokenTable>
  </Section>
</PageBody>
</DocsLayout>
