---
import DocsLayout from "../layouts/DocsLayout.astro";
import Section from "../components/Section.astro";
import Code from "../components/Code.astro";
import TokenTable from "../components/api/TokenTable.astro";
import { defineSections } from "../lib/sections";

const S = defineSections([
  { id: "anatomy", label: "Anatomy", heading: false },
  { id: "standard", label: "Standard" },
  { id: "segmented", label: "Segmented" },
  { id: "text", label: "Text" },
  { id: "icons", label: "Icons" },
  { id: "media", label: "Avatars and images" },
  { id: "links", label: "Links and selection" },
  { id: "sortable", label: "Sortable" },
  { id: "long", label: "Long lists" },
  { id: "tokens", label: "Tokens" },
]);
---
<DocsLayout page="lists" sections={S}>
  <Section {...S.anatomy}>
        <p class="flow-text">
          A <code>.list</code> is a vertical index. Use it so people can find
          an item and act on it. The component is HTML only, with no
          JavaScript. Order items logically, keep each row short, and put
          icons, text, and actions in the same place on every row.
        </p>
        <p>
          The leading visual is the first icon,
          <code>&lt;img&gt;</code>, or <code>&lt;input&gt;</code>. The
          trailing action is the last icon,
          <code>&lt;kbd&gt;</code>, <code>&lt;button&gt;</code>,
          <code>&lt;time&gt;</code>, or <code>.meta</code>. A following
          <code>&lt;p&gt;</code> is supporting text. Mark the current row
          with <code>active</code> or <code>selected</code>. Do <strong>not</strong>
          use <code>aria-selected</code>, which is not valid on a plain
          <code>listitem</code>. It needs a role (<code>option</code>,
          <code>tab</code>, <code>row</code>, <code>treeitem</code>), and each of
          those brings a keyboard contract with it.
        </p>
        <p>
          There are two variants: <strong>standard</strong> (the default) and
          <code>segmented</code>.
        </p>
  </Section>
  <Section {...S.standard}>
        <p>
          Standard rows are transparent. The selected item is a pill in
          <code>secondary-container</code>. The leading icon fills when
          the row is selected.
        </p>
        <ul class="list">
          <li>
            <span class="material-symbols" aria-hidden="true">star</span>
            List item
            <kbd>⌘C</kbd>
          </li>
          <li>
            <span class="material-symbols" aria-hidden="true">star</span>
            List item
            <kbd>⌘C</kbd>
          </li>
          <li class="selected">
            <span class="material-symbols" aria-hidden="true">star</span>
            List item
            <kbd>⌘C</kbd>
          </li>
          <li>
            <span class="material-symbols" aria-hidden="true">star</span>
            List item
            <kbd>⌘C</kbd>
          </li>
          <li>
            <span class="material-symbols" aria-hidden="true">star</span>
            List item
            <kbd>⌘C</kbd>
          </li>
          <li>
            <span class="material-symbols" aria-hidden="true">star</span>
            List item
            <kbd>⌘C</kbd>
          </li>
        </ul>
<Code code={`
<ul class="list">
  <li>
    <span class="material-symbols" aria-hidden="true">star</span>
    List item
    <kbd>⌘C</kbd>
  </li>
  <li class="selected">
    <span class="material-symbols" aria-hidden="true">star</span>
    List item
    <kbd>⌘C</kbd>
  </li>
</ul>
`} />
  </Section>
  <Section {...S.segmented}>
        <p>
          Add <code>segmented</code> to make every row a rounded tile. The
          selected tile uses the same <code>secondary-container</code>
          fill. Use this when the list itself should read as a group.
        </p>
        <ul class="list segmented">
          <li>
            <span class="material-symbols" aria-hidden="true">star</span>
            List item
            <kbd>⌘C</kbd>
          </li>
          <li>
            <span class="material-symbols" aria-hidden="true">star</span>
            List item
            <kbd>⌘C</kbd>
          </li>
          <li class="selected">
            <span class="material-symbols" aria-hidden="true">star</span>
            List item
            <kbd>⌘C</kbd>
          </li>
          <li>
            <span class="material-symbols" aria-hidden="true">star</span>
            List item
            <kbd>⌘C</kbd>
          </li>
          <li>
            <span class="material-symbols" aria-hidden="true">star</span>
            List item
            <kbd>⌘C</kbd>
          </li>
          <li>
            <span class="material-symbols" aria-hidden="true">star</span>
            List item
            <kbd>⌘C</kbd>
          </li>
        </ul>
<Code code={`
<ul class="list segmented">
  <li class="selected">
    <span class="material-symbols" aria-hidden="true">star</span>
    List item
    <kbd>⌘C</kbd>
  </li>
</ul>
`} />
  </Section>
  <Section {...S.text}>
        <p>
          A row can be a single line of label text, or a label with
          supporting text underneath. Either can wrap. To cut it off with an
          ellipsis instead, add <code>truncate</code>.
        </p>
        <ul class="list">
          <li>Label text only</li>
          <li><span class="truncate">A long label that will not wrap past the end of the row and is cut off</span></li>
          <li>
            Headline
            <p>Supporting text sits under the label and can wrap onto another line.</p>
          </li>
        </ul>
<Code code={`
<li>Label text only</li>
<li><span class="truncate">A long label…</span></li>
<li>
  Headline
  <p>Supporting text sits under the label.</p>
</li>
`} />
  </Section>
  <Section {...S.icons}>
        <p>
          A leading icon is a quick visual cue for the label. A trailing
          icon shows status or an action, such as more, info, or a chevron.
        </p>
        <ul class="list">
          <li>
            <span class="material-symbols" aria-hidden="true">inbox</span>
            Inbox
            <span class="material-symbols" aria-hidden="true">chevron_right</span>
          </li>
          <li>
            <span class="material-symbols" aria-hidden="true">send</span>
            Sent
            <span class="material-symbols" aria-hidden="true">info</span>
          </li>
          <li>
            <span class="material-symbols" aria-hidden="true">delete</span>
            Trash
            <button type="button" aria-label="More">
              <span class="material-symbols" aria-hidden="true">more_vert</span>
            </button>
          </li>
        </ul>
<Code code={`
<li>
  <span class="material-symbols" aria-hidden="true">inbox</span>
  Inbox
  <span class="material-symbols" aria-hidden="true">chevron_right</span>
</li>
`} />
  </Section>
  <Section {...S.media}>
        <p>
          A leading <code>.circle</code> is a 40dp avatar. A bare
          <code>&lt;img&gt;</code> is a 56dp thumbnail.
        </p>
        <ul class="list">
          <li>
            <img src="https://picsum.photos/id/64/80/80" alt="" class="circle">
            Ada Lovelace
            <p>Mathematician</p>
          </li>
          <li>
            <span class="material-symbols circle" aria-hidden="true">person</span>
            Icon avatar
          </li>
          <li>
            <img src="https://picsum.photos/id/1015/112/112" alt="">
            Thumbnail
            <p>56dp image, 8dp corners.</p>
          </li>
        </ul>
<Code code={`
<li>
  <img src="portrait.jpg" alt="" class="circle">
  Ada Lovelace
  <p>Mathematician</p>
</li>
`} />
  </Section>
  <Section {...S.links}>
        <p>
          Wrap the row in an <code>&lt;a&gt;</code> or
          <code>&lt;label&gt;</code> to make the whole item the target.
          <code>aria-current</code> on the link, or a checked radio
          inside the label, paints the selected pill.
        </p>
        <p>
          In a list where each row is a single link or button, the script adds arrow-key shortcuts. Up and Down move focus to the row before or after. Home and End move it to the first and last row. The keys skip disabled rows and stop at the ends. Every row stays a Tab stop, so the keys are only a shortcut. Rows with more than one control keep their native keys. So do radio rows, which the browser already moves with the arrows.
        </p>
        <ul class="list">
          <li>
            <a href="#!">
              <span class="material-symbols" aria-hidden="true">mail</span>
              Inbox
            </a>
          </li>
          <li>
            <a href="#!" aria-current="page">
              <span class="material-symbols" aria-hidden="true">star</span>
              Starred
            </a>
          </li>
          <li>
            <a href="#!">
              <span class="material-symbols" aria-hidden="true">snooze</span>
              Snoozed
            </a>
          </li>
        </ul>
<Code code={`
<li>
  <a href="/inbox" aria-current="page">
    <span class="material-symbols" aria-hidden="true">inbox</span>
    Inbox
  </a>
</li>
`} />
        <fieldset>
          <legend>Colour</legend>
          <ul class="list">
            <li>
              <label>
                <input type="radio" name="list-pick" checked>
                Red
              </label>
            </li>
            <li>
              <label>
                <input type="radio" name="list-pick">
                Green
              </label>
            </li>
            <li>
              <label>
                <input type="radio" name="list-pick">
                Blue
              </label>
            </li>
          </ul>
        </fieldset>
<Code code={`
<fieldset>
  <legend>Colour</legend>
  <ul class="list">
    <li>
      <label>
        <input type="radio" name="color">
        Red
      </label>
    </li>
  </ul>
</fieldset>
`} />
  </Section>
  <Section {...S.sortable}>
        <p>
          Add <code>sortable</code> to a list to let people reorder it. Drag
          an item by its <code>.drag-handle</code>, or press its
          <code>[data-move="up"]</code> and <code>[data-move="down"]</code>
          buttons. Every item needs both buttons, in the row or in a menu.
          They are the keyboard path and the single-pointer alternative to
          dragging. Escape during a drag puts the item back.
        </p>
        <p>
          Listen for <code>change</code> to save the order. After each move,
          the list fires a bubbling <code>change</code> event whose
          <code>detail</code> is <code>{"{ item, from, to }"}</code>. A polite
          live region announces the new position
          (<code>Expressive.Sortable.i18n.moved</code>). The root bundle
          starts the behavior on load. With the modular entry, call
          <code>Sortable.Init()</code>.
        </p>
        <ul class="list sortable mb-3" aria-label="Playlist">
          <li><span class="drag-handle" aria-hidden="true"></span><span>Blue in Green</span><span class="sortable-actions"><button type="button" class="icon-button" data-move="up" aria-label="Move Blue in Green up"><span class="material-symbols" aria-hidden="true">arrow_upward</span></button><button type="button" class="icon-button" data-move="down" aria-label="Move Blue in Green down"><span class="material-symbols" aria-hidden="true">arrow_downward</span></button></span></li><li><span class="drag-handle" aria-hidden="true"></span><span>So What</span><span class="sortable-actions"><button type="button" class="icon-button" data-move="up" aria-label="Move So What up"><span class="material-symbols" aria-hidden="true">arrow_upward</span></button><button type="button" class="icon-button" data-move="down" aria-label="Move So What down"><span class="material-symbols" aria-hidden="true">arrow_downward</span></button></span></li><li><span class="drag-handle" aria-hidden="true"></span><span>Freddie Freeloader</span><span class="sortable-actions"><button type="button" class="icon-button" data-move="up" aria-label="Move Freddie Freeloader up"><span class="material-symbols" aria-hidden="true">arrow_upward</span></button><button type="button" class="icon-button" data-move="down" aria-label="Move Freddie Freeloader down"><span class="material-symbols" aria-hidden="true">arrow_downward</span></button></span></li>
        </ul>
<Code code={`
<ul class="list sortable" aria-label="Playlist">
  <li>
    <span class="drag-handle" aria-hidden="true"></span>
    <span>Blue in Green</span>
    <span class="sortable-actions">
      <button type="button" class="icon-button" data-move="up" aria-label="Move Blue in Green up">
        <span class="material-symbols" aria-hidden="true">arrow_upward</span>
      </button>
      <button type="button" class="icon-button" data-move="down" aria-label="Move Blue in Green down">
        <span class="material-symbols" aria-hidden="true">arrow_downward</span>
      </button>
    </span>
  </li>
  …
</ul>
`} />
  </Section>
  <Section {...S.long}>
        <p>
          Add <code>defer-render</code> to a long list so the browser skips
          layout and paint for rows that are off screen. Each direct child
          gets <code>content-visibility: auto</code>. It works on any
          container whose children stack, such as a column of cards.
        </p>
        <p>
          Off-screen rows stay in the page. Screen readers and find-in-page
          still reach their text, and a script can still query them. A
          skipped row reserves <code>--defer-render-row-size</code>, which
          defaults to the list item height inside a <code>.list</code> and
          to 3.5rem elsewhere. Once a row has been on screen, the browser
          remembers its real height. Set the property to the average row
          height when rows differ, so the scrollbar stays close to the
          list's real length.
        </p>
        <div class="scroll-area mb-3" style="max-block-size: 20rem" tabindex="0" role="region" aria-label="Invoices, 300 rows">
          <ul class="list defer-render" aria-label="Invoices">
            {Array.from({ length: 300 }, (_, i) => <li>Invoice {i + 1}</li>)}
          </ul>
        </div>
<Code code={`
<ul class="list defer-render" aria-label="Invoices" style="--defer-render-row-size: 4.5rem">
  <li>…</li>
  …
</ul>
`} />
        <p>
          The browser clips anything a deferred row draws outside its box.
          Focus rings inside a row are drawn inset for that reason, but a
          box shadow or a badge that hangs over the edge is cut off. Each
          row is also the containing block for absolutely and fixed
          positioned content. Menus and tooltips open in the top layer and
          are not affected. Rows with <code>.swipe-actions</code> are never
          deferred, because their actions wait past the row's end.
        </p>
        <p>
          Tables are not supported. Browsers ignore
          <code>content-visibility</code> on table rows. When the rows are
          not in the page at all, such as a dataset too large to render as
          markup or one fetched a page at a time during scrolling, use a
          virtual list script instead. ExpressiveCSS does not ship one.
        </p>
  </Section>
  <Section {...S.tokens}>
        <p>Set these on the list (or on <code>:root</code>):</p>
        <TokenTable>
            <tr><td><code>--md-comp-list-item-height</code></td><td>56px</td></tr>
            <tr><td><code>--md-comp-list-item-two-line-height</code></td><td>72px</td></tr>
            <tr><td><code>--md-comp-list-item-padding</code></td><td>16px</td></tr>
            <tr><td><code>--md-comp-list-item-shape</code></td><td>100px (20px segmented)</td></tr>
            <tr><td><code>--md-comp-list-item-container-color</code></td><td>transparent</td></tr>
            <tr><td><code>--md-comp-list-selected-container-color</code></td><td><code>--md-sys-color-secondary-container</code></td></tr>
            <tr><td><code>--md-comp-list-leading-icon-size</code></td><td>24px</td></tr>
            <tr><td><code>--md-comp-list-segmented-gap</code></td><td>2px</td></tr>
  </TokenTable>
  </Section>
</DocsLayout>
