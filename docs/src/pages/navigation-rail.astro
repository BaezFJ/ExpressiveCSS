---
import DocsLayout from "../layouts/DocsLayout.astro";
import PageBody from "../components/PageBody.astro";
import Section from "../components/Section.astro";
import Code from "../components/Code.astro";
import TokenTable from "../components/api/TokenTable.astro";
import { defineSections } from "../lib/sections";
import { route } from "../lib/catalogue";

const S = defineSections([
  { id: "anatomy", label: "Anatomy", heading: false },
  { id: "collapsed", label: "Collapsed" },
  { id: "expanded", label: "Expanded" },
  { id: "modal", label: "Modal" },
  { id: "side-panel", label: "Side panel" },
  { id: "tokens", label: "Tokens" },
]);
---
<DocsLayout page="navigation_rail">
<PageBody sections={S}>
  <Section {...S.anatomy}>
        <p class="flow-text">
          A <code>nav.navigation-rail</code> holds 3 to 7 destinations plus an
          optional FAB. Put it in the same place on every screen. Use it
          in medium, expanded, large, or extra-large windows.
        </p>
        <p>
          Collapsed is 96dp with the icon above the label. Add
          <code>expanded</code> for a 220 to 360dp rail with icon and label
          on one row and an extended FAB. The menu button toggles that class
          (<code>AutoInit()</code> starts it). On compact windows an
          expanded rail is modal. It shows a scrim, and Escape or a tap on
          the scrim collapses it. Add <code>modal</code> to keep that overlay at
          every breakpoint.
        </p>
        <p>
          Escape closes an open nested menu first. A second Escape collapses
          the modal rail and returns focus from inside it to the rail toggle,
          unless a close callback moves focus elsewhere.
        </p>
        <p>
          Compact windows that need persistent destinations still use a
          <a href={route('navigation_bar')}>navigation bar</a>.
          Split larger hierarchies into peer categories and a separate
          page-level list.
        </p>
  </Section>
  <Section {...S.collapsed}>
        <p>
          This is the default. It is 96dp wide, with the icon above the
          label and the selected pill behind the icon. The FAB is icon-only. Offset the rest of the
          page by <code>--md-comp-nav-rail-collapsed-width</code>.
        </p>
        <div class="rail-demo mb-3">
          <nav class="navigation-rail" aria-label="Main — Collapsed">
            <button type="button" aria-label="Menu">
              <span class="material-symbols" aria-hidden="true">menu</span>
            </button>
            <a class="button" href="#!">
              <span class="material-symbols" aria-hidden="true">edit</span>
              <span>Label</span>
            </a>
            <a href="#!" aria-current="page">
              <span class="material-symbols" aria-hidden="true">star</span>
              Label
            </a>
            <a href="#!" aria-label="Starred, 3 unread">
              <span class="material-symbols" aria-hidden="true">star<span class="badge">3</span></span>
              Label
            </a>
            <a href="#!" aria-label="Starred, unread">
              <span class="material-symbols" aria-hidden="true">star<span class="badge"></span></span>
              Label
            </a>
            <a href="#!">
              <span class="material-symbols" aria-hidden="true">star</span>
              Label
            </a>
          </nav>
        </div>
<Code code={`
<nav class="navigation-rail" aria-label="Main">
  <button type="button" aria-label="Menu">
    <span class="material-symbols" aria-hidden="true">menu</span>
  </button>
  <a class="button" href="/compose">
    <span class="material-symbols" aria-hidden="true">edit</span>
    <span>Label</span>
  </a>
  <a href="/" aria-current="page">
    <span class="material-symbols" aria-hidden="true">star</span>
    Label
  </a>
  <a href="/two" aria-label="Starred, 3 unread">
    <span class="material-symbols" aria-hidden="true">star<span class="badge">3</span></span>
    Label
  </a>
</nav>
`} />
  </Section>
  <Section {...S.expanded}>
        <p>
          Add <code>expanded</code>. Destinations become a row: icon,
          then label, with the selected pill around both. The FAB grows
          into an extended button. Section headings show only in this
          layout.
        </p>
        <p>
          Expanding and collapsing run on the default spatial spring:
          <code>--md-comp-nav-rail-motion</code> and
          <code>--md-comp-nav-rail-motion-duration</code> read
          <code>--md-sys-motion-spring-default-spatial</code> and its duration, so
          <code>motion="expressive"</code> lets the rail overshoot its width slightly
          before it settles. The rail grows from its docked edge, so nothing behind
          it is uncovered.
        </p>
        <div class="rail-demo mb-3">
          <nav class="navigation-rail expanded" aria-label="Main — Expanded">
            <button type="button" aria-label="Menu">
              <span class="material-symbols" aria-hidden="true">menu</span>
            </button>
            <a class="button" href="#!">
              <span class="material-symbols" aria-hidden="true">edit</span>
              <span>Label</span>
            </a>
            <a href="#!" aria-current="page">
              <span class="material-symbols" aria-hidden="true">star</span>
              Label
            </a>
            <a href="#!" aria-label="Starred, 3 unread">
              <span class="material-symbols" aria-hidden="true">star<span class="badge">3</span></span>
              Label
            </a>
            <h3>Section Header</h3>
            <a href="#!">
              <span class="material-symbols" aria-hidden="true">star</span>
              Label
            </a>
            <a href="#!">
              <span class="material-symbols" aria-hidden="true">star</span>
              Label
            </a>
          </nav>
        </div>
<Code code={`
<nav class="navigation-rail expanded" aria-label="Main">
  …
  <h3>Section Header</h3>
  <a href="/other">
    <span class="material-symbols" aria-hidden="true">star</span>
    Label
  </a>
</nav>
`} />
<Code code={`
@media (width >= 600px) {
  body {
    padding-left: var(--md-comp-nav-rail-collapsed-width);
  }
  body:has(.navigation-rail.expanded) {
    padding-left: var(--md-comp-nav-rail-expanded-width);
  }
}
`} />
  </Section>
  <Section {...S.modal}>
        <p>
          On compact windows, <code>expanded</code> already
          overlays the page with a scrim. Add <code>modal</code> if you
          want that overlay on tablets and desktops too. Image 2 in the
          spec shows this case, a compact window expanding in place.
        </p>
<Code code={`
<nav class="navigation-rail expanded modal" aria-label="Main">…</nav>
`} />
  </Section>
  <Section {...S["side-panel"]}>
        <p>
          A destination can open a panel of more links beside the rail. Make
          the destination a <code>&lt;button&gt;</code> with
          <code>popovertarget</code> and put its
          <code>.navigation-rail-panel</code> popover right after it. The
          panel docks against the rail's edge at full window height. A click
          toggles it, and the browser handles light dismiss, Escape and the
          button's expanded state. With a mouse, hovering the destination
          opens the panel, which closes again once the pointer leaves both;
          clicking a hovered destination keeps its panel open.
        </p>
        <p>
          Group links under a <code>&lt;details&gt;</code>. Its
          <code>&lt;summary&gt;</code> is the dropdown row, and the links after
          it are indented. Mark the current page with
          <code>aria-current="page"</code>.
        </p>
        <div class="rail-demo mb-3">
          <nav class="navigation-rail" aria-label="Main — Side panel">
            <button type="button" aria-label="Menu">
              <span class="material-symbols" aria-hidden="true">menu</span>
            </button>
            <a href="#!">
              <span class="material-symbols" aria-hidden="true">home</span>
              Home
            </a>
            <button type="button" popovertarget="rail-components-panel" aria-current="page">
              <span class="material-symbols" aria-hidden="true">widgets</span>
              Components
            </button>
            <div id="rail-components-panel" class="navigation-rail-panel" popover>
              <a href="#!" aria-current="page">Components overview</a>
              <a href="#!">App bars</a>
              <a href="#!">Badges</a>
              <details>
                <summary>Date &amp; time pickers</summary>
                <a href="#!">Date pickers</a>
                <a href="#!">Time pickers</a>
              </details>
              <a href="#!">Dialogs</a>
            </div>
            <a href="#!">
              <span class="material-symbols" aria-hidden="true">palette</span>
              Styles
            </a>
          </nav>
        </div>
<Code code={`
<nav class="navigation-rail" aria-label="Main">
  …
  <button type="button" popovertarget="components-panel">
    <span class="material-symbols" aria-hidden="true">widgets</span>
    Components
  </button>
  <div id="components-panel" class="navigation-rail-panel" popover>
    <a href="/components" aria-current="page">Components overview</a>
    <a href="/app-bars">App bars</a>
    <details>
      <summary>Date &amp; time pickers</summary>
      <a href="/date-pickers">Date pickers</a>
      <a href="/time-pickers">Time pickers</a>
    </details>
  </div>
</nav>
`} />
  </Section>
  <Section {...S.tokens}>
        <TokenTable>
            <tr><td><code>--md-comp-nav-rail-collapsed-width</code></td><td>96px</td></tr>
            <tr><td><code>--md-comp-nav-rail-expanded-width</code></td><td>280px (clamped between 220 and 360)</td></tr>
            <tr><td><code>--md-comp-nav-rail-icon-size</code></td><td>24px</td></tr>
            <tr><td><code>--md-comp-nav-rail-indicator-width</code></td><td>56px</td></tr>
            <tr><td><code>--md-comp-nav-rail-fab-size</code></td><td>56px</td></tr>
            <tr><td><code>--md-comp-nav-rail-panel-width</code></td><td>256px</td></tr>
        </TokenTable>
  </Section>
</PageBody>
</DocsLayout>
