---
import DocsLayout from "../layouts/DocsLayout.astro";
import PageBody from "../components/PageBody.astro";
import Section from "../components/Section.astro";
import Code from "../components/Code.astro";
import TokenTable from "../components/api/TokenTable.astro";
import { defineSections } from "../lib/sections";
import { route } from "../lib/catalogue";

const S = defineSections([
  { id: "anatomy", label: "Anatomy", heading: false },
  { id: "behavior", label: "Behavior" },
  { id: "tokens", label: "Tokens" },
]);
---
<DocsLayout page="tour">
<PageBody sections={S}>
  <Section {...S.anatomy}>
        <p class="flow-text">
          A <code>.tour</code> walks people through an interface one step at
          a time, beside each element it explains.
        </p>
        <p>
          To build a tour:
        </p>
        <ol>
          <li>
            Make the card a <code>popover="manual"</code> dialog with one
            <code>&lt;section&gt;</code> per step.
          </li>
          <li>
            Set each section's <code>data-tour-target</code> to the id of the
            element it is about.
          </li>
          <li>
            Add a <code>.tour-progress</code> line, a
            <code>.tour-actions</code> row with Back, Next and Done buttons,
            and a close button.
          </li>
          <li>
            Add a button whose <code>data-tour-start</code> names the tour to
            start.
          </li>
        </ol>
        <p>
          For one hint beside one control, use a
          <a href={route("popover")}>popover</a>.
        </p>
<Code code={`
<button type="button" data-tour-start="welcome">Take the tour</button>

<div id="welcome" class="tour" popover="manual" role="dialog">
  <section data-tour-target="search-button">
    <h2>Search everything</h2>
    <p>Find files, people and settings from here.</p>
  </section>
  <section data-tour-target="new-button">
    <h2>Create</h2>
    <p>Start a document, sheet or folder.</p>
  </section>
  <p class="tour-progress"></p>
  <div class="tour-actions">
    <button type="button" class="button text" data-tour-back>Back</button>
    <button type="button" class="button filled" data-tour-next>Next</button>
    <button type="button" class="button filled" data-tour-done>Done</button>
  </div>
  <button type="button" class="icon-button" data-tour-close aria-label="Close tour">
    <span class="material-symbols" aria-hidden="true">close</span>
  </button>
</div>
`} />
  </Section>
  <Section {...S.behavior}>
        <p>
          The <code>Tour</code> behavior shows one step at a time below its
          target. It flips the card above the target when there is no room
          below, rings the target and scrolls it into view. It skips steps
          whose target is missing or hidden. Back hides on the first step and
          Next on the last. Done shows only on the last step.
        </p>
        <p>
          The step's heading names the card, and the card takes focus.
          Escape, Done or the close button ends the tour and returns focus to
          where it was. The card's <code>toggle</code> event tells the page,
          so it can, for example, remember that the user saw the tour.
        </p>
        <p>
          From script, call <code>Expressive.Tour.start(el, index)</code>,
          <code>go(el, index)</code> and <code>end(el, completed)</code>.
          The tour fires <code>expressive:open</code>, and
          <code>expressive:change</code> with <code>{"{ step, index }"}</code>.
          It also fires <code>expressive:close</code> with
          <code>{"{ completed }"}</code>, which is true when Done ended the
          tour. <code>Expressive.Tour.i18n.progress</code> holds the
          <code>{"Step {current} of {total}"}</code> text. The root bundle
          starts the behavior on load. With the modular entry, call
          <code>Tour.Init()</code>.
        </p>
  </Section>
  <Section {...S.tokens}>
        <TokenTable>
          <tr>
            <td><code>--md-comp-tour-container-color</code></td>
            <td><code>--md-sys-color-surface-container-high</code></td>
          </tr>
          <tr>
            <td><code>--md-comp-tour-shape</code></td>
            <td>16px</td>
          </tr>
          <tr>
            <td><code>--md-comp-tour-max-width</code></td>
            <td>360px</td>
          </tr>
          <tr>
            <td><code>--md-comp-tour-gap</code></td>
            <td>12px (from the target)</td>
          </tr>
        </TokenTable>
  </Section>
</PageBody>
</DocsLayout>
