---
import DocsLayout from "../layouts/DocsLayout.astro";
import Section from "../components/Section.astro";
import Code from "../components/Code.astro";
import { defineSections } from "../lib/sections";
import { route } from "../lib/catalogue";
import OptionsTable from "../components/api/OptionsTable.astro";
import PropertiesTable from "../components/api/PropertiesTable.astro";
import InstanceNote from "../components/api/InstanceNote.astro";

const S = defineSections([
  { id: "introduction", label: "Introduction", heading: false },
  { id: "initialization", label: "Initialization" },
  { id: "search", label: "Search" },
  { id: "options", label: "Options" },
  { id: "methods", label: "Methods" },
  { id: "native-forms", label: "Native forms" },
  { id: "properties", label: "Properties" },
  { id: "disabled", label: "Disabled styles" },
]);
---
<DocsLayout page="select" sections={S}>
  <Section {...S.introduction}>
        <p class="flow-text">
          Wrap a native <code>&lt;select&gt;</code> in <code>.field</code> and
          give the label a matching <code>for</code>. Select turns it into an
          exposed menu, a text field paired with a menu. Add
          <code>outlined</code> (or <code>border</code>) on that field for the
          outlined variant.
          <code>AutoInit()</code> starts every <code>select</code> except those marked
          <code>no-autoinit</code>. Add <code>browser-default</code> to keep the native control.
        </p>

        <p>Filled enhanced selects reserve space for their label, including translated labels that wrap or grow with text size. The outlined and native variants keep their existing layout.</p>

        <div class="field mb-5">
          <select id="form-select-1">
            <option value="" disabled selected>Choose your option</option>
            <option value="1">Option 1</option>
            <option value="2">Option 2</option>
            <option value="3">Option 3</option>
          </select>
          <label for="form-select-1">Expressive Select</label>
        </div>

        <p>Add <code>multiple</code> to select several options. Chosen values appear as a comma-separated list. Distinct options with the same value can be selected and deselected independently.</p>
        <div class="field mb-5">
          <select id="form-select-2" multiple>
            <option value="" disabled selected>Choose your option</option>
            <option value="1">Option 1</option>
            <option value="2">Option 2</option>
            <option value="3">Option 3</option>
          </select>
          <label for="form-select-2">Multiple Select</label>
        </div>

        <p>Native <code>&lt;optgroup&gt;</code> elements become group headings in the menu.</p>
        <div class="field mb-5">
          <select id="form-select-3">
            <optgroup label="team 1">
              <option value="1">Option 1</option>
              <option value="2">Option 2</option>
            </optgroup>
            <optgroup label="team 2">
              <option value="3">Option 3</option>
              <option value="4">Option 4</option>
            </optgroup>
          </select>
          <label for="form-select-3">Optgroups</label>
        </div>

        <p>
          Put an image URL in <code>data-icon</code> on an option. The component
          copies that option's classes to the image. Images float right by
          default, and <code>left</code> floats one left. The
          <code>&lt;select&gt;</code> needs no <code>icons</code> class.
          Supported URLs are relative, HTTP(S), blob, and image data URLs (AVIF,
          BMP, GIF, JPEG, PNG, SVG, WebP, or ICO). The component ignores invalid
          URLs and other schemes, and the option stays selectable.
        </p>
        <form class="row">
          <div class="s12 m6 field">
            <select id="form-select-4">
              <option value="" disabled selected>Choose your option</option>
              <option value="1" data-icon="https://picsum.photos/id/1015/100/100">example 1</option>
              <option value="2" data-icon="https://picsum.photos/id/1016/100/100">example 2</option>
              <option value="3" data-icon="https://picsum.photos/id/64/100/100">example 3</option>
            </select>
            <label for="form-select-4">Images in select</label>
          </div>
          <div class="s12 m6 field">
            <select id="form-select-5">
              <option value="" disabled selected>Choose your option</option>
              <option value="1" data-icon="https://picsum.photos/id/1015/100/100" class="left">example 1</option>
              <option value="2" data-icon="https://picsum.photos/id/1016/100/100" class="left">example 2</option>
              <option value="3" data-icon="https://picsum.photos/id/64/100/100" class="left">example 3</option>
            </select>
            <label for="form-select-5">Images in select</label>
          </div>
        </form>

        <p>Add <code>browser-default</code> to skip the menu and keep the native select.</p>
        <p class="mb-5">
          <label for="form-select-6">Browser Select</label>
          <select id="form-select-6" class="browser-default">
            <option value="" disabled selected>Choose your option</option>
            <option value="1">Option 1</option>
            <option value="2">Option 2</option>
            <option value="3">Option 3</option>
          </select>
        </p>
<Code code={`
<div class="field">
  <select id="form-select-1">
    <option value="" disabled selected>Choose your option</option>
    <option value="1">Option 1</option>
    <option value="2">Option 2</option>
    <option value="3">Option 3</option>
  </select>
  <label for="form-select-1">Expressive Select</label>
</div>

<div class="field">
  <select id="form-select-2" multiple>
    <option value="" disabled selected>Choose your option</option>
    <option value="1">Option 1</option>
    <option value="2">Option 2</option>
    <option value="3">Option 3</option>
  </select>
  <label for="form-select-2">Multiple Select</label>
</div>

<div class="field">
  <select id="form-select-3">
    <optgroup label="team 1">
      <option value="1">Option 1</option>
      <option value="2">Option 2</option>
    </optgroup>
    <optgroup label="team 2">
      <option value="3">Option 3</option>
      <option value="4">Option 4</option>
    </optgroup>
  </select>
  <label for="form-select-3">Optgroups</label>
</div>

<div class="field">
  <select id="form-select-4">
    <option value="" disabled selected>Choose your option</option>
    <option value="1" data-icon="photo.jpg">example 1</option>
    <option value="2" data-icon="photo.jpg" class="left">example 2</option>
  </select>
  <label for="form-select-4">Images in select</label>
</div>

<label for="form-select-6">Browser Select</label>
<select id="form-select-6" class="browser-default">
  <option value="" disabled selected>Choose your option</option>
  <option value="1">Option 1</option>
</select>
`} />
  </Section>
  <Section {...S.initialization}>
        <p>
          The IIFE bundle exposes <code>Expressive.FormSelect</code>.
          Call <code>init</code> yourself when you need options other than the defaults,
          after adding a select dynamically, or after changing an existing select's options.
          Otherwise <code>Expressive.AutoInit()</code> starts every <code>select</code>.
        </p>
<Code code={`
document.addEventListener('DOMContentLoaded', function() {
  const elems = document.querySelectorAll('select');
  const instances = Expressive.FormSelect.init(elems, {
    // specify options here
  });
});
`} />
        <p>You can also pass per-instance options through AutoInit:</p>
<Code code={`
Expressive.AutoInit(document.body, {
  FormSelect: { menuOptions: { constrainWidth: false } }
});
`} />
  </Section>
  <Section {...S.search}>
    <p>Set <code>searchable: true</code> for a single select, or use the existing
      <code>data-form-select-options</code> attribute. A separate search field in
      the popup filters option text. The read-only trigger keeps showing the chosen
      value, and the native select still supplies the form value.</p>
    <form>
      <div class="field mb-3">
        <select id="search-destination" name="destination" data-form-select-options='{"searchable":true}'>
          <option value="" disabled selected>Choose a destination</option>
          <optgroup label="Europe">
            <option value="paris">Paris</option>
            <option value="rome">Rome</option>
            <option value="oslo" disabled>Oslo, unavailable</option>
          </optgroup>
          <optgroup label="Asia">
            <option value="tokyo">Tokyo</option>
            <option value="seoul">Seoul</option>
          </optgroup>
        </select>
        <label for="search-destination">Destination</label>
      </div>
      <button type="reset">Reset destination</button>
    </form>
    <Code code={`<select name="destination" aria-label="Destination"
  data-form-select-options='{"searchable":true}'>
  <optgroup label="Europe">
    <option value="paris">Paris</option>
    <option value="rome">Rome</option>
  </optgroup>
</select>

// Or initialize from script:
Expressive.FormSelect.init(select, { searchable: true });`} />
    <p>Matching uses a case-insensitive literal substring of option text, with
      leading and trailing query whitespace trimmed. Values, group names and
      accents are not substituted. Empty groups disappear. Matching disabled
      choices stay visible and unavailable. Typing never changes selection;
      the localized "No results" status appears only when no option matches.</p>
    <p>The searchable trigger controls a named nonmodal dialog containing the search
      field and a separate named listbox. Search and status are outside the listbox.
      Search text has no form name. Closing clears the query; a successful reset
      closes and restores the native defaults. Refresh retains an open query,
      search focus and caret, or a surviving enabled result's focus.</p>
    <table class="striped">
      <thead><tr><th>Key or action</th><th>Result</th></tr></thead>
      <tbody>
        <tr><td>Open by pointer, Enter, Space or vertical arrow</td><td>Focus search, unless <code>menuOptions.autoFocus</code> is false.</td></tr>
        <tr><td>Type, paste, Home, End, horizontal arrows, composition</td><td>Edit search normally. Enter in search neither chooses nor submits.</td></tr>
        <tr><td>ArrowDown / ArrowUp from search</td><td>Focus the first / last enabled visible result. Stay in search if none exists.</td></tr>
        <tr><td>Arrows, Home / End on a result</td><td>Move among enabled visible results without wrapping. Up from the first returns to search.</td></tr>
        <tr><td>Enter / Space on a result</td><td>Choose it, close and return focus to the trigger.</td></tr>
        <tr><td>Tab / Shift+Tab</td><td>Tab from search enters the first enabled result; Tab from a result exits to the next control. Without enabled results, Tab exits from search. Shift+Tab from a result returns to search; from search it closes and focuses the trigger.</td></tr>
        <tr><td>Escape / outside click</td><td>Close without changing selection. Escape focuses the trigger; an outside click keeps focus on its target.</td></tr>
      </tbody>
    </table>
    <p>Search is off by default and ignored for multiple, tree and browser-default
      selects. Remote search, creating options, fuzzy matching and virtualization
      are outside this mode. With <code>autoFocus: false</code>, opening keeps
      existing focus and Tab from the trigger can still reach search.</p>
  </Section>
  <Section {...S.options}>
        <OptionsTable>
            <tr><td><code>searchable</code></td><td>Boolean</td><td><code>false</code></td><td>Add a popup search field to an enhanced plain single select.</td></tr>
            <tr><td><code>i18n</code></td><td>Object</td><td><code>searchLabel: "Search options", noResults: "No results"</code></td><td>Override either search label or empty-result message. Omitted strings retain their defaults.</td></tr>
            <tr>
              <td><code>classes</code></td>
              <td>String</td>
              <td><code>''</code></td>
              <td>Space-separated classes added to the <code>.field</code> wrapper, either the parent <code>.field</code> or one the plugin creates.</td>
            </tr>
            <tr>
              <td><code>menuOptions</code></td>
              <td>Object</td>
              <td><code>&#123;&#125;</code></td>
              <td>
                Options passed to <code>Menu</code>. See
                <a href={`${route('menu')}#options`}>Menu</a>.
                The component forces <code>coverTrigger</code> and
                <code>closeOnClick</code> to <code>false</code>.
              </td>
            </tr>
        </OptionsTable>
        <p>There is no <code>selected</code> option. Mark options with the HTML <code>selected</code> attribute instead.</p>
  </Section>
  <Section {...S.methods}>
        <InstanceNote plugin="FormSelect" />

        <h5 class="light">.getSelectedValues();</h5>
        <p>Returns the selected values as an array of strings.</p>
<Code code={`
instance.getSelectedValues();
`} />

        <h5 class="light">.refresh();</h5>
        <p>
          Re-read the native <code>&lt;select&gt;</code>. Call this after changing
          <code>select.value</code>, option labels, options or disabled states.
          It rebuilds the menu rows and leaves the field and any existing Menu
          instance in place. Refreshing an open menu keeps focus on a surviving option.
          These programmatic updates do not emit a user <code>change</code> event.
        </p>
<Code code={`
instance.refresh();
`} />

        <h5 class="light">.destroy();</h5>
        <p>Destroy the plugin instance, remove the menu, and restore the native select. Associated labels keep their original nodes and event listeners. Teardown restores their attributes and authored positions.</p>
<Code code={`
instance.destroy();
`} />
  </Section>
  <Section {...S["native-forms"]}>
        <p>The native select handles selection and form submission. The generated menu
          does not let users choose disabled options or options in disabled optgroups.
          A selected disabled option stays visible in the field, but native form
          submission excludes it. An empty selection displays an empty field.</p>
        <p>The enhanced field exposes one combobox to assistive technology. All associated
          labels contribute to its name in their original order, unless an authored
          <code>aria-label</code> or <code>aria-labelledby</code> supplies the name. Each label
          targets the visible control. While initialized, the native select stays
          visually hidden and out of the accessibility tree.</p>
        <p>Required and custom validation errors use the native select's
          browser-provided message. The component shows it as supporting text
          associated with the visible field. Native validation chooses which field
          receives focus, and the enhanced select forwards that focus to its visible
          field. <code>checkValidity()</code> preserves focus. <code>reportValidity()</code>
          on a select reports that control even when an earlier field is invalid.</p>
        <p>After changing <code>setCustomValidity()</code> from script, call
          <code>refresh()</code> to update an existing error. Correcting the value clears
          resolved errors. Resetting the form clears displayed errors without changing
          native validation rules. <code>destroy()</code> removes generated error messages
          and restores the native control.</p>
        <p>Use the form's Reset button or <code>form.reset()</code> to restore defaults.
          The generated field synchronizes after the browser resets the native control,
          without a <code>change</code> event. Canceling the reset preserves selection.</p>
        <form id="select-form-example">
          <div class="field mb-5">
            <select id="select-form-enhanced" name="enhanced">
              <option value="a" selected>Alpha</option>
              <option value="b">Beta</option>
              <optgroup label="Unavailable" disabled><option value="c">Charlie</option></optgroup>
            </select>
            <label for="select-form-enhanced">Enhanced choice</label>
          </div>
          <label for="select-form-native">Native choice</label>
          <select id="select-form-native" class="browser-default" name="native">
            <option value="a" selected>Alpha</option>
            <option value="b">Beta</option>
            <optgroup label="Unavailable" disabled><option value="c">Charlie</option></optgroup>
          </select>
          <button type="reset">Reset choices</button>
        </form>
  </Section>
  <Section {...S.properties}>
        <PropertiesTable el="The native <code>&lt;select&gt;</code> the plugin was initialized with.">
            <tr>
              <td><code>isMultiple</code></td>
              <td>Boolean</td>
              <td>Whether this is a multiple select.</td>
            </tr>
            <tr>
              <td><code>wrapper</code></td>
              <td>Element</td>
              <td>The <code>.field</code> wrapper, either the parent <code>.field</code> or one the plugin creates.</td>
            </tr>
            <tr>
              <td><code>menuEl</code></td>
              <td>Element</td>
              <td>The generated popup. A <code>&lt;menu&gt;</code> by default, or a dialog <code>&lt;div&gt;</code> containing a listbox when searchable.</td>
            </tr>
            <tr>
              <td><code>labelEl</code></td>
              <td>Element</td>
              <td>The associated label, or <code>null</code> if none was found.</td>
            </tr>
            <tr>
              <td><code>input</code></td>
              <td>Element</td>
              <td>The text input that shows the current selection.</td>
            </tr>
            <tr>
              <td><code>menu</code></td>
              <td>Menu</td>
              <td>The Menu instance for this select.</td>
            </tr>
        </PropertiesTable>
  </Section>
  <Section {...S.disabled}>
        <p>
          <code>disabled</code> on the <code>&lt;select&gt;</code> disables the whole control.
          <code>disabled</code> on an <code>&lt;option&gt;</code> makes that item unselectable.
        </p>
        <div class="field mb-5">
          <select id="form-select-7" disabled>
            <option value="" disabled selected>Choose your option</option>
            <option value="1">Option 1</option>
            <option value="2">Option 2</option>
            <option value="3">Option 3</option>
          </select>
          <label for="form-select-7">Disabled Select</label>
        </div>
        <p class="mb-5">
          <label for="form-select-8">Browser Disabled</label>
          <select id="form-select-8" class="browser-default" disabled>
            <option value="" disabled selected>Choose your option</option>
            <option value="1">Option 1</option>
            <option value="2">Option 2</option>
            <option value="3">Option 3</option>
          </select>
        </p>
<Code code={`
<div class="field">
  <select id="form-select-7" disabled>
    <option value="" disabled selected>Choose your option</option>
    <option value="1">Option 1</option>
  </select>
  <label for="form-select-7">Disabled Select</label>
</div>

<label for="form-select-8">Browser Disabled</label>
<select id="form-select-8" class="browser-default" disabled>
  <option value="" disabled selected>Choose your option</option>
  <option value="1">Option 1</option>
</select>
`} />
  </Section>
</DocsLayout>
