---
import DocsLayout from "../layouts/DocsLayout.astro";
import Section from "../components/Section.astro";
import Code from "../components/Code.astro";
import { defineSections } from "../lib/sections";

const S = defineSections([
  { id: "anatomy", label: "Anatomy", heading: false },
]);
---
<DocsLayout page="switches" sections={S}>
  <Section {...S.anatomy}>
        <p class="flow-text">
          Wrap an <code>&lt;input type="checkbox"&gt;</code> in a
          <code>&lt;label class="switch"&gt;</code>. Put the label text next
          to the input as a sibling. You do not need a <code>.lever</code>.
          Switches are CSS only, so there is no JavaScript component and
          nothing to AutoInit.
        </p>
        <p>
          Tokens follow the
          <a href="https://m3.material.io/components/switch/specs">M3 switch spec</a>.
          The track is 52×32dp. Unselected is
          <code>surface-container-highest</code> with a 2dp <code>outline</code> and
          a 16dp handle. Selected is a <code>primary</code> track and a
          24dp <code>on-primary</code> handle. The state layer is 40dp at
          8% hover and 10% focus. The touch target is 48dp. The label is
          <code>body-large</code> / <code>on-surface</code>. Disabled is
          38%.
        </p>

        <p>
          <label class="switch">
            <input type="checkbox">
            Wi-Fi
          </label>
        </p>
        <p>
          <label class="switch">
            <input type="checkbox" checked>
            Bluetooth
          </label>
        </p>
        <p>
          <label class="switch">
            <input type="checkbox" disabled>
            Airplane mode
          </label>
        </p>
        <p>
          <label class="switch">
            <input type="checkbox" checked disabled>
            Location
          </label>
        </p>
<Code code={`
<label class="switch">
  <input type="checkbox">
  Wi-Fi
</label>

<label class="switch">
  <input type="checkbox" checked>
  Bluetooth
</label>

<label class="switch">
  <input type="checkbox" disabled>
  Airplane mode
</label>
`} />
        <p>
          Hide on/off captions and name the control itself. The captions are
          decoration. Left as bare text, they become part of the label, and
          the switch announces itself as "Off On". A switch whose only text is
          a caption needs an <code>aria-label</code>, because hiding the
          captions leaves it with no name at all.
        </p>
<Code code={`
<label class="switch">
  <span aria-hidden="true">Off</span>
  <input type="checkbox" aria-label="Dark mode">
  <span aria-hidden="true">On</span>
</label>
`} />
  </Section>
</DocsLayout>
