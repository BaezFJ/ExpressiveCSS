---
import DocsLayout from "../layouts/DocsLayout.astro";
import PageBody from "../components/PageBody.astro";
import Section from "../components/Section.astro";
import Code from "../components/Code.astro";
import { defineSections } from "../lib/sections";

const S = defineSections([
  { id: "shadow", label: "Shadows", heading: false },
  { id: "stacking", label: "Stacking order" },
]);
const layers = [
  ["toolbar", "996", "A fixed toolbar."],
  ["app-bar", "997", "A pinned top app bar and a fixed navigation bar."],
  ["modal-rail", "998", "An expanded navigation rail over the page."],
  ["sheet", "1100", "A bottom or side sheet opened without showModal()."],
  ["lightbox", "1200", "The lightbox overlay and its zoomed image."],
  ["tooltip", "2000", "Tooltips."],
  ["menu", "9999", "Menus and the docked date and time pickers."],
  ["snackbar", "10000", "Snackbars."],
  ["confetti", "10001", "The confetti overlay, in browsers without popovers."],
];
---
<DocsLayout page="shadow">
<PageBody sections={S}>
  <Section {...S.shadow}>
        <p class="flow-text">
          In Material Design, every element has a z-depth. The z-depth sets how far the element rises above the page.
        </p>
        <p>
          To apply a shadow, add a class such as
          <code>class="z-depth-2"</code> to an HTML tag. In Sass, include the mixin instead of extending the class, as in
          <code>@include z-depth("2")</code>. To remove the shadow from an element that has a z-depth by default, use
          <code>z-depth-0</code>.
        </p>

        <div class="row py-4">
          <div class="s12 m4 l3">
            <div class="shadow-demo surface z-depth-0">0</div>
          </div>
          <div class="s12 m4 l3">
            <div class="shadow-demo surface z-depth-1">1</div>
          </div>
          <div class="s12 m4 l3">
            <div class="shadow-demo surface z-depth-2">2</div>
          </div>
          <div class="s12 m4 l3">
            <div class="shadow-demo surface z-depth-3">3</div>
          </div>
          <div class="s12 m4 l3">
            <div class="shadow-demo surface z-depth-4">4</div>
          </div>
          <div class="s12 m4 l3">
            <div class="shadow-demo surface z-depth-5">5</div>
          </div>
        </div>

<Code code={`
<div class="row">
  <div class="s12 m4 l3">
    <div class="z-depth-0">0</div>
  </div>
  <div class="s12 m4 l3">
    <div class="z-depth-1">1</div>
  </div>
  <div class="s12 m4 l3">
    <div class="z-depth-2">2</div>
  </div>
  <div class="s12 m4 l3">
    <div class="z-depth-3">3</div>
  </div>
  <div class="s12 m4 l3">
    <div class="z-depth-4">4</div>
  </div>
  <div class="s12 m4 l3">
    <div class="z-depth-5">5</div>
  </div>
</div>
`} />

        <h5>Sass</h5>
        <p>
          The build generates the classes from the same map as the mixin, so the two always match. Use the mixin inside component styles.
          <code>@extend .z-depth-2</code> across files is not supported.
        </p>
<Code code={`
.my-panel {
  @include z-depth("2");
}
`} />
        <p>
          <code>z-depth-1-half</code> adds an in-between level from the same elevation map.
        </p>
        <p>
          To soften or deepen a level at runtime, override its custom property in your theme. The
          properties run from <code>--md-sys-elevation-level0</code> to
          <code>--md-sys-elevation-level5</code>, plus <code>--md-sys-elevation-level1-half</code>.
          The classes, the mixin and every component read them.
        </p>
<Code code={`
<style>
  :root { --md-sys-elevation-level1: 0 1px 3px rgb(0 0 0 / 0.3); }
</style>
`} />
  </Section>
  <Section {...S.stacking}>
    <p>
      A shadow does not decide what sits on top. Surfaces that float over the page take their
      <code>z-index</code> from these properties, listed lowest first. Dialogs, modal sheets and open
      popovers sit in the browser's top layer, above all of them.
    </p>
    <table class="striped">
      <thead><tr><th>Property</th><th>Value</th><th>Used by</th></tr></thead>
      <tbody>
        {layers.map(([name, value, use]) => (
          <tr><td><code>--expressive-z-{name}</code></td><td>{value}</td><td>{use}</td></tr>
        ))}
      </tbody>
    </table>
<Code code={`
<style>
  /* A site banner that should cover the app bar but stay under sheets. */
  :root { --site-banner-z: calc(var(--expressive-z-app-bar) + 1); }
  .site-banner { position: sticky; top: 0; z-index: var(--site-banner-z); }
</style>
`} />
  </Section>
</PageBody>
</DocsLayout>
