---
import DocsLayout from "../layouts/DocsLayout.astro";
import PageBody from "../components/PageBody.astro";
import Section from "../components/Section.astro";
import Code from "../components/Code.astro";
import TokenTable from "../components/api/TokenTable.astro";
import { defineSections } from "../lib/sections";
import { route } from "../lib/catalogue";

const S = defineSections([
  { id: "anatomy", label: "Anatomy", heading: false },
  { id: "leading-action", label: "A leading action" },
  { id: "docked", label: "Docked view" },
  { id: "full-screen", label: "Full-screen view" },
  { id: "suggestions", label: "Suggestions are Autocomplete" },
  { id: "tokens", label: "Tokens" },
]);
---
<DocsLayout page="search">
<PageBody sections={S}>
  <Section {...S.anatomy}>
                    <p class="flow-text">
                        A <code>&lt;search&gt;</code> with <code>search-bar</code> on it
                        is the bar: a leading icon or icon button, an
                        <code>&lt;input type="search"&gt;</code>, and whatever trailing
                        actions the query needs. The element is the landmark, so you do
                        not need to add <code>role="search"</code>.
                    </p>
                    <search class="search-bar" aria-label="Search — Anatomy">
                        <span class="material-symbols" aria-hidden="true">search</span>
                        <input type="search" aria-label="Search recipes" placeholder="Search recipes">
                        <button type="button" class="icon-button" aria-label="Filters">
                            <span class="material-symbols" aria-hidden="true">tune</span>
                        </button>
                    </search>
                    <Code code={`
<search class="search-bar" aria-label="Search">
  <span class="material-symbols" aria-hidden="true">search</span>
  <input type="search" aria-label="Search recipes" placeholder="Search recipes">
  <button type="button" class="icon-button" aria-label="Filters">
    <span class="material-symbols" aria-hidden="true">tune</span>
  </button>
</search>
`} />
                    <p>
                        The input has none of the text field chrome: no underline,
                        floating label, or container of its own. The bar is the
                        container, so put the input in bare, not inside a
                        <code>.field</code>.
                    </p>
                    <p>
                        Spacing follows what is at each end: a bare glyph sits 16dp from
                        the edge, an icon button 4dp, because the button already insets
                        its own glyph by 12dp. You do not need to set anything, because
                        the bar adjusts to its children.
                    </p>
  </Section>
  <Section {...S["leading-action"]}>
                    <p>
                        When the bar opens a drawer or goes back, the leading glyph
                        becomes an icon button. The bar's leading space shrinks to 4dp
                        on its own.
                    </p>
                    <search class="search-bar" aria-label="Search — A leading action">
                        <button type="button" class="icon-button" aria-label="Open navigation">
                            <span class="material-symbols" aria-hidden="true">menu</span>
                        </button>
                        <input type="search" aria-label="Search mail" placeholder="Search mail">
                        <button type="button" class="icon-button" aria-label="Account">
                            <span class="material-symbols" aria-hidden="true">account_circle</span>
                        </button>
                    </search>
                    <Code code={`
<search class="search-bar" aria-label="Search">
  <button type="button" class="icon-button" aria-label="Open navigation">
    <span class="material-symbols" aria-hidden="true">menu</span>
  </button>
  <input type="search" aria-label="Search mail" placeholder="Search mail">
  <button type="button" class="icon-button" aria-label="Account">
    <span class="material-symbols" aria-hidden="true">account_circle</span>
  </button>
</search>
`} />
                    <p>
                        An <code>&lt;img&gt;</code> in the bar is the account avatar M3
                        puts in that slot. It is 30dp and circular. Put it inside the button
                        when it is tappable, so the 48dp target comes from the button.
                    </p>
  </Section>
  <Section {...S.docked}>
                    <p>
                        The docked view is a <code>.search-view</code> inside the bar. It
                        is positioned against the bar, so the bar keeps its
                        <code>position: relative</code> and the view needs no coordinates
                        of its own. Show and hide it with the
                        <code>hidden</code> attribute.
                    </p>
                    <p>
                        It is a plain element and not a <code>&lt;dialog&gt;</code>
                        because <code>dialog.show()</code> moves focus into the dialog,
                        which would take the caret out of the input the user is typing in.
                    </p>
                    <p>
                        The demo below starts open so the surface is on the page; the
                        sample under it has the <code>hidden</code> a real page would
                        write. Focus the input to reopen it.
                    </p>
                    <div class="search-demo">
                        <search class="search-bar" aria-label="Search — Docked view">
                            <span class="material-symbols" aria-hidden="true">search</span>
                            <input type="search" aria-label="Search fruit" placeholder="Search fruit"
                                   onfocus="document.getElementById('docked-view').hidden = false">
                            <button type="button" class="icon-button" aria-label="Close search"
                                    onclick="document.getElementById('docked-view').hidden = true">
                                <span class="material-symbols" aria-hidden="true">close</span>
                            </button>
                            <div class="search-view" id="docked-view">
                                <ul class="list">
                                    <li><a href="#!"><span class="material-symbols" aria-hidden="true">history</span><span>Apricot</span></a></li>
                                    <li><a href="#!"><span class="material-symbols" aria-hidden="true">history</span><span>Blackcurrant</span></a></li>
                                    <li><a href="#!"><span class="material-symbols" aria-hidden="true">trending_up</span><span>Clementine</span></a></li>
                                </ul>
                            </div>
                        </search>
                    </div>
                    <Code code={`
<search class="search-bar" aria-label="Search">
  <span class="material-symbols" aria-hidden="true">search</span>
  <input type="search" aria-label="Search fruit" placeholder="Search fruit"
         onfocus="document.getElementById('results').hidden = false">
  <button type="button" class="icon-button" aria-label="Close search"
          onclick="document.getElementById('results').hidden = true">
    <span class="material-symbols" aria-hidden="true">close</span>
  </button>

  <div class="search-view" id="results" hidden>
    <ul class="list">
      <li><a href="/apricot"><span class="material-symbols" aria-hidden="true">history</span><span>Apricot</span></a></li>
    </ul>
  </div>
</search>
`} />
  </Section>
  <Section {...S["full-screen"]}>
                    <p>
                        Full screen, the view is a <code>&lt;dialog&gt;</code> opened with
                        <code>showModal()</code>. The browser handles Escape and a tap
                        outside, so you only have to open it. Its header is another
                        <code>.search-bar</code> with the same markup, minus the pill
                        shape and the shadow.
                    </p>
                    <button type="button" class="outlined"
                            onclick="document.getElementById('search-full').showModal()">
                        Open full-screen search
                    </button>
                    <dialog class="search-view full-screen" id="search-full" aria-label="Search">
                        <search class="search-bar" aria-label="Search — Full-screen view">
                            <form method="dialog">
                                <button type="submit" class="icon-button" aria-label="Back">
                                    <span class="material-symbols" aria-hidden="true">arrow_back</span>
                                </button>
                            </form>
                            <input type="search" autofocus aria-label="Search fruit" placeholder="Search fruit">
                        </search>
                        <hr>
                        <ul class="list">
                            <li><a href="#!"><span class="material-symbols" aria-hidden="true">history</span><span>Apricot</span></a></li>
                            <li><a href="#!"><span class="material-symbols" aria-hidden="true">history</span><span>Blackcurrant</span></a></li>
                            <li><a href="#!"><span class="material-symbols" aria-hidden="true">trending_up</span><span>Clementine</span></a></li>
                        </ul>
                    </dialog>
                    <Code code={`
<button type="button" onclick="document.getElementById('search-full').showModal()">
  Search
</button>

<dialog class="search-view full-screen" id="search-full" aria-label="Search">
  <search class="search-bar" aria-label="Search">
    <form method="dialog">
      <button type="submit" class="icon-button" aria-label="Back">
        <span class="material-symbols" aria-hidden="true">arrow_back</span>
      </button>
    </form>
    <input type="search" autofocus aria-label="Search fruit" placeholder="Search fruit">
  </search>
  <hr>
  <ul class="list">
    <li><a href="/apricot"><span class="material-symbols" aria-hidden="true">history</span><span>Apricot</span></a></li>
  </ul>
</dialog>
`} />
                    <p>
                        Put <code>autofocus</code> on the input.
                        <code>showModal()</code> focuses the first focusable descendant,
                        which is the back button, so without <code>autofocus</code> a
                        keyboard user lands on Back and cannot type.
                    </p>
                    <p>
                        The M3 guideline is the full-screen view at Compact and the
                        docked view from Medium up. <strong>The app picks</strong>; the
                        stylesheet has no breakpoint that swaps one for the other. The
                        two use different markup. The docked view is a plain element
                        nested inside the bar, and the full-screen view is a top-level
                        <code>&lt;dialog&gt;</code>, so render the one that fits the
                        window size.
                    </p>
                    <Code code={`
if (window.matchMedia('(width < 600px)').matches) {
  document.getElementById('search-full').showModal();
} else {
  document.getElementById('results').hidden = false;
}
`} />
  </Section>
  <Section {...S.suggestions}>
                    <p>
                        Search does not ship a suggestion list of its own. Put
                        <code>autocomplete</code> on the bar's input and you get the
                        combobox, its listbox, and the arrow-key and
                        <code>aria-activedescendant</code> handling from
                        <a href={route('autocomplete')}>Autocomplete</a>, which
                        already implements and tests them.
                    </p>
                    <Code code={`
<search class="search-bar" aria-label="Search">
  <span class="material-symbols" aria-hidden="true">search</span>
  <input type="search" class="autocomplete" aria-label="Search fruit" placeholder="Search fruit">
</search>
`} />
                    <Code code={`
Expressive.Autocomplete.init(document.querySelector('.search-bar input'), {
  minLength: 0,
  data: [{ id: 'Apricot' }, { id: 'Blackcurrant' }, { id: 'Clementine' }]
});
`} />
                    <p>
                        Search and Autocomplete share nothing else, by design. A
                        <code>.search-view</code> takes no composite role. Its contents
                        are links and buttons that users reach with Tab. A second listbox
                        here would announce the same behavior as Autocomplete's without
                        the keyboard handling behind it. Use the view for recent searches, filters, and results;
                        use Autocomplete for a list the user arrows through.
                    </p>
  </Section>
  <Section {...S.tokens}>
                    <p>Override these on the bar or on the view.</p>
                    <TokenTable>
                      <tr>
                        <td><code>--md-comp-search-bar-container-color</code></td>
                        <td><code>--md-sys-color-surface-container-high</code></td>
                      </tr>
                      <tr>
                        <td><code>--md-comp-search-bar-container-height</code></td>
                        <td>56px</td>
                      </tr>
                      <tr>
                        <td><code>--md-comp-search-bar-container-shape</code></td>
                        <td>9999px (full)</td>
                      </tr>
                      <tr>
                        <td><code>--md-comp-search-bar-leading-space</code></td>
                        <td>16px, or 4px beside an icon button</td>
                      </tr>
                      <tr>
                        <td><code>--md-comp-search-bar-trailing-space</code></td>
                        <td>16px, or 4px beside an icon button</td>
                      </tr>
                      <tr>
                        <td><code>--md-comp-search-bar-icon-label-space</code></td>
                        <td>16px</td>
                      </tr>
                      <tr>
                        <td><code>--md-comp-search-bar-icon-size</code></td>
                        <td>24px</td>
                      </tr>
                      <tr>
                        <td><code>--md-comp-search-bar-avatar-size</code></td>
                        <td>30px</td>
                      </tr>
                      <tr>
                        <td><code>--md-comp-search-view-container-color</code></td>
                        <td><code>--md-sys-color-surface-container-high</code></td>
                      </tr>
                      <tr>
                        <td><code>--md-comp-search-view-container-shape</code></td>
                        <td>12px, 0 full-screen</td>
                      </tr>
                      <tr>
                        <td><code>--md-comp-search-view-header-height</code></td>
                        <td>56px, 72px full-screen</td>
                      </tr>
                      <tr>
                        <td><code>--md-comp-search-view-divider-color</code></td>
                        <td><code>--md-sys-color-outline</code></td>
                      </tr>
                      <tr>
                        <td><code>--md-comp-search-view-bar-results-gap</code></td>
                        <td>2px</td>
                      </tr>
                      <tr>
                        <td><code>--md-comp-search-view-max-height</code></td>
                        <td>60vh, none full-screen</td>
                      </tr>
                    </TokenTable>
  </Section>
</PageBody>
</DocsLayout>
