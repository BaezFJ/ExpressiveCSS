---
import DocsLayout from "../layouts/DocsLayout.astro";
import PageBody from "../components/PageBody.astro";
import Section from "../components/Section.astro";
import Code from "../components/Code.astro";
import { defineSections } from "../lib/sections";
import { route } from "../lib/catalogue";

const S = defineSections([
  { id: "usage", label: "Usage", heading: false },
  { id: "style", label: "Style" },
  { id: "axes", label: "Axes", heading: "Fill, weight, grade, optical size" },
  { id: "sizes", label: "Sizes" },
]);
---
<DocsLayout page="icons">
<PageBody sections={S}>
  <li slot="toc-extra"><a href="https://fonts.google.com/icons?icon.set=Material+Symbols" target="_blank" rel="noopener">Catalog</a></li>
  <Section {...S.usage}>
        <p class="flow-text">
          Icons are Material Symbols. The default class is
          <code>material-symbols</code>; it uses the outlined family.
          Ligature names come from the
          <a href="https://fonts.google.com/icons?icon.set=Material+Symbols" target="_blank" rel="noopener">Material Symbols catalog</a>.
        </p>
        <p>
          The framework does not ship the font files. Outlined, rounded, and
          sharp are three separate variable fonts — bundling them would
          dwarf the rest of the CSS. Load the families you actually use,
          with the axis ranges so fill / weight / grade / optical size work.
          Outlined alone is enough for the default.
        </p>
<Code code={`
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=block" rel="stylesheet">

<!-- Only if you switch style to rounded or sharp -->
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=block" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Sharp:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=block" rel="stylesheet">
`} />
        <p>
          Put <code>material-symbols</code> on an element and use the ligature
          as the text. <code>.material-icons</code> is kept as an alias so
          older markup still renders with Symbols.
        </p>
        <div class="row py-5">
          <div class="s3 center-align">
            <span class="material-symbols medium" aria-hidden="true">add</span>
            <p>Default</p>
          </div>
          <div class="s3 center-align">
            <span class="material-symbols-outlined medium" aria-hidden="true">add</span>
            <p>Outlined</p>
          </div>
          <div class="s3 center-align">
            <span class="material-symbols-rounded medium" aria-hidden="true">add</span>
            <p>Rounded</p>
          </div>
          <div class="s3 center-align">
            <span class="material-symbols-sharp medium" aria-hidden="true">add</span>
            <p>Sharp</p>
          </div>
        </div>
<Code code={`
<span class="material-symbols" aria-hidden="true">add</span>
<span class="material-symbols-rounded" aria-hidden="true">add</span>
<span class="material-symbols-sharp" aria-hidden="true">add</span>
`} />
        <p>
          Icons inherit the current text color, so token utilities such as
          <code>primary-text</code> work. For icons inside buttons, see
          <a href={route('buttons')}>Buttons</a>.
        </p>
  </Section>
  <Section {...S.style}>
        <p>
          Outlined, rounded, and sharp are font families, not variation
          axes. Set the <code>icon-style</code> attribute — the same idea as
          <code>theme</code> — or set <code>--md-icon-font</code> directly.
          Either one inherits, so a subtree can use a different style.
        </p>
<Code code={`
<html icon-style="rounded">
<div icon-style="sharp">…</div>
<div style="--md-icon-font: var(--md-icon-font-sharp)">…</div>
`} />
        <p>
          Values are <code>outlined</code> (default), <code>rounded</code>,
          and <code>sharp</code>. A single icon can still opt out with
          <code>material-symbols-rounded</code> or
          <code>material-symbols-sharp</code>.
        </p>
        <div class="row py-3">
          <div class="s4 center-align" icon-style="outlined">
            <span class="material-symbols medium" aria-hidden="true">settings</span>
            <p><code>outlined</code></p>
          </div>
          <div class="s4 center-align" icon-style="rounded">
            <span class="material-symbols medium" aria-hidden="true">settings</span>
            <p><code>rounded</code></p>
          </div>
          <div class="s4 center-align" icon-style="sharp">
            <span class="material-symbols medium" aria-hidden="true">settings</span>
            <p><code>sharp</code></p>
          </div>
        </div>
  </Section>
  <Section {...S.axes}>
        <p>
          These four are variable-font axes. They inherit, so set them on
          <code>:root</code> or on a wrapper. A missing range in the Google
          Fonts URL (a link without <code>opsz,wght,FILL,GRAD@…</code>)
          serves a static instance and the axes will not move.
        </p>
        <table class="striped">
          <thead>
            <tr>
              <th>Token</th>
              <th>Default</th>
              <th>Range</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><code>--md-icon-fill</code></td>
              <td>0</td>
              <td>0 or 1</td>
            </tr>
            <tr>
              <td><code>--md-icon-weight</code></td>
              <td>400</td>
              <td>100–700</td>
            </tr>
            <tr>
              <td><code>--md-icon-grade</code></td>
              <td>0</td>
              <td>−50–200</td>
            </tr>
            <tr>
              <td><code>--md-icon-optical-size</code></td>
              <td>24</td>
              <td>20–48 (unitless)</td>
            </tr>
          </tbody>
        </table>
<Code code={`
:root {
  --md-icon-fill: 0;
  --md-icon-weight: 400;
  --md-icon-grade: 0;
  --md-icon-optical-size: 24;
}

<span class="material-symbols" style="--md-icon-fill: 1; --md-icon-weight: 600" aria-hidden="true">favorite</span>
`} />
        <p>
          <code>icon-filled</code> is a shortcut for
          <code>--md-icon-fill: 1</code>.
        </p>
        <div class="row py-3">
          <div class="s3 center-align">
            <span class="material-symbols medium" aria-hidden="true">favorite</span>
            <p>Empty</p>
          </div>
          <div class="s3 center-align">
            <span class="material-symbols medium icon-filled" aria-hidden="true">favorite</span>
            <p>Filled</p>
          </div>
          <div class="s3 center-align">
            <span class="material-symbols medium" style="--md-icon-weight: 200" aria-hidden="true">settings</span>
            <p>Weight 200</p>
          </div>
          <div class="s3 center-align">
            <span class="material-symbols medium" style="--md-icon-weight: 700" aria-hidden="true">settings</span>
            <p>Weight 700</p>
          </div>
        </div>
  </Section>
  <Section {...S.sizes}>
        <p>
          Size an icon with <code>font-size</code>, or use the preset classes
          on the icon: <code>tiny</code> (1rem),
          <code>small</code> (2rem), <code>medium</code> (4rem), and
          <code>large</code> (6rem). Those classes also nudge
          <code>--md-icon-optical-size</code> so the glyph is cut for that
          size.
        </p>
        <div class="row pt-5">
          <div class="s3 center-align"><span class="material-symbols tiny" aria-hidden="true">insert_chart</span></div>
          <div class="s3 center-align"><span class="material-symbols small" aria-hidden="true">insert_chart</span></div>
          <div class="s3 center-align"><span class="material-symbols medium" aria-hidden="true">insert_chart</span></div>
          <div class="s3 center-align"><span class="material-symbols large" aria-hidden="true">insert_chart</span></div>
        </div>
        <div class="row pb-5">
          <div class="s3 center-align">Tiny</div>
          <div class="s3 center-align">Small</div>
          <div class="s3 center-align">Medium</div>
          <div class="s3 center-align">Large</div>
        </div>
<Code code={`
<span class="material-symbols large" aria-hidden="true">insert_chart</span>
`} />
  </Section>
</PageBody>
</DocsLayout>
