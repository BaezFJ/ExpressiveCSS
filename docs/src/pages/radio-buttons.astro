---
import DocsLayout from "../layouts/DocsLayout.astro";
import PageBody from "../components/PageBody.astro";
import Section from "../components/Section.astro";
import Code from "../components/Code.astro";
import { defineSections } from "../lib/sections";

const S = defineSections([
  { id: "anatomy", label: "Anatomy", heading: false },
  { id: "row", label: "In a row" },
]);
---
<DocsLayout page="radio_buttons">
<PageBody sections={S}>
  <Section {...S.anatomy}>
        <p class="flow-text">
          A <code>&lt;label&gt;</code> wrapping <code>&lt;input type="radio"&gt;</code>
          is the control. The label text is a sibling of the input — no extra
          class, no required <code>&lt;span&gt;</code>. They are CSS only.
          There is no JavaScript component and nothing to AutoInit.
        </p>
        <p>
          Tokens follow the
          <a href="https://m3.material.io/components/radio-button/specs">M3 radio spec</a>.
          The icon is a 20dp ring with a 2dp stroke. Selected is
          <code>primary</code> with a 10dp inner disc (the M3 gap). The
          state layer is 40dp at 8% hover and 10% focus. The touch target
          is 48dp. The label is <code>body-large</code> /
          <code>on-surface</code>. Disabled is <code>on-surface</code> at 38%.
        </p>
        <p>
          Use the same <code>name</code> on every radio in a group. Add
          <code>disabled</code> to disable one. <code>with-gap</code> is a
          no-op — the selected state is always the ring plus inner disc.
        </p>
        <fieldset>
          <legend>Colour</legend>
          <label>
            <input name="group1" type="radio" checked>
            Red
          </label>
          <label>
            <input name="group1" type="radio">
            Yellow
          </label>
          <label>
            <input name="group1" type="radio">
            Green
          </label>
          <label>
            <input name="group1" type="radio" disabled>
            Brown
          </label>
        </fieldset>
<Code code={`
<fieldset>
  <legend>Colour</legend>
  <label>
    <input name="group1" type="radio" checked>
    Red
  </label>
  <label>
    <input name="group1" type="radio">
    Yellow
  </label>
  <label>
    <input name="group1" type="radio" disabled>
    Brown
  </label>
</fieldset>
`} />
        <p>
          An <code>input + span</code> still works if you already have that
          markup, or if you follow BeerCSS’s
          <code>&lt;label class="radio"&gt;</code> pattern.
        </p>
<Code code={`
<fieldset>
  <legend>Colour</legend>
  <label class="radio">
    <input type="radio" name="group1">
    <span>Yellow</span>
  </label>
</fieldset>
`} />
  </Section>
  <Section {...S.row}>
        <p>
          Put the labels in a <code>&lt;div class="inline"&gt;</code> to sit them on one
          line. A bare group stacks vertically.
        </p>
        <fieldset>
          <legend>Colour</legend>
          <div class="inline">
            <label>
              <input name="group2" type="radio" checked>
              Red
            </label>
            <label>
              <input name="group2" type="radio">
              Yellow
            </label>
            <label>
              <input name="group2" type="radio">
              Green
            </label>
          </div>
        </fieldset>
<Code code={`
<fieldset>
  <legend>Colour</legend>
  <div class="inline">
    <label>
      <input name="group2" type="radio" checked>
      Red
    </label>
    <label>
      <input name="group2" type="radio">
      Yellow
    </label>
  </div>
</fieldset>
`} />
  </Section>
</PageBody>
</DocsLayout>
