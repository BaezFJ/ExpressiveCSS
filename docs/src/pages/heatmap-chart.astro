---
import DocsLayout from "../layouts/DocsLayout.astro";
import Section from "../components/Section.astro";
import Code from "../components/Code.astro";
import TokenTable from "../components/api/TokenTable.astro";
import { defineSections } from "../lib/sections";

const S = defineSections([
  { id: "anatomy", label: "Anatomy", heading: false },
  { id: "values", label: "Values" },
  { id: "labels", label: "Short labels" },
  { id: "scale", label: "Scale" },
  { id: "cards", label: "Chart cards" },
  { id: "data", label: "Values and colors" },
  { id: "accessibility", label: "Accessibility" },
  { id: "javascript", label: "JavaScript" },
  { id: "tokens", label: "Tokens" },
]);

const days = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
const tasks = [
  [2, 5, 3, 7, 4, 6, 8, 3, 5, 9, 4, 6], [4, 3, 6, 2, 8, 5, 3, 7, 6, 4, 8, 5], [6, 7, 4, 8, 3, 9, 5, 6, 2, 7, 5, 9],
  [3, 4, 8, 5, 6, 2, 7, 4, 8, 3, 6, 7], [7, 8, 5, 9, 4, 7, 6, 9, 5, 8, 7, 4], [1, 2, 0, 3, 1, 2, 0, 1, 3, 2, 1, 0],
  [0, 1, 2, 0, 1, 0, 2, 0, 1, 0, 2, 1],
];
const weeks = Array.from({ length: 12 }, (_, i) => `Week ${i + 1}`);
const months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun"];
const change: [string, number[]][] = [["North", [-12, -5, 0, 4, 9, 15]], ["South", [-20, -8, -2, 3, 6, 11]], ["East", [-3, 1, 5, 10, 18, 25]]];
const daily: [string, number[]][] = days.map((day, i) => [day, tasks[i]]);
// A table's head and body as HTML, for the examples that only differ in data.
const table = (corner: string, columns: string[], rows: [string, number[]][]) =>
  `<thead><tr><th>${corner}</th>${columns.map((column) => `<th>${column}</th>`).join("")}</tr></thead>`
  + `<tbody>${rows.map(([label, values]) => `<tr><th>${label}</th>${values.map((value) => `<td>${value}</td>`).join("")}</tr>`).join("")}</tbody>`;
const sales: [string, number[]][] = [
  ["Priya", [45, 58, 85, 41, 47, 58]], ["Daniel", [88, 34, 45, 91, 52, 40]], ["Amara", [60, 48, 65, 58, 62, 70]],
  ["Leo", [85, 72, 78, 80, 50, 98]], ["Wei", [35, 71, 30, 44, 88, 90]],
];
const slots = ["Morning", "Afternoon", "Evening", "Night"];
const traffic = [[12, 45, 38, 8], [15, 50, 42, 10], [18, 55, 48, 12], [20, 60, 52, 14], [22, 58, 65, 20], [30, 40, 70, 35], [28, 35, 68, 32]];
const channels: [string, number[]][] = [["Paid", [81, 47, 58]], ["Organic", [68, 55, 90]]];

// A year of activity, the same every build.
let seed = 42;
const random = () => (seed = (9301 * seed + 49297) % 233280) / 233280;
const sunday = ["Sun", ...days.slice(0, 6)];
const typical = [1, 6, 7, 8, 7, 6, 1];
const year = sunday.map((_, day) =>
  Array.from({ length: 52 }, () => Math.max(0, Math.min(12, typical[day] + Math.round(6 * random()) - 3))));
const starts: Record<number, string> = { 0: "Jan", 4: "Feb", 9: "Mar", 13: "Apr", 17: "May", 22: "Jun", 26: "Jul", 30: "Aug", 35: "Sep", 39: "Oct", 43: "Nov", 48: "Dec" };
const total = (rows: number[][]) => rows.flat().reduce((sum, value) => sum + value, 0);
---
<DocsLayout page="heatmap-chart" sections={S}>
  <Section {...S.anatomy}>
        <p class="flow-text">
          A <code>&lt;figure class="heatmap-chart"&gt;</code> draws a
          <code>&lt;table&gt;</code> as a grid of shaded cells. Each body row
          is a row of the grid and each value column is a column, so the grid
          has the table's shape.
        </p>
        <p>
          It takes the same markup as a <a href="column-chart.html">column
          chart</a>. The row headers sit beside the grid and the column headers
          below it. Cells shade from the lowest value to the highest, and a
          scale under the grid names both ends. A tooltip shows the cell under
          the pointer. When the chart has focus, the arrow keys move the
          tooltip round the grid.
        </p>
        <p>
          Use a heatmap to find patterns across two categories, such as busy
          days and hours. To compare exact values, use a
          <a href="data-table.html">data table</a>.
        </p>
        <figure class="heatmap-chart" data-markdown-ignore>
          <figcaption>Tasks completed per day, last 12 weeks</figcaption>
          <table>
            <thead><tr><th>Day</th>{weeks.map((week) => <th data-label="">{week}</th>)}</tr></thead>
            <tbody>{days.map((day, row) => <tr><th>{day}</th>{tasks[row].map((value) => <td>{value}</td>)}</tr>)}</tbody>
          </table>
        </figure>
<Code code={`
<figure class="heatmap-chart">
  <figcaption>Tasks completed per day, last 12 weeks</figcaption>
  <table>
    <thead>
      <tr>
        <th>Day</th>
        <th data-label="">Week 1</th>
        <th data-label="">Week 2</th>
        <!-- One header per week -->
      </tr>
    </thead>
    <tbody>
      <tr><th>Mon</th><td>2</td><td>5</td><!-- … --></tr>
      <tr><th>Tue</th><td>4</td><td>3</td><!-- … --></tr>
      <!-- One row per day -->
    </tbody>
  </table>
</figure>
`} />
        <p>
          Set an empty <code>data-label</code> to hide a header on the grid,
          as the week numbers are here. The table keeps the full header for screen
          readers and the tooltip.
        </p>
  </Section>
  <Section {...S.values}>
        <p>
          Add <code>values</code> to write each cell's text on it. The text is
          black or white, whichever reads better on the cell's shade. Give a
          formatted cell its number in <code>data-value</code>.
        </p>
        <figure class="heatmap-chart values" data-markdown-ignore>
          <figcaption>Revenue by rep, per month</figcaption>
          <table>
            <thead><tr><th>Rep</th>{months.map((month) => <th>{month}</th>)}</tr></thead>
            <tbody>{sales.map(([rep, values]) => <tr><th>{rep}</th>{values.map((value) => <td data-value={value * 1000}>${value}K</td>)}</tr>)}</tbody>
          </table>
        </figure>
<Code code={`
<figure class="heatmap-chart values">
  <figcaption>Revenue by rep, per month</figcaption>
  <table>
    <thead>
      <tr><th>Rep</th><th>Jan</th><th>Feb</th><!-- … --></tr>
    </thead>
    <tbody>
      <tr>
        <th>Priya</th>
        <td data-value="45000">$45K</td>
        <td data-value="58000">$58K</td>
        <!-- … -->
      </tr>
      <!-- One row per rep -->
    </tbody>
  </table>
</figure>
`} />
  </Section>
  <Section {...S.labels}>
        <p>
          A <code>data-label</code> on a header cell replaces its text on the
          grid. A column label runs on over the empty labels after it, so a
          year of weeks can name each month once. Row labels take up to 40% of
          the width and end in an ellipsis past it.
        </p>
        <p>
          For small cells, set <code>--md-comp-heatmap-chart-row-height</code>
          and <code>--md-comp-heatmap-chart-gap</code> lower. A wide grid
          narrows its cells to fit, so show fewer columns on a phone. When the
          column labels are wider than their columns, the grid keeps every
          second or third one whole and hides the rest. To choose which ones
          show, leave labels empty yourself.
        </p>
        <figure class="heatmap-chart" style="--md-comp-heatmap-chart-row-height: 12px; --md-comp-heatmap-chart-gap: 2px; --md-comp-heatmap-chart-shape: 2px" data-markdown-ignore>
          <figcaption>Tasks completed, last 52 weeks</figcaption>
          <table>
            <thead><tr><th>Day</th>{year[0].map((_, week) => <th data-label={starts[week] ?? ""}>Week {week + 1}</th>)}</tr></thead>
            <tbody>{sunday.map((day, row) => <tr><th data-label={["Mon", "Wed", "Fri"].includes(day) ? undefined : ""}>{day}</th>{year[row].map((value) => <td>{value}</td>)}</tr>)}</tbody>
          </table>
        </figure>
<Code code={`
<figure class="heatmap-chart" style="
    --md-comp-heatmap-chart-row-height: 12px;
    --md-comp-heatmap-chart-gap: 2px;
    --md-comp-heatmap-chart-shape: 2px">
  <figcaption>Tasks completed, last 52 weeks</figcaption>
  <table>
    <thead>
      <tr>
        <th>Day</th>
        <th data-label="Jan">Week 1</th>
        <th data-label="">Week 2</th>
        <!-- One header per week -->
      </tr>
    </thead>
    <tbody>
      <tr><th data-label="">Sun</th><td>0</td><!-- … --></tr>
      <tr><th>Mon</th><td>4</td><!-- … --></tr>
      <!-- One row per day -->
    </tbody>
  </table>
</figure>
`} />
  </Section>
  <Section {...S.scale}>
        <p>
          The scale runs from the lowest value to the highest. To fix it, set
          <code>data-min</code> and <code>data-max</code> on the chart, such as
          0 to 100 for scores. Values past either end take the end's shade.
          The scale under the grid still runs from the lowest cell to the
          highest, over only the shades they use.
        </p>
        <p>
          Cells are at least <code>--md-comp-heatmap-chart-cell-min-width</code>
          wide, 12px by default. A grid with too many columns for its figure
          scrolls its cells sideways instead of narrowing them, and keeps the
          row labels in view. The arrow keys scroll the cell they move to into
          view.
        </p>
        <figure class="heatmap-chart values" data-min="0" data-max="100" style="--md-comp-heatmap-chart-row-height: 56px; --md-comp-heatmap-chart-gap: 4px; --md-comp-heatmap-chart-shape: 12px" data-markdown-ignore>
          <figcaption>Channel score, paid and organic</figcaption>
          <table>
            <thead><tr><th>Type</th><th>Search</th><th>Social</th><th>Referral</th></tr></thead>
            <tbody>{channels.map(([type, values]) => <tr><th>{type}</th>{values.map((value) => <td>{value}</td>)}</tr>)}</tbody>
          </table>
        </figure>
<Code code={`
<figure class="heatmap-chart values" data-min="0" data-max="100" style="
    --md-comp-heatmap-chart-row-height: 56px;
    --md-comp-heatmap-chart-gap: 4px;
    --md-comp-heatmap-chart-shape: 12px">
  <figcaption>Channel score, paid and organic</figcaption>
  <table>
    <thead>
      <tr><th>Type</th><th>Search</th><th>Social</th><th>Referral</th></tr>
    </thead>
    <tbody>
      <tr><th>Paid</th><td>81</td><td>47</td><td>58</td></tr>
      <tr><th>Organic</th><td>68</td><td>55</td><td>90</td></tr>
    </tbody>
  </table>
</figure>
`} />
        <p>
          Set <code>data-mid</code> to make the scale diverge from that value,
          such as 0 for a change. The midpoint takes the empty color. Values
          above it shade towards <code>--md-comp-heatmap-chart-color</code>
          and values below towards <code>--md-comp-heatmap-chart-low-color</code>.
          Both sides run as far as the end further from the midpoint, so equal
          distances get equal shades.
        </p>
        <figure class="heatmap-chart values" data-mid="0" data-markdown-ignore>
          <figcaption>Sales change on last year, in percent</figcaption>
          <table set:html={table("Region", months, change)}></table>
        </figure>
<Code code={`
<figure class="heatmap-chart values" data-mid="0">
  <figcaption>Sales change on last year, in percent</figcaption>
  <table>
    <thead>
      <tr><th>Region</th><th>Jan</th><th>Feb</th><!-- … --></tr>
    </thead>
    <tbody>
      <tr><th>North</th><td>-12</td><td>-5</td><!-- … --></tr>
    </tbody>
  </table>
</figure>
`} />
        <p>
          Set <code>data-steps</code> to group the shades into that many
          bands. The lowest band takes the empty color, and the scale under
          the grid shows a swatch per band. On a diverging scale each side gets that many
          bands, and the band nearest the midpoint is the empty color.
        </p>
        <figure class="heatmap-chart" data-steps="4" data-markdown-ignore>
          <figcaption>Tasks closed per day</figcaption>
          <table set:html={table("Day", weeks, daily)}></table>
        </figure>
<Code code={`
<figure class="heatmap-chart" data-steps="4">
  <figcaption>Tasks closed per day</figcaption>
  <table>
    <thead>
      <tr><th>Day</th><th>Week 1</th><th>Week 2</th><!-- … --></tr>
    </thead>
    <tbody>
      <tr><th>Mon</th><td>2</td><td>5</td><!-- … --></tr>
    </tbody>
  </table>
</figure>
`} />
  </Section>
  <Section {...S.cards}>
        <p>
          Put a chart in a card with the figures it explains. The card adds
          no chart styles, so size the chart with its tokens.
        </p>
        <article class="outlined" data-markdown-ignore>
          <div class="p-4">
            <dl class="stats my-0">
              <div><dt>Weekly visits</dt><dd>{total(traffic).toLocaleString("en-US")}</dd><dd class="stat-change">Busiest on Saturday evening</dd></div>
            </dl>
            <figure class="heatmap-chart">
              <figcaption class="visually-hidden">Visits by day and time, last 7 days</figcaption>
              <table>
                <thead><tr><th>Day</th>{slots.map((slot) => <th>{slot}</th>)}</tr></thead>
                <tbody>{days.map((day, row) => <tr><th>{day}</th>{traffic[row].map((value) => <td>{value}</td>)}</tr>)}</tbody>
              </table>
            </figure>
          </div>
        </article>
<Code code={`
<article class="outlined">
  <div class="p-4">
    <dl class="stats my-0">
      <div>
        <dt>Weekly visits</dt>
        <dd>${total(traffic).toLocaleString("en-US")}</dd>
        <dd class="stat-change">Busiest on Saturday evening</dd>
      </div>
    </dl>
    <figure class="heatmap-chart">
      <figcaption class="visually-hidden">Visits by day and time, last 7 days</figcaption>
      <table><!-- … --></table>
    </figure>
  </div>
</article>
`} />
  </Section>
  <Section {...S.data}>
        <p>
          The chart reads cells the same way a column chart does. A cell's
          number is its <code>data-value</code>, or its text without currency
          signs, percent signs or grouping commas. Text that is not a single
          number, such as "n/a" or "$45K" without a <code>data-value</code>,
          is a gap. A gap draws as an outlined cell with no shade, and the
          tooltip still shows its text. A chart whose cells are all gaps shows
          its table.
        </p>
        <p>
          Cells mix <code>primary</code> into
          <code>surface-container-highest</code> by their place on the scale.
          The tooltip swatch takes the cell's shade.
        </p>
  </Section>
  <Section {...S.accessibility}>
        <p>
          The table is the chart's text alternative. Give it a header row and
          a header cell per row, and name the chart with a
          <code>&lt;figcaption&gt;</code>. The chart hides the drawn grid,
          labels and scale from assistive technology. A <code>data-label</code>
          changes only the drawn label.
        </p>
        <p>
          The plot is one Tab stop, named by the caption. The arrow keys move
          one cell the way they point. Home and End jump to the ends of the
          row, and Escape hides the tooltip. Once the tooltip is hidden, Escape
          goes to a dialog around the chart. On a touch screen, tap a cell or
          drag across the grid to show a cell. In a right-to-left page the
          columns run right to left.
        </p>
        <p>
          The tooltip is a polite live region, so a screen reader hears each
          cell's row, column and value as it moves. Shade alone is hard to
          tell apart, so use <code>values</code> when exact numbers matter. In
          forced colors the cells keep their shades.
        </p>
  </Section>
  <Section {...S.javascript}>
        <p>
          <code>AutoInit()</code> starts every <code>.heatmap-chart</code>. To
          start one yourself, call <code>HeatmapChart.init</code>. After changing its
          table, call <code>update()</code> to redraw it in place. Or put
          <code>data-watch</code> on the figure, and it redraws itself. It has
          the line chart's options and methods. <code>show()</code> takes a
          cell, counted row by row from 0.
        </p>
<Code code={`
const chart = Expressive.HeatmapChart.init(document.querySelector('.heatmap-chart'), { min: 0, max: 100 });
chart.show(13);  // highlight the second row's second cell in a 12-column grid; -1 hides the tooltip
chart.update();  // redraw from the table; focus and the highlighted row stay
chart.destroy(); // remove the drawing and show the table again
`} />
  </Section>
  <Section {...S.tokens}>
        <p>Override these on the <code>.heatmap-chart</code>.</p>
        <TokenTable>
          <tr><td><code>--md-comp-heatmap-chart-row-height</code></td><td>32px</td></tr>
          <tr><td><code>--md-comp-heatmap-chart-cell-min-width</code></td><td>12px; below it a wide grid scrolls</td></tr>
          <tr><td><code>--md-comp-heatmap-chart-gap</code></td><td>3px between cells</td></tr>
          <tr><td><code>--md-comp-heatmap-chart-shape</code></td><td>4px, the cell's corner radius</td></tr>
          <tr><td><code>--md-comp-heatmap-chart-color</code></td><td><code>primary</code>, the highest value's shade</td></tr>
          <tr><td><code>--md-comp-heatmap-chart-low-color</code></td><td><code>tertiary</code>, the lowest value's shade on a diverging scale</td></tr>
          <tr><td><code>--md-comp-heatmap-chart-empty-color</code></td><td><code>surface-container-highest</code>, the lowest value's shade, or the midpoint's</td></tr>
          <tr><td><code>--md-comp-heatmap-chart-grid-color</code></td><td><code>outline-variant</code>, a gap's outline</td></tr>
        </TokenTable>
        <p>For a selective Sass build, include <code>"heatmap-chart"</code> in <code>$components</code>.</p>
  </Section>
</DocsLayout>
