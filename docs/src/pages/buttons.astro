---
import DocsLayout from "../layouts/DocsLayout.astro";
import PageBody from "../components/PageBody.astro";
import Section from "../components/Section.astro";
import Code from "../components/Code.astro";
import { defineSections } from "../lib/sections";
import { route } from "../lib/catalogue";

const S = defineSections([
  { id: "anatomy", label: "Anatomy", heading: false },
  { id: "filled", label: "Filled" },
  { id: "filled-tonal", label: "Tonal" },
  { id: "outlined", label: "Outlined" },
  { id: "elevated", label: "Elevated" },
  { id: "text", label: "Text" },
  { id: "icon", label: "Icon buttons" },
  { id: "floating", label: "Floating" },
  { id: "sizes", label: "Sizes" },
  { id: "shape", label: "Shape and toggles" },
  { id: "disabled", label: "Disabled" },
]);
---
<DocsLayout page="buttons">
<PageBody sections={S}>
  <Section {...S.anatomy}>
        <p class="flow-text">
          Use a <code>&lt;button&gt;</code> for a filled common button, or an
          <code>&lt;a class="button"&gt;</code> for a link that looks the same. Put an
          <code>&lt;span class="material-symbols" aria-hidden="true"&gt;</code> icon before or after the label and wrap the label in its own
          <code>&lt;span&gt;</code>. The order of the two spans sets the
          placement. There is no <code>icon-left</code> or
          <code>icon-right</code> class. An icon-only button needs an <code>aria-label</code>,
          because the icon is hidden from assistive technology. Add <code>circle</code> for a round
          common button. Icon buttons are
          <a href={route('icon_buttons')}><code>.icon-button</code></a>.
        </p>
        <p>
          A button has two independent axes: a <a href="#filled">style</a>
          (<code>filled</code>, <code>tonal</code>, <code>outlined</code>,
          <code>elevated</code>, <code>text</code>) and a
          <a href="#sizes">size</a> (<code>xsmall</code> through
          <code>xlarge</code>). Any style combines with any size. That takes
          nine classes instead of twenty-five, because the size sets the
          geometry and the style sets the color.
        </p>
        <p>
          Tokens follow the
          <a href="https://m3.material.io/components/buttons/specs">M3 button spec</a>.
          The default is the small size: 40dp tall, a
          <code>label-large</code> label, fully round corners, a 20dp icon on an
          8dp gap, and a symmetric 16dp inset. State layers are 8% on hover and
          10% on focus or press. A disabled button uses <code>on-surface</code>
          at 38% on a 12% container.
        </p>
        <p>
          A label that does not fit wraps between words, and the button grows
          taller. With enlarged text, 200% zoom or a narrow column, the label stays
          inside the button and the button stays inside its parent. The size's height
          is the minimum, so a label that fits looks the same. Keep the label
          in its own <code>&lt;span&gt;</code> so a single word longer than the
          parent can break as well. These stay on one line at a fixed height:
          <code>circle</code> buttons, FABs, extended
          FABs, Timepicker AM/PM controls, and buttons in button groups, split
          buttons, toolbars, top app bars, dialog and sheet headers, navigation bars and rails, tabs,
          pagination and snackbars. If a rule
          gives a button a smaller <code>height</code>, set
          <code>min-height</code> too, or set
          <code>--md-comp-filled-button-container-height</code> instead.
        </p>
        <p>
          <button type="button">Create</button>
          <button type="button"><span class="material-symbols" aria-hidden="true">add</span><span>Create</span></button>
          <button type="button"><span>Send</span><span class="material-symbols" aria-hidden="true">send</span></button>
          <button type="button" class="circle" aria-label="Add"><span class="material-symbols" aria-hidden="true">add</span></button>
        </p>
<Code code={`
<button>Create</button>
<button>
  <span class="material-symbols" aria-hidden="true">add</span><span>Create</span>
</button>
<button>
  <span>Send</span><span class="material-symbols" aria-hidden="true">send</span>
</button>
<button class="circle" aria-label="Add">
  <span class="material-symbols" aria-hidden="true">add</span>
</button>

<a class="button" href="/docs">Link</a>
`} />
  </Section>
  <Section {...S.filled}>
        <p>
          Filled is the default, high-emphasis style, for the main action on a page.
          The container is <code>primary</code>, the label is
          <code>on-primary</code>, and there is no elevation. It also has its
          own class, <code>filled</code>, so all five styles have a name.
          Adding it changes nothing.
        </p>
        <p>
          <button type="button">Create</button>
          <button type="button" class="filled">Create</button>
          <button type="button"><span class="material-symbols" aria-hidden="true">add</span><span>Create</span></button>
          <a class="button" href="#!">Link</a>
        </p>
<Code code={`
<button>Create</button>
<button class="filled">Create</button>
<button>
  <span class="material-symbols" aria-hidden="true">add</span><span>Create</span>
</button>
<a class="button" href="/docs">Link</a>
`} />
  </Section>
  <Section {...S["filled-tonal"]}>
        <p>
          Add <code>tonal</code> for medium emphasis. The container is
          <code>secondary-container</code> and the label is
          <code>on-secondary-container</code>.
        </p>
        <p>
          <button type="button" class="tonal">Create</button>
          <button type="button" class="tonal"><span class="material-symbols" aria-hidden="true">add</span><span>Create</span></button>
        </p>
<Code code={`
<button class="tonal">Create</button>
<button class="tonal">
  <span class="material-symbols" aria-hidden="true">add</span><span>Create</span>
</button>
`} />
  </Section>
  <Section {...S.outlined}>
        <p>
          Add <code>outlined</code> (or <code>border</code>) for medium
          emphasis with no fill. The outline is <code>outline</code> and the
          label is <code>primary</code>.
        </p>
        <p>
          <button type="button" class="outlined">Create</button>
          <button type="button" class="outlined"><span class="material-symbols" aria-hidden="true">add</span><span>Create</span></button>
        </p>
<Code code={`
<button class="outlined">Create</button>
`} />
  </Section>
  <Section {...S.elevated}>
        <p>
          Add <code>elevated</code> for medium emphasis with a shadow. The container is
          <code>surface</code> and the label is <code>primary</code>, with
          elevation 1 at rest and 2 on hover. Use it sparingly so the page
          does not fill with shadows.
        </p>
        <p>
          <button type="button" class="elevated">Create</button>
          <button type="button" class="elevated"><span class="material-symbols" aria-hidden="true">add</span><span>Create</span></button>
        </p>
<Code code={`
<button class="elevated">Create</button>
`} />
  </Section>
  <Section {...S.text}>
        <p>
          Add <code>text</code> for low emphasis. It has no container, and the
          label is <code>primary</code>. Use text buttons inside cards and
          dialogs so they do not stack shadows.
        </p>
        <p>
          <button type="button" class="text">Create</button>
          <button type="button" class="text"><span class="material-symbols" aria-hidden="true">add</span><span>Create</span></button>
        </p>
<Code code={`
<button class="text">Create</button>
`} />
  </Section>
  <Section {...S.icon}>
        <p>
          <a href={route('icon_buttons')}><code>.icon-button</code></a> is its
          own component. <code>circle</code> on a common button is the older
          round common-button form and still works. It follows the size
          scale, 40dp by default. The variant helpers still apply. The
          default is filled, <code>text</code> gives the standard
          (transparent) icon button, and <code>tonal</code> and
          <code>outlined</code> match the common-button colors.
        </p>
        <p>
          <button type="button" class="circle" aria-label="Add"><span class="material-symbols" aria-hidden="true">add</span></button>
          <button type="button" class="circle tonal" aria-label="Add"><span class="material-symbols" aria-hidden="true">add</span></button>
          <button type="button" class="circle outlined" aria-label="Add"><span class="material-symbols" aria-hidden="true">add</span></button>
          <button type="button" class="circle text" aria-label="Add"><span class="material-symbols" aria-hidden="true">add</span></button>
        </p>
<Code code={`
<button class="circle" aria-label="Add">
  <span class="material-symbols" aria-hidden="true">add</span>
</button>
<button class="circle tonal" aria-label="Add">…</button>
<button class="circle outlined" aria-label="Add">…</button>
<button class="circle text" aria-label="Add">…</button>
`} />
  </Section>
  <Section {...S.floating}>
        <p>
          For a FAB, use <code>circle extra</code> or <code>circle large</code>.
          It is 56dp with 16dp corners, <code>primary-container</code> and elevation 3.
          <code>extra circle medium</code> is the 80dp medium one (20dp
          corners, 26dp icon), and <code>extra circle large</code> is the 96dp
          large one (28dp corners, 36dp icon). The large size needs the
          <code>extra</code>, because <code>circle large</code> on its own is the
          alias for the default 56dp FAB.
        </p>
        <p>
          Use <code>extend small</code> for the extended FAB, an icon and a
          label at 56dp, with 16dp corners and 8dp between the two. It takes the
          three explicit sizes. <code>extend small</code> is 56dp on a
          symmetric 16dp inset, <code>extend medium</code> is 80dp (20dp
          corners, 28dp icon) and <code>extend large</code> is 96dp (28dp
          corners, 36dp icon). Each uses the label role Material gives it.
          Its container colour is also a role. Adding
          <code>secondary-container</code> or
          <code>tertiary-container</code> recolours the label and the state
          layers to match. See <a href={`${route('floating_action_button')}#extended`}>the FAB page</a>
          for the whole axis.
        </p>
        <p>
          <button type="button" class="circle extra" aria-label="Add"><span class="material-symbols" aria-hidden="true">add</span></button>
          <button type="button" class="circle extra medium" aria-label="Add"><span class="material-symbols" aria-hidden="true">add</span></button>
          <button type="button" class="circle extra large" aria-label="Add"><span class="material-symbols" aria-hidden="true">add</span></button>
          <button type="button" class="extend small"><span class="material-symbols" aria-hidden="true">add</span><span>Create</span></button>
          <button type="button" class="extend medium"><span class="material-symbols" aria-hidden="true">add</span><span>Create</span></button>
          <button type="button" class="extend large secondary-container"><span class="material-symbols" aria-hidden="true">add</span><span>Create</span></button>
        </p>
<Code code={`
<button class="circle extra" aria-label="Add">
  <span class="material-symbols" aria-hidden="true">add</span>
</button>
<button class="circle extra medium" aria-label="Add">
  <span class="material-symbols" aria-hidden="true">add</span>
</button>
<button class="circle extra large" aria-label="Add">
  <span class="material-symbols" aria-hidden="true">add</span>
</button>
<button class="extend small">
  <span class="material-symbols" aria-hidden="true">add</span><span>Create</span>
</button>
<button class="extend medium">
  <span class="material-symbols" aria-hidden="true">add</span><span>Create</span>
</button>
<button class="extend large secondary-container">
  <span class="material-symbols" aria-hidden="true">add</span><span>Create</span>
</button>
`} />
  </Section>
  <Section {...S.sizes}>
        <p>
          Buttons come in five sizes. <code>small</code> is the default at 40dp with a 20dp
          icon, so it needs no class. The rest are
          <code>xsmall</code> (32dp, 20dp icon),
          <code>medium</code> (56dp, 24dp, <code>title-medium</code> label),
          <code>large</code> (96dp, 32dp, <code>headline-small</code>) and
          <code>xlarge</code> (136dp, 40dp, <code>headline-large</code>).
          The inset and the icon gap grow with the size, and an
          <code>outlined</code> button's border thickens with it:
          1dp up to medium, 2dp at large and 3dp at extra large.
          <code>circle</code> follows the
          same size scale. A round common button takes both the box
          <em>and</em> the icon size of its step, 40dp with a 20dp icon by
          default and 136dp with a 40dp icon at <code>xlarge</code>. Only
          <code>circle extra</code> and <code>circle large</code> leave this
          scale, because they are FAB sizes with a scale of their own. For the
          icon <em>button</em>'s numbers, 40dp with a 24dp icon, use
          <a href={route('icon_buttons')}><code>.icon-button</code></a>.
        </p>
        <p>
          <button type="button" class="xsmall">Extra small</button>
          <button type="button">Small</button>
          <button type="button" class="medium">Medium</button>
        </p>
        <p>
          <button type="button" class="large">Large</button>
        </p>
        <p>
          <button type="button" class="xlarge">Extra large</button>
        </p>
<Code code={`
<button class="xsmall">Extra small</button>
<button>Small</button>
<button class="medium">Medium</button>
<button class="large">Large</button>
<button class="xlarge">Extra large</button>
`} />
        <p>
          Write the two axes side by side. There is no per-combination
          class, so any style works with any size.
        </p>
        <p>
          <button type="button" class="tonal medium">Tonal medium</button>
          <button type="button" class="outlined xsmall">Outlined extra small</button>
          <button type="button" class="text medium">Text medium</button>
        </p>
<Code code={`
<button class="tonal medium">Tonal medium</button>
<button class="outlined xsmall">Outlined extra small</button>
<button class="text medium">Text medium</button>
`} />
        <p>
          For a form submit, use a real <code>&lt;button type="submit"&gt;</code>
          rather than an input.
        </p>
        <p>
          <button type="submit"><span>Submit</span><span class="material-symbols" aria-hidden="true">send</span></button>
        </p>
<Code code={`
<button type="submit">
  <span>Submit</span><span class="material-symbols" aria-hidden="true">send</span>
</button>
`} />
  </Section>
  <Section {...S.shape}>
        <p>
          Buttons are round. Add <code>square</code> for the squared corner
          of the size: 12dp up to small, 16dp at medium and 28dp at large and
          extra large. When pressed, every common button morphs its corners to the
          pressed shape of its size (8dp up to small, 12dp at medium and 16dp
          beyond) and springs back on release.
        </p>
        <p>
          <button type="button">Round</button>
          <button type="button" class="square">Square</button>
          <button type="button" class="tonal square medium">Square medium</button>
        </p>
<Code code={`
<button>Round</button>
<button class="square">Square</button>
<button class="tonal square medium">Square medium</button>
`} />
        <p>
          Add <code>aria-pressed</code> to make a button a toggle. When selected, a round
          button goes square and a square one goes round, so the cue does not
          rely on colour alone. The colours change too: filled from
          surface-container to primary, tonal from secondary-container to
          secondary, outlined to inverse-surface without its outline, and
          elevated to primary. Text buttons do not toggle. Switch
          <code>aria-pressed</code> in your click handler. For a set of
          toggles that share a row, use a
          <a href={route('button_groups')}>button group</a>.
        </p>
        <p>
          <button type="button" aria-pressed="false">Filled</button>
          <button type="button" aria-pressed="true">Filled</button>
          <button type="button" class="tonal" aria-pressed="true">Tonal</button>
          <button type="button" class="outlined" aria-pressed="true">Outlined</button>
          <button type="button" class="elevated square" aria-pressed="true">Elevated square</button>
        </p>
<Code code={`
<button type="button" aria-pressed="false">Filled</button>
<button type="button" aria-pressed="true">Filled</button>
<button type="button" class="tonal" aria-pressed="true">Tonal</button>
<button type="button" class="outlined" aria-pressed="true">Outlined</button>
<button type="button" class="elevated square" aria-pressed="true">Elevated square</button>
`} />
  </Section>
  <Section {...S.disabled}>
        <p>
          Use the <code>disabled</code> attribute, or the
          <code>disabled</code> class on a link. It applies to every variant.
        </p>
        <p>
          <button type="button" disabled>Filled</button>
          <button type="button" class="tonal" disabled>Tonal</button>
          <button type="button" class="outlined" disabled>Outlined</button>
          <button type="button" class="text" disabled>Text</button>
          <button type="button" class="circle extra" disabled aria-label="Add"><span class="material-symbols" aria-hidden="true">add</span></button>
        </p>
<Code code={`
<button disabled>Filled</button>
<button class="tonal" disabled>Tonal</button>
<a class="button disabled">Link</a>
`} />
  </Section>
</PageBody>
</DocsLayout>
