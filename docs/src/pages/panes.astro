---
import DocsLayout from "../layouts/DocsLayout.astro";
import PageBody from "../components/PageBody.astro";
import Section from "../components/Section.astro";
import Code from "../components/Code.astro";
import TokenTable from "../components/api/TokenTable.astro";
import { defineSections } from "../lib/sections";
import { route } from "../lib/catalogue";

const S = defineSections([
  { id: "anatomy", label: "Anatomy", heading: false },
  { id: "list-detail", label: "List-detail" },
  { id: "compact", label: "Compact" },
  { id: "supporting", label: "Supporting pane" },
  { id: "equal", label: "Equal" },
  { id: "three-pane", label: "Three-pane" },
  { id: "resizing", label: "Resizing" },
  { id: "appearance", label: "Appearance" },
  { id: "pane", label: "A pane" },
  { id: "tokens", label: "Tokens" },
]);
---
<DocsLayout page="panes">
<PageBody sections={S} wide>

  <Section {...S.anatomy}>
      <p class="flow-text">
        A <code>.panes</code> (or <code>.pane-layout</code>, or
        <code>.list-detail</code>) is the container. Two or three
        <code>.pane</code> children are the surfaces. The component has no
        JavaScript, so the HTML structure sets the layout.
      </p>
      <p>
        Tokens follow the
        <a href="https://m3.material.io/foundations/layout/canonical-layouts">M3 canonical layouts</a>.
        Coplanar is the default, with full-bleed surfaces and a 1dp
        <code>outline-variant</code> divider. Compact widths add 16dp inline
        margins. Every wider layout uses 24dp margins and 24dp spacers. Give
        the container a height. It is <code>height: 100%</code>.
      </p>
      <p>
        The split is at 840px, measured against the nearest ancestor with
        inline-size or size containment. Without one, viewport media rules
        apply. To adapt a nested layout, put
        <code>container-type: inline-size</code> on the containing column.
        Below the split, one pane shows at a time. Google recommends stacking
        supporting content below primary content on compact and medium
        layouts. This component's one-active-pane behavior is a framework
        adaptation.
      </p>
      <p>
        Semantic child names are aliases of <code>.pane</code>:
        <code>.list-pane</code>, <code>.detail-pane</code>,
        <code>.primary-pane</code>, <code>.supporting-pane</code>.
        Mark the visible pane on compact windows with
        <code>active</code>. For optional content that should overlay the
        page, use a
        <a href={route('side_sheet')}>side sheet</a>, not a pane.
      </p>
  </Section>
  <Section {...S["list-detail"]}>
      <p>
        Use <code>.list-detail</code> or a plain <code>.panes</code> for the
        default layout, a 360dp list pane beside a flexible detail pane.
        When people pick a row, the detail pane shows that item.
        Pair the list pane with a
        <a href={route('lists')}>list</a>.
      </p>
      <div id="pane-column" style="container-type: inline-size; width: 100%;">
      <div class="list-detail panes-demo" data-pane-select>
        <section class="list-pane">
          <header>
            <h2>Inbox</h2>
            <button type="button" aria-label="Search">
              <span class="material-symbols" aria-hidden="true">search</span>
            </button>
          </header>
          <ul class="list">
            <li>
              <a href="#!" aria-current="page" data-title="Brunch this weekend?" data-body="I will be in your neighborhood doing errands this weekend. Want to grab brunch on Saturday?">
                <span class="material-symbols" aria-hidden="true">mail</span>
                Brunch this weekend?
                <p>Ali Connors — I will be in your neighborhood doing errands.</p>
              </a>
            </li>
            <li>
              <a href="#!" data-title="Summer BBQ" data-body="Wish I could come, but I have a prior engagement. Maybe next time?">
                <span class="material-symbols" aria-hidden="true">mail</span>
                Summer BBQ
                <p>Tori Text — Wish I could come, but I am out of town.</p>
              </a>
            </li>
            <li>
              <a href="#!" data-title="Birthday gift" data-body="Have any ideas about what we should get Heidi for her birthday?">
                <span class="material-symbols" aria-hidden="true">star</span>
                Birthday gift
                <p>Sandra Adams — Have any ideas about what we should get Heidi?</p>
              </a>
            </li>
            <li>
              <a href="#!" data-title="Recipe to try" data-body="We should eat this: grated squash, corn, and tomatillo salsa.">
                <span class="material-symbols" aria-hidden="true">mail</span>
                Recipe to try
                <p>Craig Gaskell — We should eat this: grated squash and corn.</p>
              </a>
            </li>
          </ul>
        </section>
        <section class="detail-pane">
          <header>
            <button type="button" aria-label="Back" data-pane-back>
              <span class="material-symbols" aria-hidden="true">arrow_back</span>
            </button>
            <h2>Brunch this weekend?</h2>
            <button type="button" aria-label="More">
              <span class="material-symbols" aria-hidden="true">more_vert</span>
            </button>
          </header>
          <div>
            <p data-pane-body>I will be in your neighborhood doing errands this weekend. Want to grab brunch on Saturday?</p>
          </div>
          <footer>
            <button type="button" class="text">Reply</button>
            <button type="button" class="text">Forward</button>
          </footer>
        </section>
      </div>
      </div>
<Code code={`
<div style="container-type: inline-size">
<div class="list-detail">
  <section class="list-pane">
    <header>
      <h2>Inbox</h2>
    </header>
    <ul class="list">…</ul>
  </section>
  <section class="detail-pane">
    <header>
      <h2>Subject</h2>
    </header>
    <div>…</div>
  </section>
</div>
</div>
`} />
  </Section>
  <Section {...S.compact}>
      <p>
        At Compact widths (below 600px), the layout has 16dp inline
        margins. Medium, Expanded, Large, and Extra-large widths use
        24dp inline margins and 24dp spacers. On Compact and Medium
        widths (below 840px), every pane is hidden except the
        <code>active</code> one. If none is active, the first pane shows.
      </p>
      <p>
        <code>AutoInit()</code> does not start panes, so toggle
        <code>active</code> yourself when the user picks a row or taps back.
        At Expanded widths both panes show regardless of
        <code>active</code>, so the same markup works at every size.
      </p>
      <p>
        The illustration below always shows one pane so you can see the
        swap. Change the width of <code>#pane-column</code> in developer
        tools to test the list-detail demo above without resizing the viewport.
        Its nearest containing column controls the split.
      </p>
      <div class="list-detail panes-demo compact" data-pane-select>
        <section class="list-pane active">
          <header>
            <h2>Inbox</h2>
          </header>
          <ul class="list">
            <li>
              <a href="#!" aria-current="page" data-title="Brunch this weekend?" data-body="I will be in your neighborhood doing errands this weekend. Want to grab brunch on Saturday?">
                <span class="material-symbols" aria-hidden="true">mail</span>
                Brunch this weekend?
                <p>Ali Connors — I will be in your neighborhood doing errands.</p>
              </a>
            </li>
            <li>
              <a href="#!" data-title="Summer BBQ" data-body="Wish I could come, but I have a prior engagement. Maybe next time?">
                <span class="material-symbols" aria-hidden="true">mail</span>
                Summer BBQ
                <p>Tori Text — Wish I could come, but I am out of town.</p>
              </a>
            </li>
            <li>
              <a href="#!" data-title="Birthday gift" data-body="Have any ideas about what we should get Heidi for her birthday?">
                <span class="material-symbols" aria-hidden="true">star</span>
                Birthday gift
                <p>Sandra Adams — Have any ideas about what we should get Heidi?</p>
              </a>
            </li>
          </ul>
        </section>
        <section class="detail-pane">
          <header>
            <button type="button" aria-label="Back" data-pane-back>
              <span class="material-symbols" aria-hidden="true">arrow_back</span>
            </button>
            <h2>Brunch this weekend?</h2>
          </header>
          <div>
            <p data-pane-body>I will be in your neighborhood doing errands this weekend. Want to grab brunch on Saturday?</p>
          </div>
        </section>
      </div>
<Code code={`
list.querySelectorAll('a').forEach((row) => {
  row.addEventListener('click', (event) => {
    event.preventDefault();
    detailPane.classList.add('active');
    listPane.classList.remove('active');
  });
});

back.addEventListener('click', () => {
  detailPane.classList.remove('active');
  listPane.classList.add('active');
});
`} />
  </Section>
  <Section {...S.supporting}>
      <p>
        Add <code>supporting</code>, or use
        <code>.supporting-pane-layout</code>, to put a flexible primary pane
        next to a 360dp supporting pane on the trailing edge. Use it when the
        extra content is secondary and should stay in view beside the main
        content, such as a related list, an inspector or an outline.
      </p>
      <p>
        Add <code>start</code> (or <code>left</code>) to dock the supporting
        pane on the leading edge instead.
      </p>
      <div class="panes supporting panes-demo">
        <section class="primary-pane">
          <header>
            <h2>Article</h2>
            <button type="button" aria-label="More">
              <span class="material-symbols" aria-hidden="true">more_vert</span>
            </button>
          </header>
          <div>
            <p>
              The primary pane holds the focus of the screen. Supporting
              content sits beside it on expanded windows and hides on
              compact ones until you mark it <code>active</code>.
            </p>
            <p>
              A supporting pane is in the page flow. A
              <a href={route('side_sheet')}>side sheet</a>
              overlays the page and can be dismissed.
            </p>
          </div>
        </section>
        <section class="supporting-pane">
          <header>
            <h2>Contents</h2>
          </header>
          <ul class="list">
            <li>
              <a href="#!">
                <span class="material-symbols" aria-hidden="true">notes</span>
                Outline
              </a>
            </li>
            <li>
              <a href="#!" aria-current="page">
                <span class="material-symbols" aria-hidden="true">link</span>
                Related
              </a>
            </li>
            <li>
              <a href="#!" aria-label="Comments, 3 unread">
                <span class="material-symbols" aria-hidden="true">comment<span class="badge">3</span></span>
                Comments
              </a>
            </li>
          </ul>
        </section>
      </div>
<Code code={`
<div class="panes supporting">
  <section class="primary-pane">…</section>
  <section class="supporting-pane">…</section>
</div>

<div class="panes supporting start">…</div>
`} />
  </Section>
  <Section {...S.equal}>
      <p>
        Add <code>equal</code> to split two panes 1fr / 1fr. Use it when the
        two surfaces have the same weight, such as two documents, a diff,
        or an editor and a preview.
      </p>
      <div class="panes equal panes-demo">
        <section class="pane">
          <header>
            <h2>Draft</h2>
          </header>
          <div>
            <p>Write in this pane. Both columns grow equally once the applicable container or viewport is at least 840px wide.</p>
          </div>
        </section>
        <section class="pane">
          <header>
            <h2>Preview</h2>
          </header>
          <div>
            <p>The preview stays in lockstep with the draft. Neither pane is the list; neither is supporting.</p>
          </div>
        </section>
      </div>
<Code code={`
<div class="panes equal">
  <section class="pane">…</section>
  <section class="pane">…</section>
</div>
`} />
  </Section>
  <Section {...S["three-pane"]}>
      <p>
        Add <code>three-pane</code> for a list, a main pane and a supporting
        pane. It needs 1200px of container width, or of viewport width
        without a query container. The columns are a 360dp list, a flexible
        middle and a 360dp supporting pane.
        Between 840px and 1200px the default two-column list-detail
        grid still applies, so the third pane wraps. Below 840px it
        uses the same single-pane <code>active</code> pattern as the
        others.
      </p>
      <div class="panes three-pane panes-demo">
        <section class="list-pane">
          <header>
            <h2>Mail</h2>
          </header>
          <ul class="list">
            <li>
              <a href="#!" aria-current="page">
                <span class="material-symbols" aria-hidden="true">mail</span>
                Brunch this weekend?
              </a>
            </li>
            <li>
              <a href="#!">
                <span class="material-symbols" aria-hidden="true">mail</span>
                Summer BBQ
              </a>
            </li>
            <li>
              <a href="#!">
                <span class="material-symbols" aria-hidden="true">star</span>
                Birthday gift
              </a>
            </li>
          </ul>
        </section>
        <section class="detail-pane">
          <header>
            <h2>Brunch this weekend?</h2>
          </header>
          <div>
            <p>I will be in your neighborhood doing errands this weekend. Want to grab brunch on Saturday?</p>
          </div>
        </section>
        <section class="supporting-pane">
          <header>
            <h2>Details</h2>
          </header>
          <ul class="list">
            <li>
              <span class="material-symbols" aria-hidden="true">person</span>
              Ali Connors
              <p>From</p>
            </li>
            <li>
              <span class="material-symbols" aria-hidden="true">schedule</span>
              Sat, 10:00
              <p>When</p>
            </li>
          </ul>
        </section>
      </div>
<Code code={`
<div class="panes three-pane">
  <section class="list-pane">…</section>
  <section class="detail-pane">…</section>
  <section class="supporting-pane">…</section>
</div>
`} />
  </Section>
  <Section {...S.resizing}>
      <p>
        Write a <code>&lt;button class="drag-handle"&gt;</code> between the
        two panes of a list-detail or supporting layout to let people resize
        them at 840px and up. The handle replaces the spacer and the divider,
        and resizes the list or supporting pane.
      </p>
      <p>
        People can drag the handle. <kbd>Left</kbd> or <kbd>Right</kbd>
        moves it 16px (<kbd>Shift</kbd> for 64px), and <kbd>Home</kbd> or
        <kbd>End</kbd> moves it to the narrowest or widest. Clicking it, or
        pressing <kbd>Enter</kbd>, steps through narrow, middle and wide.
        The click is the single-pointer alternative to dragging. A resized
        pane stays at least 240px wide, and the other pane keeps
        <code>--md-comp-pane-primary-min-width</code>.
      </p>
      <p>
        The handle writes the new width to <code>--md-comp-pane-list-width</code>
        or <code>--md-comp-pane-supporting-width</code> on the layout. Save
        that value to restore it later. The root bundle starts the
        <code>PaneResize</code> behavior on load. With the modular entry,
        call <code>PaneResize.Init()</code>. Equal and three-pane layouts
        do not resize.
      </p>
      <p>
        From script, <code>Expressive.PaneResize.width(handle)</code> returns
        the resizable pane's current width in pixels, or <code>null</code>
        when the handle is not in a layout that resizes.
        <code>Expressive.PaneResize.setWidth(handle, width)</code> sets it
        within the same bounds as dragging. Use it to restore a saved width.
      </p>
<Code code={`
<div class="panes list-detail">
  <div class="list-pane">…</div>
  <button type="button" class="drag-handle" aria-label="Resize list"></button>
  <div class="detail-pane">…</div>
</div>
`} />
  </Section>
  <Section {...S.appearance}>
      <p>
        Coplanar is the default. The panes share one surface, with a
        1dp divider on expanded windows. Add <code>separated</code> (or
        <code>floating</code>) to inset the panes 24dp, round them to
        16dp, and fill each with
        <code>surface-container-low</code>.
      </p>
      <p>
        On a separated pane, add <code>elevated</code> for elevation 1.
        Add <code>outlined</code> to switch the fill to <code>surface</code>
        and draw a 1dp outline.
      </p>
      <div class="panes equal separated panes-demo">
        <section class="pane outlined">
          <header>
            <h2>Outlined</h2>
          </header>
          <div>
            <p>Surface, 1dp outline-variant stroke, no elevation.</p>
          </div>
        </section>
        <section class="pane elevated">
          <header>
            <h2>Elevated</h2>
          </header>
          <div>
            <p>Surface-container-low at elevation 1.</p>
          </div>
        </section>
      </div>
<Code code={`
<div class="panes equal separated">
  <section class="pane outlined">…</section>
  <section class="pane elevated">…</section>
</div>
`} />
  </Section>
  <Section {...S.pane}>
      <p>
        Each pane is a column. A child <code>&lt;header&gt;</code>
        (or <code>.pane-header</code>) is the 64dp top bar: icon-only
        buttons, then a <code>title-large</code> heading. A child
        <code>&lt;main&gt;</code>, <code>.pane-content</code>,
        <code>.pane-body</code>, or <code>&lt;div&gt;</code> is the
        scrolling body. A last-child <code>&lt;footer&gt;</code>,
        <code>.pane-footer</code>, or <code>&lt;nav&gt;</code> is the
        56dp action bar.
      </p>
      <p>
        A direct <code>.list</code> fills the pane with no extra
        padding, so list rows can run edge to edge under the header.
      </p>
<Code code={`
<section class="pane">
  <header>
    <button type="button" aria-label="Back">
      <span class="material-symbols" aria-hidden="true">arrow_back</span>
    </button>
    <h2>Headline</h2>
    <button type="button" aria-label="More">
      <span class="material-symbols" aria-hidden="true">more_vert</span>
    </button>
  </header>
  <div>…</div>
  <footer>
    <button type="button" class="text">Action</button>
  </footer>
</section>
`} />
  </Section>
  <Section {...S.tokens}>
      <TokenTable>
          <tr>
            <td><code>--md-comp-pane-margin</code></td>
            <td>16px Compact; 24px Medium and wider</td>
          </tr>
          <tr><td><code>--md-comp-pane-gap</code></td><td>24px</td></tr>
          <tr><td><code>--md-comp-pane-divider-color</code></td><td>outline-variant</td></tr>
          <tr><td><code>--md-comp-pane-container-color</code></td><td>surface</td></tr>
          <tr><td><code>--md-comp-pane-container-shape</code></td><td>0px (16px separated)</td></tr>
          <tr><td><code>--md-comp-pane-list-width</code></td><td>360px</td></tr>
          <tr><td><code>--md-comp-pane-supporting-width</code></td><td>360px</td></tr>
      </TokenTable>
  </Section>
</PageBody>
<script is:inline>
  document.querySelectorAll('[data-pane-select]').forEach((root) => {
    const listPane = root.querySelector('.list-pane');
    const detailPane = root.querySelector('.detail-pane');
    const title = detailPane && detailPane.querySelector('header :is(h1, h2, h3, h4, h5, h6, .pane-title)');
    const body = detailPane && detailPane.querySelector('[data-pane-body]');
    root.querySelectorAll('.list a').forEach((link) => {
      link.addEventListener('click', (event) => {
        event.preventDefault();
        root.querySelectorAll('.list a[aria-current]').forEach((el) => {
          el.removeAttribute('aria-current');
        });
        link.setAttribute('aria-current', 'page');
        if (title && link.dataset.title) title.textContent = link.dataset.title;
        if (body && link.dataset.body) body.textContent = link.dataset.body;
        if (detailPane) detailPane.classList.add('active');
        if (listPane) listPane.classList.remove('active');
      });
    });
    const back = root.querySelector('[data-pane-back]');
    if (back && detailPane && listPane) {
      back.addEventListener('click', () => {
        detailPane.classList.remove('active');
        listPane.classList.add('active');
      });
    }
  });
</script>
</DocsLayout>
