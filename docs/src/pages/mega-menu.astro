---
import DocsLayout from "../layouts/DocsLayout.astro";
import PageBody from "../components/PageBody.astro";
import Section from "../components/Section.astro";
import Code from "../components/Code.astro";
import TokenTable from "../components/api/TokenTable.astro";
import { defineSections } from "../lib/sections";
import { route } from "../lib/catalogue";

const S = defineSections([
  { id: "anatomy", label: "Anatomy", heading: false },
  { id: "tokens", label: "Tokens" },
]);
---
<DocsLayout page="mega_menu">
<PageBody sections={S}>
  <Section {...S.anatomy}>
        <p class="flow-text">
          A <code>nav.mega-menu</code> is site navigation whose top items open
          wide panels of grouped links.
        </p>
        <p>
          Make the top items links and <code>&lt;button&gt;</code>s. Point
          each button at a <code>.mega-menu-panel</code> with
          <code>popovertarget</code>. The panel is then a native popover, and
          the browser does the work without JavaScript. It opens the panel,
          closes it on Escape or an outside click, and puts it next in the Tab
          order. It also tells assistive technology whether the panel is
          expanded.
        </p>
        <p>
          The panel opens below the bar and spans the window. It lays its
          <code>&lt;section&gt;</code> groups out in as many columns as fit.
          For application commands, use a
          <a href={route("menubar")}>menubar</a> instead.
        </p>
        <nav class="mega-menu" aria-label="Demo">
  <a href="#" aria-current="page">Home</a>
  <button type="button" popovertarget="demo-products">Products</button>
  <div id="demo-products" class="mega-menu-panel" popover>
    <section>
      <h2>Build</h2>
      <ul>
        <li><a href="#editor">Editor<small>Write and preview</small></a></li>
        <li><a href="#api">API</a></li>
      </ul>
    </section>
    <section>
      <h2>Ship</h2>
      <ul>
        <li><a href="#deploy">Deploy</a></li>
      </ul>
    </section>
  </div>
  <a href="#pricing">Pricing</a>
</nav>
<Code code={`
<nav class="mega-menu" aria-label="Main">
  <a href="/" aria-current="page">Home</a>
  <button type="button" popovertarget="products">Products</button>
  <div id="products" class="mega-menu-panel" popover>
    <section>
      <h2>Build</h2>
      <ul>
        <li><a href="/editor">Editor<small>Write and preview</small></a></li>
        <li><a href="/api">API</a></li>
      </ul>
    </section>
    <section>
      <h2>Ship</h2>
      <ul>
        <li><a href="/deploy">Deploy</a></li>
      </ul>
    </section>
  </div>
  <a href="/pricing">Pricing</a>
</nav>
`} />
  </Section>
  <Section {...S.tokens}>
        <TokenTable>
          <tr>
            <td><code>--md-comp-mega-menu-container-color</code></td>
            <td><code>--md-sys-color-surface-container</code></td>
          </tr>
          <tr>
            <td><code>--md-comp-mega-menu-shape</code></td>
            <td>16px</td>
          </tr>
          <tr>
            <td><code>--md-comp-mega-menu-margin</code></td>
            <td>16px (panel inset from the window)</td>
          </tr>
          <tr>
            <td><code>--md-comp-mega-menu-column-width</code></td>
            <td>200px (minimum)</td>
          </tr>
        </TokenTable>
  </Section>
</PageBody>
</DocsLayout>
