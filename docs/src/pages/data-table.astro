              <tr><th scope="row">Alvin</th><td>Shipped</td><td>us-east</td><td class="numeric">$87.00</td></tr>
              <tr><th scope="row">Jonathan</th><td>Shipped</td><td>ap-south</td><td class="numeric">$142.50</td></tr>
            </tbody>
          </table>
        </div>
        <menu id="visibility-columns">
          <li role="menuitemcheckbox" aria-checked="true" data-column="visibility-status"><button type="button">Status</button></li>
          <li role="menuitemcheckbox" aria-checked="false" data-column="visibility-total"><button type="button">Total</button></li>
        </menu>
