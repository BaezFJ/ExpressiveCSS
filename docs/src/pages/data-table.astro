---
import DocsLayout from "../layouts/DocsLayout.astro";
import Section from "../components/Section.astro";
import Code from "../components/Code.astro";
import TokenTable from "../components/api/TokenTable.astro";
import { defineSections } from "../lib/sections";
import { route } from "../lib/catalogue";

const S = defineSections([
  { id: "anatomy", label: "Anatomy", heading: false },
  { id: "sorting", label: "Sorting" },
  { id: "selection", label: "Row selection" },
  { id: "bulk-actions", label: "Bulk actions" },
  { id: "expansion", label: "Row expansion" },
  { id: "scrolling", label: "Scrolling" },
  { id: "sticky-column", label: "Sticky first column" },
  { id: "dense", label: "Dense" },
  { id: "tokens", label: "Tokens" },
]);
---
<DocsLayout page="data_table" sections={S}>
  <Section {...S.anatomy}>
        <p class="flow-text">
          Wrap one native <code>&lt;table&gt;</code> in a
          <code>&lt;div class="data-table"&gt;</code>. The wrapper scrolls and
          draws the outline, so the table keeps its table semantics.
        </p>
        <p>
          Add <code>numeric</code> to the header and body cells of a number
          column to align them on the end edge with tabular figures. For a
          plain table of a few rows, the <a href={route('table')}>table
          styles</a> are enough.
        </p>
        <div class="data-table">
          <table>
            <caption>Orders</caption>
            <thead>
              <tr>
                <th scope="col">Customer</th>
                <th scope="col">Status</th>
                <th scope="col" class="numeric">Items</th>
                <th scope="col" class="numeric">Total</th>
              </tr>
            </thead>
            <tbody>
              <tr><th scope="row">Alvin</th><td>Shipped</td><td class="numeric">3</td><td class="numeric">$87.00</td></tr>
              <tr><th scope="row">Alan</th><td>Delivered</td><td class="numeric">1</td><td class="numeric">$3.76</td></tr>
              <tr><th scope="row">Jonathan</th><td>Pending</td><td class="numeric">12</td><td class="numeric">$142.50</td></tr>
              <tr><th scope="row">Shannon</th><td>Shipped</td><td class="numeric">2</td><td class="numeric">$9.99</td></tr>
            </tbody>
          </table>
        </div>
<Code code={`
<div class="data-table">
  <table>
    <caption>Orders</caption>
    <thead>
      <tr>
        <th scope="col">Customer</th>
        <th scope="col">Status</th>
        <th scope="col" class="numeric">Total</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <th scope="row">Alvin</th>
        <td>Shipped</td>
        <td class="numeric">$87.00</td>
      </tr>
    </tbody>
  </table>
</div>
`} />
  </Section>
  <Section {...S.sorting}>
        <p>
          Put a <code>&lt;button&gt;</code> in each sortable header cell. Set
          <code>aria-sort="ascending"</code> or <code>"descending"</code> on the
          header of the sorted column, and the framework draws its arrow. Other
          sortable headers show a faint arrow on hover.
        </p>
        <p>
          Add <code>data-sort</code> to the wrapper to have the framework sort
          the rows too. Pressing a header button reorders the rows by that
          column and moves <code>aria-sort</code>. A <code>numeric</code> header
          compares numbers, so $1,200.00 sorts after $87.00. Other columns
          compare text in the page's language, with 9 before 10. A cell's
          <code>data-value</code> stands in for its text, and a detail row
          moves with its row.
        </p>
        <div class="data-table" data-sort>
          <table>
            <thead>
              <tr>
                <th scope="col" aria-sort="ascending"><button type="button">Customer</button></th>
                <th scope="col"><button type="button">Status</button></th>
                <th scope="col" class="numeric"><button type="button">Total</button></th>
              </tr>
            </thead>
            <tbody>
              <tr><th scope="row">Alan</th><td>Delivered</td><td class="numeric">$3.76</td></tr>
              <tr><th scope="row">Alvin</th><td>Shipped</td><td class="numeric">$87.00</td></tr>
              <tr><th scope="row">Jonathan</th><td>Pending</td><td class="numeric">$142.50</td></tr>
            </tbody>
          </table>
        </div>
<Code code={`
<thead>
  <tr>
    <th scope="col" aria-sort="ascending"><button type="button">Customer</button></th>
    <th scope="col"><button type="button">Status</button></th>
    <th scope="col" class="numeric"><button type="button">Total</button></th>
  </tr>
</thead>
`} />
<Code code={`
<div class="data-table" data-sort>
  <table>…</table>
</div>
`} />
        <p>
          Each press fires a cancelable <code>expressive:sort</code> from the
          wrapper, with <code>{"{ header, column, direction }"}</code>. A
          server-paged table cancels it and fetches the sorted page. By then,
          <code>aria-sort</code> has already moved. Without
          <code>data-sort</code>, the page handles the header buttons itself.
        </p>
<Code code={`
table.addEventListener('expressive:sort', (event) => {
  event.preventDefault();
  loadPage({ sort: event.detail.column, direction: event.detail.direction });
});
`} />
  </Section>
  <Section {...S.selection}>
        <p>
          Put a checkbox in a row's first cell. Checking it selects the row and
          fills it with <code>secondary-container</code>. Name each checkbox
          after its row. <code>aria-selected</code> is not valid on the rows of a
          plain table, so the checkbox carries the state.
        </p>
        <p>
          Put a checkbox in the first header cell to select every row. It
          shows mixed while only some rows are selected, and it skips disabled
          rows. Every change to the selection fires
          <code>expressive:change</code> from the wrapper with
          <code>{"{ selected }"}</code>, the selected rows. The page can use it
          to update a bulk action bar.
        </p>
        <div class="data-table">
          <table>
            <thead>
              <tr>
                <th scope="col"><label><input type="checkbox" aria-label="Select all orders"></label></th>
                <th scope="col">Customer</th>
                <th scope="col" class="numeric">Total</th>
              </tr>
            </thead>
            <tbody>
              <tr><td><label><input type="checkbox" checked aria-label="Select Alvin"></label></td><th scope="row">Alvin</th><td class="numeric">$87.00</td></tr>
              <tr><td><label><input type="checkbox" aria-label="Select Alan"></label></td><th scope="row">Alan</th><td class="numeric">$3.76</td></tr>
              <tr><td><label><input type="checkbox" aria-label="Select Jonathan"></label></td><th scope="row">Jonathan</th><td class="numeric">$142.50</td></tr>
            </tbody>
          </table>
        </div>
<Code code={`
<tr>
  <td><label><input type="checkbox" checked aria-label="Select Alvin"></label></td>
  <th scope="row">Alvin</th>
  <td class="numeric">$87.00</td>
</tr>
`} />
  </Section>
  <Section {...S["bulk-actions"]}>
        <p>
          Write a <code>.data-table-actions</code> bar just before the
          <code>.data-table</code>, and it joins the table's top edge. It takes
          the selected color while any row is selected. A leading label, such
          as a count, pushes the buttons to the end. The page keeps the count
          current and decides which buttons apply. Add <code>hidden</code> to
          remove the bar.
        </p>
<Code code={`
<div class="data-table-actions">
  <span>2 selected</span>
  <button type="button" class="button text">Archive</button>
  <button type="button" class="button text">Delete</button>
</div>
<div class="data-table">
  <table>…</table>
</div>
`} />
  </Section>
  <Section {...S.expansion}>
        <p>
          Put a <code>tr.data-table-detail</code> right after a row. It shows
          only while that row holds a button with
          <code>aria-expanded="true"</code>. The page flips the attribute, and
          the framework shows the row and turns the button's icon. Put the
          toggle in a <code>&lt;td&gt;</code>, because the framework draws a
          button in a <code>&lt;th&gt;</code> as a sort control. Give the
          detail cell a <code>colspan</code> across the table.
        </p>
<Code code={`
<tr>
  <th scope="row">Order 1042</th>
  <td class="numeric">$87.00</td>
  <td>
    <button type="button" class="icon-button" aria-expanded="false"
            aria-controls="order-1042" aria-label="Details for order 1042">
      <span class="material-symbols" aria-hidden="true">expand_more</span>
    </button>
  </td>
</tr>
<tr id="order-1042" class="data-table-detail">
  <td colspan="3">Two items, shipped Monday.</td>
</tr>
`} />
<Code code={`
toggle.addEventListener('click', () => {
  toggle.setAttribute('aria-expanded', String(toggle.getAttribute('aria-expanded') !== 'true'));
});
`} />
  </Section>
  <Section {...S.scrolling}>
        <p>
          Give a long table a <code>max-block-size</code>. Once the wrapper
          scrolls, the header row sticks to its top. A wrapper that scrolls
          must be reachable from the keyboard, so give it
          <code>tabindex="0"</code>, <code>role="region"</code> and a name,
          usually the caption.
        </p>
        <div class="data-table" tabindex="0" role="region" aria-labelledby="scroll-caption" style="max-block-size: 240px;">
          <table>
            <caption id="scroll-caption">Monthly visitors</caption>
            <thead>
              <tr><th scope="col">Month</th><th scope="col" class="numeric">Visitors</th><th scope="col" class="numeric">Change</th></tr>
            </thead>
            <tbody>
              <tr><th scope="row">January</th><td class="numeric">12,480</td><td class="numeric">+4%</td></tr>
              <tr><th scope="row">February</th><td class="numeric">11,902</td><td class="numeric">−5%</td></tr>
              <tr><th scope="row">March</th><td class="numeric">13,377</td><td class="numeric">+12%</td></tr>
              <tr><th scope="row">April</th><td class="numeric">13,015</td><td class="numeric">−3%</td></tr>
              <tr><th scope="row">May</th><td class="numeric">14,260</td><td class="numeric">+10%</td></tr>
              <tr><th scope="row">June</th><td class="numeric">15,104</td><td class="numeric">+6%</td></tr>
            </tbody>
          </table>
        </div>
<Code code={`
<div class="data-table" tabindex="0" role="region" aria-labelledby="visitors-caption"
     style="max-block-size: 240px">
  <table>
    <caption id="visitors-caption">Monthly visitors</caption>
    …
  </table>
</div>
`} />
  </Section>
  <Section {...S["sticky-column"]}>
        <p>
          Add <code>sticky-column</code> to the wrapper of a wide table to keep
          its first column in view while the other columns scroll sideways.
          When the first column holds row checkboxes, the name cell after it
          stays pinned too, and the checkbox column takes the fixed width of
          <code>--md-comp-data-table-checkbox-column-width</code>. Change that
          token, not the cell, if you restyle the checkbox column. Pinned cells
          keep their row's hover and selected colors, and a divider marks
          their edge.
        </p>
        <p>
          Give each row one cell in the pinned column: a first cell that spans
          several columns pins its whole width. Detail rows and the caption
          scroll with the table.
        </p>
        <div class="data-table sticky-column" tabindex="0" role="region" aria-labelledby="accounts-caption">
          <table style="min-inline-size: 960px;">
            <caption id="accounts-caption">Accounts</caption>
            <thead>
              <tr><th scope="col"><label><input type="checkbox" aria-label="Select all accounts"></label></th><th scope="col">Account</th><th scope="col">Plan</th><th scope="col" class="numeric">Seats</th><th scope="col">Region</th><th scope="col">Renews</th><th scope="col">Owner</th></tr>
            </thead>
            <tbody>
              <tr><td><label><input type="checkbox" aria-label="Select Northwind"></label></td><th scope="row">Northwind</th><td>Business</td><td class="numeric">120</td><td>eu-west</td><td>2027-03-01</td><td>Ada Lovelace</td></tr>
              <tr><td><label><input type="checkbox" aria-label="Select Contoso"></label></td><th scope="row">Contoso</th><td>Enterprise</td><td class="numeric">860</td><td>us-east</td><td>2026-12-15</td><td>Grace Hopper</td></tr>
              <tr><td><label><input type="checkbox" aria-label="Select Fabrikam"></label></td><th scope="row">Fabrikam</th><td>Team</td><td class="numeric">24</td><td>ap-south</td><td>2027-06-30</td><td>Edsger Dijkstra</td></tr>
            </tbody>
          </table>
        </div>
<Code code={`
<div class="data-table sticky-column" tabindex="0" role="region" aria-labelledby="accounts-caption">
  <table>
    <caption id="accounts-caption">Accounts</caption>
    <thead>
      <tr>
        <th scope="col"><label><input type="checkbox" aria-label="Select all accounts"></label></th>
        <th scope="col">Account</th>
        <th scope="col">Plan</th>
        …
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><label><input type="checkbox" aria-label="Select Northwind"></label></td>
        <th scope="row">Northwind</th>
        <td>Business</td>
        …
      </tr>
    </tbody>
  </table>
</div>
`} />
  </Section>
  <Section {...S.dense}>
        <p>
          Add <code>dense</code> to the wrapper to shorten rows to 40px and the
          header to 48px. Use it for tables people scan rather than read.
        </p>
        <div class="data-table dense">
          <table>
            <thead>
              <tr><th scope="col">Service</th><th scope="col">Region</th><th scope="col" class="numeric">Latency</th></tr>
            </thead>
            <tbody>
              <tr><th scope="row">api</th><td>eu-west</td><td class="numeric">42 ms</td></tr>
              <tr><th scope="row">auth</th><td>us-east</td><td class="numeric">18 ms</td></tr>
              <tr><th scope="row">search</th><td>ap-south</td><td class="numeric">97 ms</td></tr>
            </tbody>
          </table>
        </div>
<Code code={`
<div class="data-table dense">
  <table>…</table>
</div>
`} />
  </Section>
  <Section {...S.tokens}>
        <p>Override these on the <code>.data-table</code>.</p>
        <TokenTable>
          <tr>
            <td><code>--md-comp-data-table-container-color</code></td>
            <td><code>--md-sys-color-surface</code></td>
          </tr>
          <tr>
            <td><code>--md-comp-data-table-shape</code></td>
            <td>12px</td>
          </tr>
          <tr>
            <td><code>--md-comp-data-table-outline-color</code></td>
            <td><code>--md-sys-color-outline-variant</code></td>
          </tr>
          <tr>
            <td><code>--md-comp-data-table-header-height</code></td>
            <td>56px; <code>dense</code>: 48px</td>
          </tr>
          <tr>
            <td><code>--md-comp-data-table-row-height</code></td>
            <td>52px; <code>dense</code>: 40px</td>
          </tr>
          <tr>
            <td><code>--md-comp-data-table-cell-padding</code></td>
            <td>16px</td>
          </tr>
          <tr>
            <td><code>--md-comp-data-table-selected-container-color</code></td>
            <td><code>--md-sys-color-secondary-container</code></td>
          </tr>
          <tr>
            <td><code>--md-comp-data-table-detail-container-color</code></td>
            <td><code>--md-sys-color-surface-container-low</code></td>
          </tr>
          <tr>
            <td><code>--md-comp-data-table-checkbox-column-width</code></td>
            <td>Cell padding + 18px; used by <code>sticky-column</code></td>
          </tr>
        </TokenTable>
  </Section>
</DocsLayout>
