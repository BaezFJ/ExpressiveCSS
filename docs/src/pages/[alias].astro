---
import { aliases } from "../lib/catalogue";

/**
 * Every legacy route, from one page rather than a maintained page each.
 *
 * `build.format: 'file'` publishes the param `dropdown` at `/dropdown.html`,
 * which is the shape these URLs already have -- so the catalogue's `.html`
 * suffix is stripped here and put back by the build.
 */
export function getStaticPaths() {
  return aliases().map(({ from, to }) => ({
    params: { alias: from.replace(/^\//, "").replace(/\.html$/, "") },
    props: { to },
  }));
}

/**
 * Three mechanisms, written in the order they fire. `<link rel="canonical">`
 * tells a crawler which page this is, so the alias never becomes a second
 * indexed copy of its target. The script moves a reader immediately and carries
 * whatever query string and fragment they arrived with -- a deep link keeps its
 * intent. `<meta http-equiv="refresh">` is the fallback when scripting is off.
 *
 * Document order is the guarantee, not an accident of formatting: whichever of
 * the two fires first wins, and only the script carries the query and the
 * fragment. So the script goes above the meta -- swapping them would leave a
 * deep link's intent to a race the synchronous script happens to win today.
 *
 * `replace`, not `assign`: the alias must not sit in history, or Back from the
 * canonical page lands on the redirect and bounces forward again.
 */
const { to } = Astro.props;
const canonical = new URL(to, Astro.site).href;
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>Redirecting to {to}</title>
    <link rel="canonical" href={canonical}>
    <meta name="robots" content="noindex, follow">
    {/* Above the meta refresh, not below it: whichever fires first wins, and
        only this one carries the query string and the fragment. */}
    <script is:inline define:vars={{ to }}>
        location.replace(to + location.search + location.hash);
    </script>
    <meta http-equiv="refresh" content={`0; url=${to}`}>
</head>
<body>
<p>This page has moved to <a href={to}>{to}</a>.</p>
</body>
</html>
