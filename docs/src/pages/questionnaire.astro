---
import DocsLayout from "../layouts/DocsLayout.astro";
import Section from "../components/Section.astro";
import Code from "../components/Code.astro";
import TokenTable from "../components/api/TokenTable.astro";
import OptionsTable from "../components/api/OptionsTable.astro";
import { defineSections } from "../lib/sections";
import { route } from "../lib/catalogue";

const S = defineSections([
  { id: "anatomy", label: "Anatomy", heading: false },
  { id: "questions", label: "Questions" },
  { id: "validation", label: "Validation" },
  { id: "conditional", label: "Conditional questions" },
  { id: "submitting", label: "Submitting" },
  { id: "extras", label: "Shortcuts, review and saving" },
  { id: "accessibility", label: "Accessibility" },
  { id: "options", label: "Options" },
  { id: "methods", label: "Methods" },
  { id: "tokens", label: "Tokens" },
]);
---
<DocsLayout page="questionnaire" sections={S}>
  <Section {...S.anatomy}>
        <p class="flow-text">
          Put each question in a <code>&lt;fieldset&gt;</code> inside a
          <code>&lt;form class="questionnaire"&gt;</code>, and add a
          <code>&lt;footer&gt;</code> with the buttons that move between them.
          The form asks one question at a time.
        </p>
        <p>
          Use the <code>&lt;legend&gt;</code> for the prompt and a
          <code>&lt;p&gt;</code> under it to describe the question. Answers are
          ordinary <a href={route('radio_buttons')}>radio buttons</a>,
          <a href={route('checkboxes')}>checkboxes</a> or
          <a href={route('text_inputs')}>text fields</a>. A
          <code>&lt;small&gt;</code> inside a choice's label describes that
          choice. Mark the footer buttons by their <code>value</code>:
          <code>previous</code>, <code>skip</code> and <code>next</code>,
          plus a submit button. The component adds the progress row and
          shows only the question and buttons that apply.
        </p>
        <p>
          Use a questionnaire for a short survey, onboarding or intake form
          where each question deserves the whole screen. For a long form people
          need to scan and correct, keep every field on the page. The
          <a href={route('stepper')}>stepper</a> suits a few large stages, such
          as a checkout, each with several fields.
        </p>
        <article class="outlined" style="max-width: 36rem; padding: 24px;">
          <form class="questionnaire" id="questionnaire-demo" aria-label="Product survey">
            <fieldset>
              <legend>What should we prototype next?</legend>
              <p>Pick the direction you want to explore first.</p>
              <label><input type="radio" name="direction" value="search" required>Search<small>Find any page in two keystrokes</small></label>
              <label><input type="radio" name="direction" value="sharing" required>Sharing<small>Send a view to a teammate</small></label>
              <label><input type="radio" name="direction" value="offline" required>Offline mode<small>Keep working without a connection</small></label>
              <p class="questionnaire-error">Choose an answer to continue.</p>
            </fieldset>
            <fieldset data-required>
              <legend>Where do you use the app?</legend>
              <p>Choose all that apply.</p>
              <label><input type="checkbox" name="platforms" value="web">Web</label>
              <label><input type="checkbox" name="platforms" value="desktop">Desktop</label>
              <label><input type="checkbox" name="platforms" value="mobile">Mobile</label>
              <p class="questionnaire-error">Choose at least one platform.</p>
            </fieldset>
            <fieldset>
              <legend>Anything else we should know?</legend>
              <p>Optional. Skip it if nothing comes to mind.</p>
              <div class="field">
                <textarea id="questionnaire-demo-notes" name="notes" class="expressive-textarea" placeholder=" "></textarea>
                <label for="questionnaire-demo-notes">Notes</label>
              </div>
            </fieldset>
            <footer>
              <button type="button" class="text" value="previous">Back</button>
              <button type="button" class="text" value="skip">Skip</button>
              <button type="button" value="next">Next</button>
              <button type="submit">Submit</button>
            </footer>
          </form>
          <output for="questionnaire-demo" id="questionnaire-demo-result"></output>
        </article>
        <script is:inline>
          document.getElementById('questionnaire-demo').addEventListener('submit', (event) => {
            event.preventDefault();
            const answers = new FormData(event.currentTarget);
            document.getElementById('questionnaire-demo-result').textContent =
              `Direction: ${answers.get('direction')}. Platforms: ${answers.getAll('platforms').join(', ')}.`;
          });
        </script>
<Code code={`
<form class="questionnaire" aria-label="Product survey">
  <fieldset>
    <legend>What should we prototype next?</legend>
    <p>Pick the direction you want to explore first.</p>
    <label><input type="radio" name="direction" value="search" required>Search<small>Find any page in two keystrokes</small></label>
    <label><input type="radio" name="direction" value="sharing" required>Sharing<small>Send a view to a teammate</small></label>
    <p class="questionnaire-error">Choose an answer to continue.</p>
  </fieldset>
  <fieldset data-required>
    <legend>Where do you use the app?</legend>
    <label><input type="checkbox" name="platforms" value="web">Web</label>
    <label><input type="checkbox" name="platforms" value="mobile">Mobile</label>
    <p class="questionnaire-error">Choose at least one platform.</p>
  </fieldset>
  <fieldset>
    <legend>Anything else we should know?</legend>
    <div class="field">
      <textarea id="notes" name="notes" class="expressive-textarea" placeholder=" "></textarea>
      <label for="notes">Notes</label>
    </div>
  </fieldset>
  <footer>
    <button type="button" class="text" value="previous">Back</button>
    <button type="button" class="text" value="skip">Skip</button>
    <button type="button" value="next">Next</button>
    <button type="submit">Submit</button>
  </footer>
</form>
`} />
  </Section>
  <Section {...S.questions}>
        <p>
          The answers decide the kind of question. Radio buttons with one
          <code>name</code> make a single choice, and checkboxes make a
          multiple choice. A text field or textarea takes a free answer, and a
          question can mix choices with a text field for "Other".
        </p>
        <p>
          Add <code>required</code> to one of a question's controls to make
          the question required. HTML has no way for a group of checkboxes to
          say "at least one", so put <code>data-required</code> on its fieldset
          instead. Any other question is optional, and the Skip button appears
          for it. Skipping clears whatever was answered, so the form sends
          nothing for that question. Leave out the Skip button to make people
          press Next instead.
        </p>
  </Section>
  <Section {...S.validation}>
        <p>
          Next checks the shown question with the browser's own validation, so
          <code>required</code>, <code>pattern</code>, <code>minlength</code>
          and the input types all work. When the answer is missing or wrong,
          the fieldset gets <code>invalid</code> and its controls get
          <code>aria-invalid="true"</code>. Its
          <code>.questionnaire-error</code> shows, and focus moves to the
          control to fix. Answering clears the error.
        </p>
        <p>
          Write the error text in the question so it can be specific and in
          the page's language. A question without one shows the browser's
          validation message, or the <code>requiredMessage</code> option for a
          <code>data-required</code> group. Submitting checks every question
          and opens the first one that still needs an answer, whether it comes
          from the button, Enter or <code>requestSubmit()</code>. Only enabled
          checkboxes count toward <code>data-required</code>, since the browser
          does not send a disabled one.
        </p>
  </Section>
  <Section {...S.conditional}>
        <p>
          To branch, enable or disable questions based on earlier answers. The
          component skips a disabled fieldset, and the progress count leaves it
          out. The browser does not send the controls of a disabled fieldset.
        </p>
<Code code={`
<fieldset>
  <legend>Do you work in a team?</legend>
  <label><input type="radio" name="team" value="yes" required>Yes</label>
  <label><input type="radio" name="team" value="no" required>No</label>
</fieldset>
<fieldset id="team-size" disabled>
  <legend>How many people are on your team?</legend>
  …
</fieldset>

<script>
  form.addEventListener('change', () => {
    document.getElementById('team-size').disabled = form.elements.team.value !== 'yes';
  });
</script>
`} />
  </Section>
  <Section {...S.submitting}>
        <p>
          The submit button shows on the last question. Pressing it sends the
          form like any other, to its <code>action</code> or to a
          <code>submit</code> listener that reads the answers with
          <code>FormData</code>. Use <code>getAll()</code> for checkboxes.
          Without JavaScript, every question shows at once, the navigation
          buttons stay hidden, and the submit button still sends the form.
          In that case nothing checks a <code>data-required</code> group.
        </p>
<Code code={`
form.addEventListener('submit', (event) => {
  event.preventDefault();
  const answers = new FormData(event.currentTarget);
  answers.get('direction');    // 'search'
  answers.getAll('platforms'); // ['web', 'mobile']
});
`} />
  </Section>
  <Section {...S.extras}>
        <p>Add any of these three attributes to the form:</p>
        <ul>
          <li>
            <code>data-shortcuts</code> lets a letter or a digit pick the
            answer at that place in the shown question, A or 1 for the first.
            It ends each choice with its letter, which screen readers skip.
            Keys typed into a text field stay text.
          </li>
          <li>
            <code>data-summary</code> adds a review step after the last
            question. It lists every question with its answer and an Edit
            button back to it. The submit button shows there instead.
          </li>
          <li>
            <code>data-save="key"</code> keeps the answers and the shown
            question in <code>localStorage</code> under that key. It restores
            them when the page comes back and forgets them once the form is
            submitted. A restored answer fires <code>change</code>, so
            conditional questions open as they did. File inputs are not
            saved. Keep personal answers out of saved questionnaires on
            shared devices.
          </li>
        </ul>
        <form class="questionnaire" aria-label="Shortcut survey" data-shortcuts data-summary data-markdown-ignore>
          <fieldset>
            <legend>How did you hear about us?</legend>
            <label><input type="radio" name="heard" value="search" required>Search engine</label>
            <label><input type="radio" name="heard" value="friend" required>A friend</label>
            <label><input type="radio" name="heard" value="ad" required>An ad</label>
          </fieldset>
          <fieldset>
            <legend>What do you use it for?</legend>
            <label><input type="checkbox" name="use" value="work">Work</label>
            <label><input type="checkbox" name="use" value="home">Home</label>
          </fieldset>
          <footer>
            <button type="button" class="text" value="previous">Back</button>
            <button type="button" class="text" value="skip">Skip</button>
            <button type="button" value="next">Next</button>
            <button type="submit">Submit</button>
          </footer>
        </form>
<Code code={`
<form class="questionnaire" aria-label="Shortcut survey" data-shortcuts data-summary data-save="survey">
  <fieldset>
    <legend>How did you hear about us?</legend>
    <label><input type="radio" name="heard" value="search" required>Search engine</label>
    <label><input type="radio" name="heard" value="friend" required>A friend</label>
    <label><input type="radio" name="heard" value="ad" required>An ad</label>
  </fieldset>
  <!-- More questions -->
  <footer>
    <button type="button" class="text" value="previous">Back</button>
    <button type="button" class="text" value="skip">Skip</button>
    <button type="button" value="next">Next</button>
    <button type="submit">Submit</button>
  </footer>
</form>
`} />
  </Section>
  <Section {...S.accessibility}>
        <p>
          Each question is a native group named by its legend. The component
          attaches the description and any error with
          <code>aria-describedby</code>. Hidden questions use
          <code>hidden</code>, so they are out of the tab order and the
          accessibility tree. After Next, Back or Skip, focus moves to the
          selected answer or the first control of the new question.
        </p>
        <p>
          Name the form with <code>aria-label</code> or a heading. Enter in a
          field moves to the next question, and on the last one it submits.
          The progress row is a <code>&lt;progress&gt;</code> named by its
          text, "Question 2 of 3".
        </p>
  </Section>
  <Section {...S.options}>
        <OptionsTable>
          <tr>
            <td><code>progressLabel</code></td>
            <td>String</td>
            <td><code>'Question {'{current}'} of {'{total}'}'</code></td>
            <td>Text of the progress row. <code>{'{current}'}</code> and <code>{'{total}'}</code> become the question number and count. <code>data-progress-label</code> on the form sets it.</td>
          </tr>
          <tr>
            <td><code>requiredMessage</code></td>
            <td>String</td>
            <td><code>'Choose an answer to continue.'</code></td>
            <td>Error for a question with no <code>.questionnaire-error</code> when the browser has no message, as for a <code>data-required</code> group.</td>
          </tr>
          <tr>
            <td><code>summaryLabel</code></td>
            <td>String</td>
            <td><code>'Review your answers'</code></td>
            <td>With <code>data-summary</code>, the review step's name and the text of the progress row there.</td>
          </tr>
          <tr>
            <td><code>editLabel</code></td>
            <td>String</td>
            <td><code>'Edit'</code></td>
            <td>With <code>data-summary</code>, the text of each answer's button back to its question.</td>
          </tr>
          <tr>
            <td><code>skippedLabel</code></td>
            <td>String</td>
            <td><code>'Not answered'</code></td>
            <td>With <code>data-summary</code>, the answer shown for a question left blank.</td>
          </tr>
        </OptionsTable>
  </Section>
  <Section {...S.methods}>
<Code code={`
const questionnaire = Expressive.Questionnaire.getInstance(document.querySelector('form.questionnaire'));
questionnaire.items;     // the fieldsets that apply, in order
questionnaire.index;     // position of the shown question
questionnaire.next();    // checks the shown question, then moves on
questionnaire.previous();
questionnaire.skip();    // clears the shown answer, then moves on
questionnaire.goTo(2);   // shows a question without checking, e.g. to resume
questionnaire.review();  // with data-summary, shows the review step
questionnaire.destroy(); // shows every question and removes what it added
`} />
  </Section>
  <Section {...S.tokens}>
        <p>Override these on the <code>.questionnaire</code>.</p>
        <TokenTable>
          <tr><td><code>--md-comp-questionnaire-choice-shape</code></td><td>12px</td></tr>
          <tr><td><code>--md-comp-questionnaire-choice-outline-color</code></td><td><code>--md-sys-color-outline-variant</code></td></tr>
          <tr><td><code>--md-comp-questionnaire-choice-selected-color</code></td><td><code>--md-sys-color-secondary-container</code></td></tr>
        </TokenTable>
  </Section>
</DocsLayout>
