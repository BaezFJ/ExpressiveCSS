---
import DocsLayout from "../layouts/DocsLayout.astro";
import PageBody from "../components/PageBody.astro";
import Section from "../components/Section.astro";
import Code from "../components/Code.astro";
import OptionsTable from "../components/api/OptionsTable.astro";
import { defineSections } from "../lib/sections";

const S = defineSections([
  { id: "anatomy", label: "Anatomy", heading: false },
  { id: "color", label: "Color" },
  { id: "drift", label: "Drift" },
  { id: "accessibility", label: "Accessibility" },
  { id: "options", label: "Options" },
  { id: "methods", label: "Methods" },
]);
---
<DocsLayout page="particles">
<PageBody sections={S}>
  <Section {...S.anatomy}>
        <p class="flow-text">
          Particles fill the background of a section with drifting dots that
          lean toward the pointer.
        </p>
        <p>
          A <code>&lt;canvas class="particles" aria-hidden="true"&gt;</code>
          covers its nearest positioned ancestor and lets clicks through.
          Each dot drifts slowly, fades out near the edges and moves toward
          the pointer while it is over the canvas, some further than others.
          <code>AutoInit()</code> starts every <code>canvas.particles</code>.
        </p>
        <div class="card outlined valign-wrapper" style="position: relative; height: 320px; justify-content: center; overflow: hidden" data-markdown-ignore>
          <p class="display-medium" style="margin: 0">Particles</p>
          <canvas class="particles" aria-hidden="true"></canvas>
        </div>
<Code code={`
<div style="position: relative; height: 320px">
  <h2>Particles</h2>
  <canvas class="particles" aria-hidden="true"></canvas>
</div>
`} />
  </Section>
  <Section {...S.color}>
        <p>
          The dots take the canvas's CSS <code>color</code>, which is the
          theme's on-surface color unless you set another. The
          <code>color</code> option takes any CSS color and wins over the
          stylesheet.
        </p>
        <div class="card filled valign-wrapper" style="position: relative; height: 240px; justify-content: center; overflow: hidden" data-markdown-ignore>
          <p class="headline-medium" style="margin: 0">Primary</p>
          <canvas class="particles" aria-hidden="true" style="color: var(--md-sys-color-primary)"></canvas>
        </div>
<Code code={`
<canvas class="particles" aria-hidden="true" style="color: var(--md-sys-color-primary)"></canvas>
`} />
  </Section>
  <Section {...S.drift}>
        <p>
          <code>vx</code> and <code>vy</code> push every dot the same way, in
          pixels per frame. A dot that leaves the canvas is replaced by a new
          one somewhere inside it. Lower <code>staticity</code> lets the dots
          follow the pointer further.
        </p>
        <div class="card outlined valign-wrapper" style="position: relative; height: 240px; justify-content: center; overflow: hidden" data-markdown-ignore>
          <p class="headline-medium" style="margin: 0">Rising</p>
          <canvas class="particles no-autoinit" id="demo-drift" aria-hidden="true"></canvas>
        </div>
<Code code={`
<canvas class="particles no-autoinit" aria-hidden="true"></canvas>

<script>
const canvas = document.querySelector('canvas.particles');
Expressive.Particles.init(canvas, { quantity: 150, vy: -0.3, staticity: 20 });
</script>
`} />
  </Section>
  <Section {...S.accessibility}>
        <ul class="browser-default">
          <li>Particles are decoration. Mark the canvas <code>aria-hidden="true"</code> and keep the content above it readable.</li>
          <li>The canvas has pointer events off, so links and buttons under it still work.</li>
          <li>When the reader prefers reduced motion, the dots are drawn once and stay still.</li>
        </ul>
  </Section>
  <Section {...S.options}>
        <OptionsTable>
          <tr><td><code>quantity</code></td><td>Number</td><td><code>100</code></td><td>Number of dots.</td></tr>
          <tr><td><code>staticity</code></td><td>Number</td><td><code>50</code></td><td>How firmly dots hold their place against the pointer; lower follows further.</td></tr>
          <tr><td><code>ease</code></td><td>Number</td><td><code>50</code></td><td>Frames a dot takes to catch up with the pointer; higher is slower.</td></tr>
          <tr><td><code>size</code></td><td>Number</td><td><code>0.4</code></td><td>Base radius in pixels. Each dot adds 0 or 1.</td></tr>
          <tr><td><code>color</code></td><td>String</td><td><code>''</code></td><td>A CSS color. Empty uses the canvas's CSS <code>color</code>.</td></tr>
          <tr><td><code>vx</code></td><td>Number</td><td><code>0</code></td><td>Horizontal drift in pixels per frame; negative drifts left.</td></tr>
          <tr><td><code>vy</code></td><td>Number</td><td><code>0</code></td><td>Vertical drift in pixels per frame; negative drifts up.</td></tr>
        </OptionsTable>
  </Section>
  <Section {...S.methods}>
<Code code={`
const particles = Expressive.Particles.getInstance(canvas);
particles.destroy();   // stops drawing and clears the canvas
`} />
  </Section>
</PageBody>
<script is:inline>
// The bundle loads after the page body.
document.addEventListener('DOMContentLoaded', () => {
  Expressive.Particles.init(document.getElementById('demo-drift'), { quantity: 150, vy: -0.3, staticity: 20 });
});
</script>
</DocsLayout>
