---
import DocsLayout from "../layouts/DocsLayout.astro";
import Section from "../components/Section.astro";
import Code from "../components/Code.astro";
import InstanceNote from "../components/api/InstanceNote.astro";
import OptionsTable from "../components/api/OptionsTable.astro";
import PropertiesTable from "../components/api/PropertiesTable.astro";
import { defineSections } from "../lib/sections";

const S = defineSections([
  { id: "anatomy", label: "Introduction", heading: false },
  { id: "secondary", label: "Secondary" },
  { id: "tablist", label: "Tablist" },
  { id: "initialization", label: "Initialization" },
  { id: "options", label: "Options" },
  { id: "method", label: "Methods" },
  { id: "properties", label: "Properties" },
  { id: "preselecting", label: "Preselecting", heading: "Preselecting a tab" },
  { id: "external", label: "External links", heading: "Linking to an external page" },
  { id: "swipeable", label: "Swipeable tabs" },
  { id: "fixed-width", label: "Fixed width" },
  { id: "icons", label: "Inline icons" },
]);
---
<DocsLayout page="tabs" sections={S}>
  <Section {...S.anatomy}>
        <p class="flow-text">
          Build the bar from a <code>&lt;nav class="tabs"&gt;</code> of
          <code>&lt;a href="#panel"&gt;</code> links. A
          <code>&lt;span&gt;</code> (or the link text) is the label, and a
          leading <code>&lt;span class="material-symbols" aria-hidden="true"&gt;</code> is the icon.
          For a count, nest a <code>&lt;span class="badge"&gt;</code> in the icon
          and put the count in the tab's <code>aria-label</code>, so screen
          readers still announce it when the icon is hidden.
          Add <code>.active</code> to the selected tab.
          <code>AutoInit()</code> starts every <code>.tabs</code> except
          those marked <code>no-autoinit</code>.
        </p>
        <p>
          Each tab is a link and a Tab stop. When a tab has focus, Left and Right move focus to the next or previous tab and wrap at the ends. Home and End move focus to the first and last tab. Focus skips disabled tabs. In a right-to-left page, the arrows still move the way they point. Moving focus does not switch the panel. Enter follows the link. The tabs keep their link semantics and <code>aria-current</code>. For panels that switch in place, a <a href="#tablist">tablist</a> works the other way. When the bar scrolls, the selected tab scrolls into view.
        </p>
        <p>
          Tokens follow the
          <a href="https://m3.material.io/components/tabs/specs">M3 tabs spec</a>.
          Primary tabs sit on <code>surface</code> and are 48dp tall, or 64dp
          with a stacked icon. The label is <code>title-small</code> in
          <code>on-surface-variant</code>, and <code>primary</code> when
          selected. The indicator is 3dp
          <code>primary</code> with 3dp top corners. The icon is 24dp.
          A 1dp <code>outline-variant</code> divider runs under the bar.
          Hover is 8%, focus is 10%, and disabled is 38%.
        </p>

        <nav class="tabs" aria-label="Travel">
          <a href="#tabs-intro-flight"><span class="material-symbols" aria-hidden="true">flight</span><span>Flight</span></a>
          <a class="active" aria-current="page" href="#tabs-intro-luggage" aria-label="Luggage, 3 unread"><span class="material-symbols" aria-hidden="true">luggage<span class="badge">3</span></span><span>Luggage</span></a>
          <a href="#tabs-intro-explore"><span class="material-symbols" aria-hidden="true">explore</span><span>Explore</span></a>
        </nav>
        <div id="tabs-intro-flight" class="py-3">Flight</div>
        <div id="tabs-intro-luggage" class="py-3">Luggage</div>
        <div id="tabs-intro-explore" class="py-3">Explore</div>
<Code code={`
<nav class="tabs" aria-label="Travel">
  <a href="#flight">
    <span class="material-symbols" aria-hidden="true">flight</span>
    <span>Flight</span>
  </a>
  <a class="active" aria-current="page" href="#luggage" aria-label="Luggage, 3 unread">
    <span class="material-symbols" aria-hidden="true">luggage<span class="badge">3</span></span>
    <span>Luggage</span>
  </a>
  <a href="#explore">
    <span class="material-symbols" aria-hidden="true">explore</span>
    <span>Explore</span>
  </a>
</nav>
<div id="flight">Flight</div>
<div id="luggage">Luggage</div>
<div id="explore">Explore</div>
`} />
        <p>
          Add <code>disabled</code> on the <code>&lt;a&gt;</code> to make it inaccessible. Tabs
          become scrollable when there are too many to fit.
        </p>
        <nav class="tabs" aria-label="Many destinations">
          <a href="#tabs-scroll-1">Test 1</a>
          <a href="#tabs-scroll-2">Test 2</a>
          <a href="#tabs-scroll-3">Test 3</a>
          <a href="#tabs-scroll-4">Test 4</a>
          <a href="#tabs-scroll-5">Test 5</a>
          <a class="disabled" href="#tabs-scroll-6">Disabled</a>
          <a href="#tabs-scroll-7">Test 7</a>
          <a href="#tabs-scroll-8">Test 8</a>
          <a href="#tabs-scroll-9">Test 9</a>
          <a class="disabled" href="#tabs-scroll-10">Disabled</a>
          <a href="#tabs-scroll-11">Test 11</a>
        </nav>
        <div id="tabs-scroll-1" class="py-3">Test 1</div>
        <div id="tabs-scroll-2" class="py-3">Test 2</div>
        <div id="tabs-scroll-3" class="py-3">Test 3</div>
        <div id="tabs-scroll-4" class="py-3">Test 4</div>
        <div id="tabs-scroll-5" class="py-3">Test 5</div>
        <div id="tabs-scroll-6" class="py-3">Test 6</div>
        <div id="tabs-scroll-7" class="py-3">Test 7</div>
        <div id="tabs-scroll-8" class="py-3">Test 8</div>
        <div id="tabs-scroll-9" class="py-3">Test 9</div>
        <div id="tabs-scroll-10" class="py-3">Test 10</div>
        <div id="tabs-scroll-11" class="py-3">Test 11</div>
  </Section>
  <Section {...S.secondary}>
        <p>
          Add <code>tabs-secondary</code> for the in-content variant. Use it to
          split a pane further. It is always 48dp, with inline icons and a 2dp
          indicator.
        </p>
        <nav class="tabs tabs-secondary" aria-label="Trip">
          <a href="#tabs-sec-birds"><span class="material-symbols" aria-hidden="true">flight</span><span>Travel</span></a>
          <a class="active" aria-current="page" href="#tabs-sec-cats"><span class="material-symbols" aria-hidden="true">hotel</span><span>Hotel</span></a>
          <a href="#tabs-sec-dogs"><span class="material-symbols" aria-hidden="true">directions_walk</span><span>Walks</span></a>
        </nav>
        <div id="tabs-sec-birds" class="py-3">Travel</div>
        <div id="tabs-sec-cats" class="py-3">Hotel</div>
        <div id="tabs-sec-dogs" class="py-3">Walks</div>
<Code code={`
<nav class="tabs tabs-secondary" aria-label="Trip">
  <a href="#travel">
    <span class="material-symbols" aria-hidden="true">flight</span>
    <span>Travel</span>
  </a>
  <a class="active" aria-current="page" href="#hotel">
    <span class="material-symbols" aria-hidden="true">hotel</span>
    <span>Hotel</span>
  </a>
</nav>
`} />
  </Section>
  <Section {...S.tablist}>
        <p>
          For panels that switch in place, you can make the strip a tablist
          instead. Link tabs stay the default, for tabs that lead to sections or
          pages. To build a tablist:
        </p>
        <ol>
          <li>Put <code>role="tablist"</code> and a name on a <code>&lt;div class="tabs"&gt;</code>.</li>
          <li>Put <code>role="tab"</code> with <code>aria-controls</code> on each link.</li>
          <li>Put <code>role="tabpanel"</code> with <code>aria-labelledby</code> on each panel.</li>
        </ol>
        <p>
          Tabs then keeps <code>aria-selected</code> on the selected tab and a roving
          <code>tabindex</code>, so the strip is one Tab stop. Left and Right, Home and End
          move between the tabs and select as they go.
        </p>
        <div class="tabs" role="tablist" aria-label="Trip details">
          <a role="tab" id="tablist-demo-flight-tab" href="#tablist-demo-flight" aria-controls="tablist-demo-flight">Flight</a>
          <a role="tab" class="active" id="tablist-demo-hotel-tab" href="#tablist-demo-hotel" aria-controls="tablist-demo-hotel">Hotel</a>
          <a role="tab" id="tablist-demo-car-tab" href="#tablist-demo-car" aria-controls="tablist-demo-car">Car</a>
        </div>
        <div id="tablist-demo-flight" role="tabpanel" aria-labelledby="tablist-demo-flight-tab" class="py-3">Flight</div>
        <div id="tablist-demo-hotel" role="tabpanel" aria-labelledby="tablist-demo-hotel-tab" class="py-3">Hotel</div>
        <div id="tablist-demo-car" role="tabpanel" aria-labelledby="tablist-demo-car-tab" class="py-3">Car</div>
<Code code={`
<div class="tabs" role="tablist" aria-label="Trip details">
  <a role="tab" id="flight-tab" href="#flight" aria-controls="flight">Flight</a>
  <a role="tab" class="active" id="hotel-tab" href="#hotel" aria-controls="hotel">Hotel</a>
  <a role="tab" id="car-tab" href="#car" aria-controls="car">Car</a>
</div>
<div id="flight" role="tabpanel" aria-labelledby="flight-tab">Flight</div>
<div id="hotel" role="tabpanel" aria-labelledby="hotel-tab">Hotel</div>
<div id="car" role="tabpanel" aria-labelledby="car-tab">Car</div>
`} />
  </Section>
  <Section {...S.initialization}>
        <p>
          The IIFE bundle exposes <code>Expressive.Tabs</code>.
          Call <code>init</code> yourself when you need options other
          than the defaults, or let
          <code>Expressive.AutoInit()</code> start every
          <code>.tabs</code>.
        </p>
<Code code={`
document.addEventListener('DOMContentLoaded', function() {
  const elems = document.querySelectorAll('.tabs');
  const instances = Expressive.Tabs.init(elems, {
    swipeable: false
  });
});
`} />
  </Section>
  <Section {...S.options}>
        <OptionsTable>
            <tr>
              <td><code>duration</code></td>
              <td>Number</td>
              <td><code>null</code></td>
              <td>Indicator transition duration in milliseconds, on an ease-out curve. The default, <code>null</code>, moves the indicator on the default spatial spring (<code>--md-comp-tabs-indicator-easing</code> and <code>--md-comp-tabs-indicator-duration</code>), which follows <code>motion="expressive"</code> and stops under reduced motion.</td>
            </tr>
            <tr>
              <td><code>onShow</code></td>
              <td>Function</td>
              <td><code>null</code></td>
              <td>Called when a new tab panel is shown. Receives the panel element.</td>
            </tr>
            <tr>
              <td><code>swipeable</code></td>
              <td>Boolean</td>
              <td><code>false</code></td>
              <td>Enable swipeable tabs. Uses <code>responsiveThreshold</code>. Moves the panels into a scroll-snap track.</td>
            </tr>
            <tr>
              <td><code>responsiveThreshold</code></td>
              <td>Number</td>
              <td><code>Infinity</code></td>
              <td>Maximum viewport width, in pixels, at which swipeable mode starts. Wider viewports stay non-swipeable.</td>
            </tr>
        </OptionsTable>
  </Section>
  <Section {...S.method}>
        <InstanceNote plugin="Tabs" />

        <h5 class="light">.select();</h5>
        <p>Show the panel that belongs to the tab with this id. Tabs matches panel IDs literally in normal and swipeable modes, including numeric IDs and IDs containing dots, colons or brackets.</p>
        <p><strong>String:</strong> The id of the tab panel (without <code>#</code>).</p>
<Code code={`
instance.select('tab_id');
`} />

        <h5 class="light">.updateTabIndicator();</h5>
        <p>Recalculate the indicator position. Call it after the bar has been hidden or resized.</p>
<Code code={`
instance.updateTabIndicator();
`} />

        <h5 class="light">.destroy();</h5>
        <p>Destroy the plugin instance and tear down its event handlers.</p>
<Code code={`
instance.destroy();
`} />
  </Section>
  <Section {...S.properties}>
        <PropertiesTable el="The DOM element the plugin was initialized with (the <code>.tabs</code> bar).">            <tr>
              <td><code>index</code></td>
              <td>Number</td>
              <td>Index of the tab that is currently shown.</td>
            </tr>
        </PropertiesTable>
  </Section>
  <Section {...S.preselecting}>
        <p>
          The first tab is selected by default. To pick another, add
          <code>active</code> to its <code>&lt;a&gt;</code>, or load the
          page with a matching hash such as <code>#test2</code>.
        </p>
<Code code={`
<a class="active" href="#test3">Test 3</a>
`} />
  </Section>
  <Section {...S.external}>
        <p>
          To keep a tab as a normal hyperlink, set <code>target</code> on the
          link. Without it, Tabs ignores default anchor behaviour.
        </p>
<Code code={`
<nav class="tabs" aria-label="Sections">
  <a target="_blank" href="https://github.com">External link in new window</a>
  <a target="_self" href="https://github.com">External link in same window</a>
</nav>
`} />
  </Section>
  <Section {...S.swipeable}>
        <p>
          Set <code>swipeable: true</code> to swipe between panels with
          touch or a trackpad. Keep the tab panels in the same wrapping
          container. Tabs moves those panels into a full-width
          <code>.tabs-content</code> scroll-snap track. Only the shown
          panel is reachable by keyboard.
        </p>
        <p>
          <code>responsiveThreshold</code> is the maximum
          viewport width at which swipeable mode initializes. Resizing later
          does not switch modes. Clicks and swipes update the current link.
          They call <code>onShow</code> once per changed selection, with the
          shown panel. <code>destroy()</code> removes the track and restores
          panel positions and the state owned by Tabs.
        </p>
        <p>This demo is marked <code>no-autoinit</code> and started with <code>swipeable: true</code>.</p>
        <nav id="tabs-swipe" data-tabs-options='{"swipeable": true}' class="tabs" aria-label="Swipe demo">
          <a href="#tabs-swipe-1">Test 1</a>
          <a class="active" aria-current="page" href="#tabs-swipe-2">Test 2</a>
          <a href="#tabs-swipe-3">Test 3</a>
        </nav>
        <div class="tabs-swipe-demo">
          <div id="tabs-swipe-1" class="primary-container on-primary-container-text center-align">Test 1</div>
          <div id="tabs-swipe-2" class="secondary-container on-secondary-container-text center-align">Test 2</div>
          <div id="tabs-swipe-3" class="tertiary-container on-tertiary-container-text center-align">Test 3</div>
        </div>
<Code code={`
<nav id="tabs-swipe-demo" class="tabs" aria-label="Sections">
  <a href="#test-swipe-1">Test 1</a>
  <a class="active" aria-current="page" href="#test-swipe-2">Test 2</a>
  <a href="#test-swipe-3">Test 3</a>
</nav>
`} />
<Code code={`
Expressive.Tabs.init(document.querySelector('#tabs-swipe-demo'), {
  swipeable: true
});
`} />
  </Section>
  <Section {...S["fixed-width"]}>
        <p>
          Add <code>max</code> so
          every tab grows equally. On compact viewports every tab bar
          already uses this layout.
        </p>
        <nav class="tabs max" aria-label="Fixed width">
          <a href="#tabs-fixed-1">Test 1</a>
          <a class="active" aria-current="page" href="#tabs-fixed-2">Test 2</a>
          <a class="disabled" href="#tabs-fixed-3">Disabled</a>
          <a href="#tabs-fixed-4">Test 4</a>
          <a href="#tabs-fixed-5">Test 5</a>
        </nav>
        <div id="tabs-fixed-1" class="py-3">Test 1</div>
        <div id="tabs-fixed-2" class="py-3">Test 2</div>
        <div id="tabs-fixed-3" class="py-3">Test 3</div>
        <div id="tabs-fixed-4" class="py-3">Test 4</div>
        <div id="tabs-fixed-5" class="py-3">Test 5</div>
<Code code={`
<nav class="tabs max" aria-label="Sections">
  <a href="#test1">Test 1</a>
  <a class="active" aria-current="page" href="#test2">Test 2</a>
  <a class="disabled" href="#test3">Disabled</a>
</nav>
`} />
  </Section>
  <Section {...S.icons}>
        <p>
          Primary tabs stack the icon above the label (64dp). Add
          <code>horizontal</code> to put them on one line, like secondary
          tabs.
        </p>
        <nav class="tabs max horizontal" aria-label="Inline icons">
          <a href="#tabs-horiz-flight"><span class="material-symbols" aria-hidden="true">flight</span><span>Flight</span></a>
          <a class="active" aria-current="page" href="#tabs-horiz-luggage"><span class="material-symbols" aria-hidden="true">luggage</span><span>Luggage</span></a>
          <a href="#tabs-horiz-explore"><span class="material-symbols" aria-hidden="true">explore</span><span>Explore</span></a>
        </nav>
        <div id="tabs-horiz-flight" class="py-3">Flight</div>
        <div id="tabs-horiz-luggage" class="py-3">Luggage</div>
        <div id="tabs-horiz-explore" class="py-3">Explore</div>
<Code code={`
<nav class="tabs max horizontal" aria-label="Sections">
  <a href="#flight">
    <span class="material-symbols" aria-hidden="true">flight</span>
    <span>Flight</span>
  </a>
  <a class="active" aria-current="page" href="#luggage">
    <span class="material-symbols" aria-hidden="true">luggage</span>
    <span>Luggage</span>
  </a>
</nav>
`} />
  </Section>
</DocsLayout>
