---
import DocsLayout from "../layouts/DocsLayout.astro";
import Section from "../components/Section.astro";
import Code from "../components/Code.astro";
import { defineSections } from "../lib/sections";

const S = defineSections([
  { id: "valign", label: "Alignment" },
  { id: "display", label: "Display and position" },
  { id: "flex", label: "Flex" },
  { id: "prefixes", label: "Window-size prefixes" },
  { id: "overflow", label: "Sizing and overflow" },
  { id: "borders", label: "Borders and corners" },
  { id: "hiding", label: "Hiding and showing content" },
  { id: "spacing", label: "Spacing content", heading: "Spacing" },
  { id: "formatting", label: "Formatting" },
  { id: "pointer", label: "Pointer" },
  { id: "browser-default", label: "Browser defaults" },
]);
---
<DocsLayout page="helpers" sections={S}>
  <Section {...S.valign}>
        <p class="flow-text">Use these classes to align content.</p>

        <h5>Vertical align</h5>
        <p>
          To center items vertically, add the class
          <code>valign-wrapper</code> to their container.
        </p>
        <div class="valign-demo valign-wrapper primary-container px-4">
          <p class="on-primary-container-text my-0">This should be vertically aligned</p>
        </div>
<Code code={`
<div class="valign-wrapper">
  <h5>This should be vertically aligned</h5>
</div>
`} />

        <h5>Text align</h5>
        <p>
          Add <code>.left-align</code>, <code>.right-align</code> or <code>.center-align</code>
          to align content horizontally. Use <code>.start-align</code> and <code>.end-align</code> to follow the
          text direction. The left and right classes stay physical and do not mirror in RTL.
        </p>
        <article class="surface-container-highest">
          <h5 class="left-align">This should be left aligned</h5>
        </article>
        <article class="surface-container-highest">
          <h5 class="right-align">This should be right aligned</h5>
        </article>
        <article class="surface-container-highest">
          <h5 class="center-align">This should be center aligned</h5>
        </article>
<Code code={`
<div>
  <h5 class="left-align">This should be left aligned</h5>
</div>
<div>
  <h5 class="right-align">This should be right aligned</h5>
</div>
<div>
  <h5 class="center-align">This should be center aligned</h5>
</div>
`} />

        <p>
          To center text on mobile only, add <code>center-on-small-only</code>.
        </p>
  </Section>
  <Section {...S.display}>
        <table class="striped">
          <thead><tr><th>Class</th><th>Declaration</th></tr></thead>
          <tbody>
            <tr><td><code>.block</code>, <code>.inline-block</code></td><td><code>display: block</code>, <code>display: inline-block</code></td></tr>
            <tr><td><code>.grid</code>, <code>.inline-grid</code></td><td><code>display: grid</code>, <code>display: inline-grid</code></td></tr>
            <tr><td><code>.grid-auto-fill</code></td><td>A grid with as many columns as fit, each at least <code>--grid-column-min</code> wide (240px by default)</td></tr>
            <tr><td><code>.contents</code></td><td><code>display: contents</code>; the element's box goes away and its children join the parent's layout</td></tr>
            <tr><td><code>.relative</code></td><td><code>position: relative</code></td></tr>
            <tr><td><code>.sticky-top</code></td><td><code>position: sticky; top: 0</code></td></tr>
            <tr><td><code>.position-absolute</code>, <code>.position-fixed</code>, <code>.position-static</code></td><td><code>position: absolute</code>, <code>position: fixed</code>, <code>position: static</code></td></tr>
            <tr><td><code>.inset-0</code></td><td><code>inset: 0</code>; the element covers its containing block</td></tr>
            <tr><td><code>.top-0</code>, <code>.bottom-0</code></td><td><code>top: 0</code>, <code>bottom: 0</code></td></tr>
            <tr><td><code>.start-0</code>, <code>.end-0</code></td><td><code>inset-inline-start: 0</code>, <code>inset-inline-end: 0</code>; they swap sides in RTL</td></tr>
            <tr><td><code>.query-container</code></td><td><code>container-type: inline-size</code>. Horizontal cards and description lists inside it stack when it is narrower than 600px, on any window.</td></tr>
          </tbody>
        </table>
        <p>
          There is no <code>display: inline</code> class, because <code>.inline</code> is the row
          of checkboxes or radios. A <code>.sticky-top</code> element sticks inside its nearest
          scrolling ancestor. An ancestor with <code>overflow: hidden</code> stops it.
        </p>
        <p>
          An absolute element is placed against its nearest positioned ancestor, so give the
          parent <code>.relative</code>. There is no bare <code>.fixed</code> class, because
          the navigation bar, toolbar and table of contents use <code>.fixed</code> as a
          modifier. <code>.position-fixed</code> sets no <code>z-index</code>. To lift a fixed
          element above framework surfaces, give it a value from the
          <code>--expressive-z-*</code> scale in <a href="shadow.html#stacking">Stacking order</a>. An
          ancestor with a <code>transform</code>, <code>filter</code> or
          <code>contain</code> becomes the containing block of a fixed element, so it stops
          covering the viewport. Pad the content on the pinned side, as <code>.pe-6</code> does below, so text does not run under the pinned element. No position class has a window-size prefix, and
          <code>.position-static</code> undoes <code>.relative</code> and <code>.sticky-top</code>.
        </p>
<Code code={`
<article class="relative">
  <p class="pe-6">Your storage is almost full. Delete old backups to keep syncing.</p>
  <button class="icon-button position-absolute top-0 end-0" type="button" aria-label="Dismiss">
    <span class="material-symbols" aria-hidden="true">close</span>
  </button>
</article>
`} />
        <p>
          Browsers have dropped the semantics of elements with <code>display: contents</code>, so
          put <code>.contents</code> on plain wrappers, not on buttons, lists, tables or headings.
          A <code>.query-container</code> can no longer size itself from its content. Put it on
          a wrapper that fills its parent, such as a sidebar column, not on an inline or
          shrink-to-fit box.
        </p>
        <div class="grid-auto-fill gap-3" style="--grid-column-min: 10rem">
          <div class="surface-container p-4">Orders</div>
          <div class="surface-container p-4">Returns</div>
          <div class="surface-container p-4">Refunds</div>
          <div class="surface-container p-4">Payouts</div>
          <div class="surface-container p-4">Disputes</div>
        </div>
<Code code={`
<div class="grid-auto-fill gap-3" style="--grid-column-min: 10rem">
  <article class="outlined">…</article>
  <article class="outlined">…</article>
  <article class="outlined">…</article>
</div>
`} />
        <p>
          <code>.grid-auto-fill</code> adds a column whenever another one of the minimum width
          fits, and the columns share what is left. Set <code>--grid-column-min</code> on the
          grid or on an ancestor. The last row keeps the same column width when it has fewer
          items. A container narrower than the minimum gets one column as wide as itself. The
          class sets no gap, so pair it with <code>.gap-*</code>. It has no window-size prefixes,
          because the column count already follows the container's width.
        </p>
  </Section>
  <Section {...S.flex}>
        <p>
          Each class sets one declaration, usually on the container. Row direction and start
          alignment are the flex defaults, but <code>.flex-row</code> and <code>.flex-nowrap</code>
          exist so a window-size prefix can switch back to them.
        </p>
        <table class="striped">
          <thead>
            <tr>
              <th>Class</th>
              <th>Declaration</th>
            </tr>
          </thead>
          <tbody>
            <tr><td><code>.flex</code></td><td><code>display: flex</code></td></tr>
            <tr><td><code>.inline-flex</code></td><td><code>display: inline-flex</code></td></tr>
            <tr><td><code>.flex-row</code>, <code>.flex-column</code></td><td><code>flex-direction</code></td></tr>
            <tr><td><code>.flex-wrap</code>, <code>.flex-nowrap</code></td><td><code>flex-wrap</code></td></tr>
            <tr><td><code>.justify-start</code>, <code>.justify-center</code>, <code>.justify-end</code>, <code>.justify-between</code>, <code>.justify-around</code>, <code>.justify-evenly</code></td><td><code>justify-content</code></td></tr>
            <tr><td><code>.align-start</code>, <code>.align-center</code>, <code>.align-end</code>, <code>.align-stretch</code>, <code>.align-baseline</code></td><td><code>align-items</code></td></tr>
            <tr><td><code>.flex-1</code></td><td><code>flex: 1 1 0</code> on a child, so it takes the remaining space</td></tr>
            <tr><td><code>.flex-none</code></td><td><code>flex: none</code> on a child, so it keeps its content size</td></tr>
            <tr><td><code>.flex-initial</code></td><td><code>flex: 0 1 auto</code> on a child, so it sizes from its content, can shrink and does not grow</td></tr>
            <tr><td><code>.shrink-0</code></td><td><code>flex-shrink: 0</code> on a child, so it never gets narrower than its basis</td></tr>
            <tr><td><code>.shrink-1</code></td><td><code>flex-shrink: 1</code> on a child, restoring shrinking while keeping its grow factor and basis</td></tr>
            <tr><td><code>.self-start</code>, <code>.self-center</code>, <code>.self-end</code>, <code>.self-stretch</code></td><td><code>align-self</code> on a child</td></tr>
            <tr><td><code>.order-first</code>, <code>.order-last</code></td><td><code>order: -1</code>, <code>order: 1</code> on a child. This changes the visual order only. Keyboard and screen reader order still follow the source.</td></tr>
            <tr><td><code>.gap-0</code> to <code>.gap-6</code></td><td><code>gap</code> on the spacing scale, with <code>!important</code>. Also works on grid containers.</td></tr>
            <tr><td><code>.gap-x-0</code> to <code>.gap-x-6</code></td><td><code>column-gap</code> only, with <code>!important</code>.</td></tr>
            <tr><td><code>.gap-y-0</code> to <code>.gap-y-6</code></td><td><code>row-gap</code> only, with <code>!important</code>.</td></tr>
          </tbody>
        </table>
        <div class="flex align-center justify-between gap-3 surface-container p-4">
          <h5 class="title-medium my-0">Members</h5>
          <button type="button" class="tonal">Invite</button>
        </div>
<Code code={`
<div class="flex align-center justify-between gap-3">
  <h2 class="title-medium my-0">Members</h2>
  <button class="tonal">Invite</button>
</div>

<div class="flex flex-wrap gap-2">
  <span class="chip">Design</span>
  <span class="chip">Research</span>
</div>
`} />
        <p>
          <code>justify-*</code> and <code>align-*</code> use <code>flex-start</code> and
          <code>flex-end</code>, so they follow the writing direction and mirror in RTL. Components
          that already lay out their children (app bars, toolbars, card <code>.actions</code>,
          button groups) do not need these classes.
        </p>
        <h5>Independent gaps</h5>
        <p>
          The gap scale is <code>0</code>, <code>0.25rem</code>, <code>0.5rem</code>,
          <code>0.75rem</code>, <code>1rem</code>, <code>1.5rem</code> and <code>3rem</code>.
          Use <code>.gap-x-*</code> for column gaps and <code>.gap-y-*</code> for row gaps
          on grid or flex containers. They keep the native meanings of <code>column-gap</code>
          and <code>row-gap</code>, including in RTL and column-direction flex layouts.
          There are no <code>auto</code> gap values. The grid's <code>.g-*</code> classes are a separate scale.
        </p>
        <div id="axis-gap-example" class="grid-auto-fill gap-4 medium:gap-x-2" style="--grid-column-min: 8rem">
          {['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'].map(day => <div class="surface-container p-3">{day}</div>)}
        </div>
<Code code={`
<div class="grid-auto-fill gap-4 medium:gap-x-2" style="--grid-column-min: 8rem">
  <div class="surface-container p-3">Monday</div>
  <div class="surface-container p-3">Tuesday</div>
  <div class="surface-container p-3">Wednesday</div>
  <div class="surface-container p-3">Thursday</div>
  <div class="surface-container p-3">Friday</div>
  <div class="surface-container p-3">Saturday</div>
</div>
`} />
        <p>
          Both gaps start at <code>1rem</code>. From 600px, the column gap becomes <code>0.5rem</code>
          while the row gap stays <code>1rem</code>. At the same breakpoint, an axis class overrides
          <code>.gap-*</code> regardless of class order. A later breakpoint's <code>.gap-*</code> resets
          both axes; a later axis class changes only its axis. Use <code>0</code> to remove a gap.
          Avoid conflicting values from the same family at the same breakpoint.
        </p>
  </Section>
  <Section {...S.prefixes}>
        <p>
          These classes also come with a window-size prefix: display, flex direction, wrap,
          <code>.flex-1</code>, <code>.flex-none</code>, <code>.flex-initial</code>,
          <code>.shrink-0</code>, <code>.shrink-1</code>,
          <code>justify-*</code>, <code>align-*</code>, text alignment (<code>.start-align</code>,
          <code>.center-align</code>, <code>.end-align</code>), <code>.line-clamp-*</code>,
          <code>.gap-*</code>, <code>.gap-x-*</code>, <code>.gap-y-*</code>, margin, padding and <code>.hide</code>. Prefixed margin and padding cover all sides,
          <code>x</code>, <code>y</code>, top, bottom, start and end. Use start and end, not left
          and right. A prefixed class applies from that size class up and overrides the unprefixed
          one, the same way the grid's <code>m6</code> and <code>l4</code> do.
        </p>
        <table class="striped">
          <thead><tr><th>Prefix</th><th>Applies from</th></tr></thead>
          <tbody>
            <tr><td><code>medium:</code></td><td>Medium, 600px</td></tr>
            <tr><td><code>expanded:</code></td><td>Expanded, 840px</td></tr>
            <tr><td><code>large:</code></td><td>Large, 1200px</td></tr>
            <tr><td><code>extra-large:</code></td><td>Extra-large, 1600px</td></tr>
          </tbody>
        </table>
        <div class="flex flex-column gap-2 expanded:flex-row expanded:align-center expanded:justify-between surface-container p-4">
          <h5 class="title-medium my-0">Members</h5>
          <button type="button" class="tonal">Invite</button>
        </div>
<Code code={`
<!-- Stacked on Compact and Medium, one row from Expanded up. -->
<div class="flex flex-column gap-2 expanded:flex-row expanded:align-center expanded:justify-between">
  <h2 class="title-medium my-0">Members</h2>
  <button class="tonal">Invite</button>
</div>
`} />
        <p>
          A child can change its share of the space too. This filename sizes from its content
          below Expanded and takes the remaining space from 840px up. The link keeps its size.
          <code>.min-w-0</code> lets the text shrink below its content minimum so it can truncate.
          Use <code>.min-h-0</code> for a child that must shrink inside a bounded column.
        </p>
        <div id="responsive-child-sizing-demo" class="flex align-center gap-3 surface-container p-4">
          <span class="flex-initial expanded:flex-1 min-w-0 truncate">Quarterly report with a long filename.pdf</span>
          <a class="button tonal flex-none" href="#overflow">Sizing guide</a>
        </div>
<Code code={`
<div class="flex align-center gap-3">
  <span class="flex-initial expanded:flex-1 min-w-0 truncate">Quarterly report with a long filename.pdf</span>
  <a class="button tonal flex-none" href="#overflow">Sizing guide</a>
</div>
`} />
        <p>
          A prefixed <code>flex-*</code> shorthand sets grow, shrink and basis together, so
          <code>shrink-0 medium:flex-initial</code> allows shrinking from 600px up.
          Use <code>shrink-0 medium:shrink-1</code> to restore shrinking while keeping grow and
          basis. These resets assign explicit values; they do not recover an earlier component
          rule. Larger active prefixes win regardless of class order. Self-alignment, ordering
          and the other sizing helpers have no window-size prefixes.
        </p>
        <p>
          In a Sass selector, escape the colon: <code>.expanded\:flex-row</code>.
          <code>.medium:hide</code> hides from Medium up. To show something only from a size up,
          use the <a href="#hiding">hide-on classes</a>. They are <code>!important</code>, so a
          prefixed display class does not undo them.
        </p>
  </Section>
  <Section {...S.overflow}>
        <p>
          Flex and grid children can retain a minimum size based on their content.
          Clear that minimum when a child needs to shrink, truncate, or scroll.
        </p>
        <table class="striped">
          <thead><tr><th>Class</th><th>Declaration</th></tr></thead>
          <tbody>
            <tr><td><code>.min-w-0</code></td><td><code>min-width: 0</code></td></tr>
            <tr><td><code>.min-h-0</code></td><td><code>min-height: 0</code></td></tr>
            <tr><td><code>.w-full</code>, <code>.h-full</code></td><td><code>width: 100%</code>, <code>height: 100%</code></td></tr>
            <tr><td><code>.max-w-full</code></td><td><code>max-width: 100%</code></td></tr>
            <tr><td><code>.aspect-1x1</code>, <code>.aspect-4x3</code>, <code>.aspect-16x9</code></td><td><code>aspect-ratio</code>; the height follows the width</td></tr>
            <tr><td><code>.object-cover</code>, <code>.object-contain</code></td><td><code>object-fit</code> on an <code>&lt;img&gt;</code> or <code>&lt;video&gt;</code> with a set ratio</td></tr>
            <tr><td><code>.overflow-x-auto</code></td><td><code>overflow-x: auto</code></td></tr>
            <tr><td><code>.overflow-y-auto</code></td><td><code>overflow-y: auto</code></td></tr>
            <tr><td><code>.overflow-hidden</code></td><td><code>overflow: hidden</code></td></tr>
          </tbody>
        </table>
<Code code={`
<div class="flex gap-2" style="max-width: 24rem">
  <span class="flex-1 min-w-0 truncate">A long filename that must fit beside its action.pdf</span>
  <button type="button" class="flex-none">Download</button>
</div>

<section class="flex flex-column" style="height: 12rem" aria-labelledby="activity-title">
  <h2 id="activity-title" class="title-medium flex-none">Activity</h2>
  <div class="flex-1 min-h-0 overflow-y-auto p-2" tabindex="0" role="region" aria-label="Recent activity">
    <p>09:00 Report uploaded.</p>
    <p>09:15 Review requested.</p>
    <p>09:30 Comments received.</p>
    <p>09:45 Changes approved.</p>
  </div>
</section>
`} />
        <p>
          Scrolling needs a bounded size. Use <code>.overflow-x-auto</code> for wide
          tables or action rows. Give a generic scroll region <code>tabindex="0"</code>
          and an accessible name when keyboard users cannot otherwise focus and scroll it.
          Leave padding for child focus rings, such as <code>.p-2</code>.
          <code>.overflow-hidden</code> clips content and focus rings, so use it only
          when you mean to hide the clipped content.
        </p>
        <p>Use <a href="/scroll-area.html">scroll area</a> for a native scroll container with themed scrollbars.</p>
  </Section>
  <Section {...S.borders}>
        <table class="striped">
          <thead><tr><th>Class</th><th>Declaration</th></tr></thead>
          <tbody>
            <tr><td><code>.bordered</code></td><td>A 1px <code>outline-variant</code> border on every side</td></tr>
            <tr><td><code>.border-top</code>, <code>.border-bottom</code></td><td>The same border on one side</td></tr>
            <tr><td><code>.border-start</code>, <code>.border-end</code></td><td>The same border on the inline start or end, which mirrors in RTL</td></tr>
            <tr><td><code>.corner-none</code>, <code>.corner-extra-small</code>, <code>.corner-small</code>, <code>.corner-medium</code>, <code>.corner-large</code>, <code>.corner-extra-large</code>, <code>.corner-full</code></td><td><code>border-radius</code> from the matching <a href="/shapes.html#corner-scale"><code>--md-sys-shape-corner-*</code></a> token</td></tr>
            <tr><td><code>.corner-cut</code></td><td><code>corner-shape: bevel</code>. The element's corners become <a href="/shapes.html#cut-corners">straight cuts</a> of the same size. Browsers without <code>corner-shape</code> round them instead.</td></tr>
          </tbody>
        </table>
        <div class="bordered corner-large aspect-16x9 flex align-center justify-center" style="max-width: 20rem">16:9</div>
<Code code={`
<div class="bordered corner-large aspect-16x9">16:9</div>
<img class="corner-medium aspect-1x1 object-cover" src="..." alt="..." width="160">
`} />
        <p>
          These classes use other names because <code>.border</code> is the outlined card variant
          and <code>.rounded</code> is the pill button. On a component, a corner class replaces the
          component's own shape, including its pressed and selected corner changes.
        </p>
  </Section>
  <Section {...S.hiding}>
        <p>These classes hide or show content at specific screen sizes.</p>
        <table class="striped">
          <thead>
            <tr>
              <th>Class</th>
              <th>Screen range</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><code><strong>.hide</strong></code></td>
              <td>Hidden on all devices</td>
            </tr>
            <tr>
              <td><code><strong>.hide-on-compact-only</strong></code></td>
              <td>Hidden on Compact (&lt; 600px)</td>
            </tr>
            <tr>
              <td><code><strong>.hide-on-med-and-down</strong></code></td>
              <td>Hidden on Compact and Medium (&lt; 840px)</td>
            </tr>
            <tr>
              <td><code><strong>.hide-on-med-and-up</strong></code></td>
              <td>Hidden on Medium and wider (≥ 600px)</td>
            </tr>
            <tr>
              <td><code><strong>.hide-on-medium-only</strong></code></td>
              <td>Hidden on Medium (600 to 839px)</td>
            </tr>
            <tr>
              <td><code><strong>.hide-on-expanded-only</strong></code></td>
              <td>Hidden on Expanded (840 to 1199px)</td>
            </tr>
            <tr>
              <td><code><strong>.hide-on-expanded-and-up</strong></code></td>
              <td>Hidden on Expanded and wider (≥ 840px)</td>
            </tr>
            <tr>
              <td><code><strong>.hide-on-large-only</strong></code></td>
              <td>Hidden on Large (1200 to 1599px)</td>
            </tr>
            <tr>
              <td><code><strong>.hide-on-extra-large-only</strong></code></td>
              <td>Hidden on Extra-large (≥ 1600px)</td>
            </tr>
            <tr>
              <td><code><strong>.show-on-compact</strong></code></td>
              <td>Shown on Compact (&lt; 600px)</td>
            </tr>
            <tr>
              <td><code><strong>.show-on-medium</strong></code></td>
              <td>Shown on Medium (600 to 839px)</td>
            </tr>
            <tr>
              <td><code><strong>.show-on-expanded</strong></code></td>
              <td>Shown on Expanded (840 to 1199px)</td>
            </tr>
            <tr>
              <td><code><strong>.show-on-expanded-and-up</strong></code></td>
              <td>Shown on Expanded and wider (≥ 840px)</td>
            </tr>
            <tr>
              <td><code><strong>.show-on-large</strong></code></td>
              <td>Shown on Large (1200 to 1599px)</td>
            </tr>
            <tr>
              <td><code><strong>.show-on-extra-large</strong></code></td>
              <td>Shown on Extra-large (≥ 1600px)</td>
            </tr>
            <tr>
              <td><code><strong>.show-on-medium-and-up</strong></code></td>
              <td>Shown on Medium and wider (≥ 600px)</td>
            </tr>
            <tr>
              <td><code><strong>.show-on-medium-and-down</strong></code></td>
              <td>Shown on Compact and Medium (&lt; 840px)</td>
            </tr>
          </tbody>
        </table>
        <h5>Print</h5>
        <table class="striped">
          <thead><tr><th>Class</th><th>Effect</th></tr></thead>
          <tbody>
            <tr><td><code><strong>.hide-on-print</strong></code></td><td>Hidden on paper</td></tr>
            <tr><td><code><strong>.print-only</strong></code></td><td>Hidden on screen, shown on paper</td></tr>
          </tbody>
        </table>
        <p>
          Printing also uses the light scheme and hides navigation rails, navigation bars, the FAB
          menu, snackbars and tooltips. It prints the address after each external link in running
          text, and keeps headings with the content that follows them.
        </p>
        <h5>Usage</h5>
<Code code={`
<div class="hide-on-compact-only"></div>

<div class="flex hide-on-compact-only gap-2">
  <a href="/reports">Reports</a>
  <a href="/settings">Settings</a>
</div>
`} />
        <p>
          The flex example is hidden below 600px and keeps its flex layout above that
          width. Show helpers set <code>display: block !important</code> within their
          range. They do not hide content outside it. Use <code>.hide</code> with a
          show helper only when block display is appropriate.
        </p>
        <h5>Visually hidden</h5>
        <p>
          Add <code>visually-hidden</code> to remove an element from sight and
          keep it in the accessibility tree, so screen readers still announce it.
          Use it for text the layout does not show, such as context that makes
          a repeated link unique or the text of a live region. Like
          <code>.hide</code>, it is <code>!important</code>.
        </p>
        <p>
          A focused element with this class stays invisible. Do not put it on a
          focusable control unless focus is drawn somewhere else, the way a
          filter chip draws it on its label.
        </p>
<Code code={`
<a href="/orders/42">View<span class="visually-hidden"> order 42</span></a>
`} />
        <h5>Reveal on focus</h5>
        <p>
          Use <code>.visually-hidden-focusable</code> for a skip link or a container
          that should appear when it or a descendant receives focus. It applies the same
          hidden styles only while focus is outside. Do not combine it with
          <code>.visually-hidden</code>, which would keep it hidden.
        </p>
<Code code={`
<a class="visually-hidden-focusable" href="#main-content">Skip to content</a>
<main id="main-content" tabindex="-1">
  <h1>Page content</h1>
</main>
`} />
  </Section>
  <Section {...S.spacing}>
        <p>
