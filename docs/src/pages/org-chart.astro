---
import DocsLayout from "../layouts/DocsLayout.astro";
import PageBody from "../components/PageBody.astro";
import Section from "../components/Section.astro";
import Code from "../components/Code.astro";
import TokenTable from "../components/api/TokenTable.astro";
import { defineSections } from "../lib/sections";

const S = defineSections([
  { id: "anatomy", label: "Anatomy", heading: false },
  { id: "links", label: "Linked profiles" },
  { id: "accessibility", label: "Accessibility" },
  { id: "tokens", label: "Tokens" },
]);

type Person = { role: string; name: string; photo: number; reports?: Person[] };
const staff: Person = {
  role: "CIO", name: "Marisol Okafor", photo: 64, reports: [
    { role: "Manager", name: "Tobias Lindqvist", photo: 91, reports: [
      { role: "SE", name: "Priya Raman", photo: 65 },
    ] },
    { role: "Director", name: "Desmond Achebe", photo: 177, reports: [
      { role: "PM", name: "Lena Kowalczyk", photo: 338, reports: [
        { role: "Operations", name: "Rafael Montoya", photo: 342 },
        { role: "Development", name: "Hana Sato", photo: 334 },
      ] },
    ] },
    { role: "Manager", name: "Oliver Brennan", photo: 1005, reports: [
      { role: "SA", name: "Amara Nwosu", photo: 823 },
      { role: "SP", name: "Felix Duarte", photo: 836 },
    ] },
    { role: "R&D", name: "Ingrid Halvorsen", photo: 996 },
  ],
};

const node = (p: Person, tag: string) =>
  `<${tag} class="org-chart-node"><span class="org-chart-role">${p.role.replace("&", "&amp;")}</span>` +
  `<img class="avatar large" src="https://picsum.photos/id/${p.photo}/112/112" alt="" width="56" height="56">` +
  `<span class="org-chart-name">${p.name}</span></${tag}>`;
const item = (p: Person): string => p.reports
  ? `<li><details open>${node(p, "summary")}<ul>${p.reports.map(item).join("")}</ul></details></li>`
  : `<li>${node(p, "div")}</li>`;
const chart = `<ul class="org-chart" aria-label="Company staff">${item(staff)}</ul>`;
---
<DocsLayout page="org-chart">
<PageBody sections={S}>
  <Section {...S.anatomy}>
        <p class="flow-text">
          A <code>&lt;ul class="org-chart"&gt;</code> draws a reporting line
          top down, with each person as a card under their manager.
        </p>
        <p>
          Write each person as an <code>&lt;li&gt;</code>. A person with
          reports holds a <code>&lt;details open&gt;</code>. Its
          <code>&lt;summary class="org-chart-node"&gt;</code> is the card and
          its nested <code>&lt;ul&gt;</code> holds the reports, so selecting a
          card folds the team away. A person without reports holds a
          <code>&lt;div class="org-chart-node"&gt;</code>.
        </p>
        <p>
          A card stacks an optional <code>.org-chart-role</code> band first,
          then an <code>.avatar</code> and an <code>.org-chart-name</code>.
          The stylesheet draws the lines between cards. A chart wider than its
          container scrolls sideways inside the list. The org chart is CSS only.
        </p>
        <div set:html={chart} />
<Code code={`
<ul class="org-chart" aria-label="Company staff">
  <li>
    <details open>
      <summary class="org-chart-node">
        <span class="org-chart-role">CIO</span>
        <img class="avatar large" src="marisol.jpg" alt="">
        <span class="org-chart-name">Marisol Okafor</span>
      </summary>
      <ul>
        <li>
          <div class="org-chart-node">
            <span class="org-chart-role">R&amp;D</span>
            <span class="avatar large" aria-hidden="true">IH</span>
            <span class="org-chart-name">Ingrid Halvorsen</span>
          </div>
        </li>
      </ul>
    </details>
  </li>
</ul>
`} />
  </Section>
  <Section {...S.links}>
        <p>
          To link a person without reports to their profile, write the card
          as <code>&lt;a class="org-chart-node"&gt;</code>. Keep a
          manager's card a <code>&lt;summary&gt;</code>, because a link inside
          a summary competes with opening the team. Put a profile link for a
          manager elsewhere on the page.
        </p>
<Code code={`
<li>
  <a class="org-chart-node" href="/people/ingrid-halvorsen">
    <span class="org-chart-role">R&amp;D</span>
    <img class="avatar large" src="ingrid.jpg" alt="">
    <span class="org-chart-name">Ingrid Halvorsen</span>
  </a>
</li>
`} />
  </Section>
  <Section {...S.accessibility}>
        <p>
          Name the root list with <code>aria-label</code>. The nested lists
          carry the hierarchy, so a screen reader announces each list's size
          and level. The drawn lines stay silent. When the name follows the
          avatar, give an avatar image an empty <code>alt</code> and an
          initials avatar <code>aria-hidden="true"</code>. Otherwise the
          screen reader reads the name twice.
        </p>
        <p>
          Each manager is a Tab stop, and Enter or Space opens or closes the
          team. The chart takes no <code>role="tree"</code>, for the same
          reason as the <a href="tree.html">tree</a>. That role promises
          arrow-key navigation that native disclosures do not provide.
        </p>
  </Section>
  <Section {...S.tokens}>
        <p>Override these on the <code>.org-chart</code>.</p>
        <TokenTable>
          <tr><td><code>--md-comp-org-chart-line-color</code></td><td><code>--md-sys-color-outline-variant</code></td></tr>
          <tr><td><code>--md-comp-org-chart-line-length</code></td><td>24px</td></tr>
          <tr><td><code>--md-comp-org-chart-gap</code></td><td>16px</td></tr>
          <tr><td><code>--md-comp-org-chart-node-container-color</code></td><td><code>--md-sys-color-surface-container-high</code></td></tr>
          <tr><td><code>--md-comp-org-chart-node-shape</code></td><td>12px</td></tr>
          <tr><td><code>--md-comp-org-chart-role-container-color</code></td><td><code>--md-sys-color-primary-container</code></td></tr>
          <tr><td><code>--md-comp-org-chart-role-color</code></td><td><code>--md-sys-color-on-primary-container</code></td></tr>
        </TokenTable>
  </Section>
</PageBody>
</DocsLayout>
