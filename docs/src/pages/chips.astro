---
import DocsLayout from "../layouts/DocsLayout.astro";
import PageBody from "../components/PageBody.astro";
import Section from "../components/Section.astro";
import Code from "../components/Code.astro";
import InstanceNote from "../components/api/InstanceNote.astro";
import OptionsTable from "../components/api/OptionsTable.astro";
import PropertiesTable from "../components/api/PropertiesTable.astro";
import { defineSections } from "../lib/sections";

const S = defineSections([
  { id: "introduction", label: "Introduction", heading: false },
  { id: "contact", label: "Contacts" },
  { id: "tag", label: "Tags" },
  { id: "basic", label: "Plugin", heading: "JavaScript plugin" },
  { id: "initialization", label: "Initialization" },
  { id: "options", label: "Options" },
  { id: "methods", label: "Methods" },
  { id: "properties", label: "Properties" },
]);
---
<DocsLayout page="chips">
<PageBody sections={S}>
  <Section {...S.introduction}>
        <p class="flow-text">
          Add <code>.chip</code> to an element to make a chip. The element you pick
          sets which kind it is. The four Material 3 chip types and a non-interactive
          display chip use three root elements. Add <code>outlined</code> for a
          bordered style. Static chips are CSS only. The JavaScript plugin attaches
          to a <code>.chips</code> wrapper.
        </p>
        <p>
          A long label wraps and the chip grows from its 32dp minimum, with 4dp
          above and below the lines. It never grows wider than its parent.
        </p>
        <table>
          <thead>
            <tr><th>Type</th><th>Element</th><th>Why</th></tr>
          </thead>
          <tbody>
            <tr>
              <td>Display</td>
              <td><code>&lt;span class="chip"&gt;</code></td>
              <td>Presents information. It is not a control and is not in the tab order.</td>
            </tr>
            <tr>
              <td>Assist, suggestion</td>
              <td><code>&lt;button type="button" class="chip"&gt;</code></td>
              <td>One action on press.</td>
            </tr>
            <tr>
              <td>Filter</td>
              <td><code>&lt;input type="checkbox" class="chip-input"&gt;</code> + <code>&lt;label class="chip"&gt;</code></td>
              <td>Multi-select and toggleable, and it carries a value into the form without JavaScript.</td>
            </tr>
            <tr>
              <td>Input</td>
              <td><code>&lt;span class="chip"&gt;</code> + a nested <code>&lt;button class="close"&gt;</code></td>
              <td>The chip is a token. The delete button is the control.</td>
            </tr>
          </tbody>
        </table>
        <div class="chips mb-5">
          <span class="chip outlined">Information</span>
          <span class="chip">
            <img src="https://picsum.photos/id/64/100/100" alt=""> Jane Doe
          </span>
          <button type="button" class="chip">
            <span class="material-symbols" aria-hidden="true">event</span>
            Add to calendar
          </button>
          <input type="checkbox" class="chip-input" id="demo-filter-flights">
          <label class="chip" for="demo-filter-flights">
            <span class="material-symbols" aria-hidden="true">check</span>
            Flights
          </label>
          <span class="chip">
            Tag
            <button type="button" class="close" aria-label="Remove Tag">
              <span class="material-symbols" aria-hidden="true">close</span>
            </button>
          </span>
        </div>
<Code code={`
<span class="chip outlined">Information</span>

<span class="chip">
  <img src="photo.jpg" alt=""> Jane Doe
</span>

<button type="button" class="chip">
  <span class="material-symbols" aria-hidden="true">event</span>
  Add to calendar
</button>

<input type="checkbox" class="chip-input" id="filter-flights">
<label class="chip" for="filter-flights">
  <span class="material-symbols" aria-hidden="true">check</span>
  Flights
</label>

<span class="chip">
  Tag
  <button type="button" class="close" aria-label="Remove Tag">
    <span class="material-symbols" aria-hidden="true">close</span>
  </button>
</span>
`} />
        <p>
          The delete button needs its own <code>aria-label</code> naming the chip it
          removes, because its only content is an icon. Mark the icon
          <code>aria-hidden</code> in every chip. The ligature is real text, and
          screen readers would otherwise read it out alongside the label.
        </p>
        <p>
          A filter chip's selected state is <code>:checked</code> on its input, so it
          needs no script. Everywhere else, add the <code>selected</code> class for
          the selected look.
        </p>
        <p>
          Clicking <code>.close</code> removes the chip only when it sits inside a
          <code>.chips</code> container. Importing the bundle runs
          <code>Chips.Init()</code> on <code>DOMContentLoaded</code>, which wires that
          click. A lone <code>.chip</code> does not remove itself.
        </p>
        <p>
          Before 0.8.0 every chip was a <code>&lt;div class="chip"&gt;</code> and the
          delete control was an <code>&lt;i class="close"&gt;</code>, focusable through
          <code>tabindex</code> but with no role or name. In 1.0 that
          <code>&lt;i&gt;</code> is no longer an icon and shows the word
          "close". Use the <code>&lt;button class="close"&gt;</code> shown here instead.
        </p>
  </Section>

  <Section {...S.contact}>
        <p>
          Put an image inside the chip. The name next to it is the accessible name
          already, so the image is decorative and takes <code>alt=""</code>.
        </p>
        <span class="chip mb-3">
          <img src="https://picsum.photos/id/64/100/100" alt="">
          Jane Doe
        </span>
<Code code={`
<span class="chip">
  <img src="photo.jpg" alt="">
  Jane Doe
</span>
`} />
  </Section>

  <Section {...S.tag}>
        <p>
          Put a <code>button.close</code> inside the chip. Give it
          <code>type="button"</code> so it cannot submit a surrounding form, and an
          <code>aria-label</code> naming what it removes.
        </p>
        <div class="chips mb-3">
          <span class="chip">
            Tag
            <button type="button" class="close" aria-label="Remove Tag">
              <span class="material-symbols" aria-hidden="true">close</span>
            </button>
          </span>
        </div>
<Code code={`
<span class="chip">
  Tag
  <button type="button" class="close" aria-label="Remove Tag">
    <span class="material-symbols" aria-hidden="true">close</span>
  </button>
</span>
`} />
  </Section>

  <Section {...S.basic}>
        <p>
          The plugin turns a <code>.chips</code> container into an editable tag field.
          Type a value and press Enter to add a chip. Delete with the chip's delete
          button, or select a chip and press Backspace or Delete. Selecting a chip
          marks it <code>selected</code> and moves focus to its delete button.
        </p>
        <p>
          Backspace and Delete remove the focused chip and select the remaining chip
          before it, or else the first remaining chip or the input. Activating a delete
          button returns focus to the input. Deleting a chip from code does not move
          focus that is elsewhere. A deletion callback can move focus without the
          plugin resetting it.
          Long labels wrap while the delete control keeps its size.
        </p>
        <p>
          <code>allowUserInput</code> defaults to <code>false</code>. Without it there
          is no text field and rendered chips have no delete button. Pass
          <code>allowUserInput: true</code> for the interactive field.
          <code>AutoInit()</code> starts every <code>.chips</code> except
          those with <code>no-autoinit</code>. It uses the defaults, so those
          wrappers stay display-only until you call <code>init</code> with options.
        </p>
        <p>
          In a form, give the field's <code>&lt;input&gt;</code> a <code>name</code>.
          The chips submit under it, one <code>id</code> per chip, as a multiple
          select does. <code>init</code> wraps the input in an
          <code>&lt;expressive-chips-control&gt;</code>, a form-associated custom
          element with <code>display: contents</code>. It moves the name onto that
          element, so half-typed text is not submitted. The form treats the control
          as the field.
        </p>
        <p>
          A disabled <code>fieldset</code> or a form reset applies to the control at
          once, including in a detached form or a shadow root. A canceled reset
          changes nothing. Setting <code>disabled</code>, <code>readonly</code> or
          <code>form</code> on the input applies at the next microtask.
        </p>
        <p>
          A <code>required</code> input makes the field valid once it has a chip.
          Until then the field reports <code>i18n.required</code>, unless the input is
          read-only. The control holds that validity apart from any error the page
          sets on the input, and a blocked submit focuses the input. The input itself
          stays valid and does not match <code>:invalid</code>, so style or report the
          error from the control or the form. The input keeps
          <code>aria-required="true"</code>.
        </p>
        <p>
          <code>destroy()</code> unwraps the input and gives its name and
          <code>required</code> back. Without form-associated custom elements, as in
          jsdom, the plugin leaves the input as it is and the input submits its own
          text.
        </p>
        <p>
          Pasting text that lists values, split by commas, tabs or new lines, adds a
          chip for each, up to <code>limit</code>. An <code>autocompleteOnly</code>
          field pastes as text. With <code>allowCreate: true</code> in
          <code>autocompleteOptions</code>, choosing the "Add" row adds the typed text
          as a chip, in an <code>autocompleteOnly</code> field too. The plugin then
          calls the page's own <code>onCreate</code>.
        </p>
<Code code={`
<form>
  <div class="chips">
    <input name="tags">
  </div>
</form>
<!-- Submits tags=red&tags=blue -->
`} />
        <p>An empty field. Type a tag and press Enter:</p>
        <div id="chips-empty" class="chips no-autoinit mb-5"></div>
        <p>Initial tags from the <code>data</code> option:</p>
        <div id="chips-initial" class="chips no-autoinit mb-5"></div>
        <p>Placeholders when the field is empty and after the first tag:</p>
        <div id="chips-placeholder" class="chips no-autoinit mb-5"></div>
        <p>Autocomplete suggestions while typing:</p>
        <div id="chips-autocomplete" class="chips no-autoinit mb-5"></div>
<Code code={`
<div class="chips"></div>
<div class="chips chips-initial"></div>
<div class="chips chips-placeholder"></div>
<div class="chips chips-autocomplete"></div>
<!-- Optional: provide your own input -->
<div class="chips">
  <input class="custom-class">
</div>
`} />
        <p>
          The classes <code>chips-initial</code>, <code>chips-placeholder</code>, and
          <code>chips-autocomplete</code> are only hooks for your selectors. They have
          no styles of their own.
        </p>
  </Section>

  <Section {...S.initialization}>
        <p>
          The IIFE bundle exposes <code>Expressive.Chips</code>.
          Call <code>init</code> with <code>allowUserInput: true</code>, plus any other
          options, for an editable field. Re-init after you add a container dynamically.
          Autocomplete keeps the query while filtering and clears it after the user selects an item.
        </p>
<Code code={`
document.addEventListener('DOMContentLoaded', function() {
  const elems = document.querySelectorAll('.chips');
  const instances = Expressive.Chips.init(elems, {
    allowUserInput: true,
    placeholder: 'Enter a tag',
    secondaryPlaceholder: '+Tag',
    autocompleteOptions: {
      data: [
        { id: 12, text: 'Apple' },
        { id: 13, text: 'Microsoft' },
        { id: 42, text: 'Google', image: 'https://picsum.photos/id/64/250/250' }
      ]
    }
  });
});
`} />
        <p>A chip data object looks like this. <code>id</code> is required, and the plugin does not render a chip without one.</p>
<Code code={`
const chip = {
  id: '4711',
  text: 'Title',
  image: ''
};
`} />
  </Section>

  <Section {...S.options}>
        <OptionsTable>
            <tr>
              <td><code>data</code></td>
              <td>Array</td>
              <td><code>[]</code></td>
              <td>Initial chips. Each item is a chip data object.</td>
            </tr>
            <tr>
              <td><code>placeholder</code></td>
              <td>String</td>
              <td><code>''</code></td>
              <td>Placeholder when there are no chips. Requires <code>allowUserInput</code>.</td>
            </tr>
            <tr>
              <td><code>secondaryPlaceholder</code></td>
              <td>String</td>
              <td><code>''</code></td>
              <td>Placeholder after at least one chip exists.</td>
            </tr>
            <tr>
              <td><code>closeIconClass</code></td>
              <td>String</td>
              <td><code>'material-symbols'</code></td>
              <td>Class on the icon inside the delete button.</td>
            </tr>
            <tr>
              <td><code>allowUserInput</code></td>
              <td>Boolean</td>
              <td><code>false</code></td>
              <td>If true, render a text field and a delete button per chip, so the user can add and remove chips.</td>
            </tr>
            <tr>
              <td><code>i18n</code></td>
              <td>Object</td>
              <td><code>&#123; remove: 'Remove', required: 'Add at least one item.' &#125;</code></td>
              <td>Strings the component generates. <code>remove</code> prefixes the delete button's accessible name, giving "Remove Apple". <code>required</code> is what a required field says while it has no chips.</td>
            </tr>
            <tr>
              <td><code>autocompleteOptions</code></td>
              <td>Object</td>
              <td><code>&#123;&#125;</code></td>
              <td>Options passed to Autocomplete on the input. A non-empty object enables autocomplete.</td>
            </tr>
            <tr>
              <td><code>autocompleteOnly</code></td>
              <td>Boolean</td>
              <td><code>false</code></td>
              <td>If true, Enter will not add a value that is not in the autocomplete list. An "Add" row from <code>allowCreate</code> still adds its text.</td>
            </tr>
            <tr>
              <td><code>limit</code></td>
              <td>Number</td>
              <td><code>Infinity</code></td>
              <td>Maximum number of chips.</td>
            </tr>
            <tr>
              <td><code>onChipAdd</code></td>
              <td>Function</td>
              <td><code>null</code></td>
              <td>Called after a chip is added. Receives the container and the chip element.</td>
            </tr>
            <tr>
              <td><code>onChipSelect</code></td>
              <td>Function</td>
              <td><code>null</code></td>
              <td>Called when a chip is selected. Receives the container and the chip element.</td>
            </tr>
            <tr>
              <td><code>onChipDelete</code></td>
              <td>Function</td>
              <td><code>null</code></td>
              <td>Called after a chip is deleted. Receives the container and the chip element.</td>
            </tr>
        </OptionsTable>
  </Section>

  <Section {...S.methods}>
        <InstanceNote plugin="Chips" />

        <h5 class="light">.addChip();</h5>
        <p>Add a chip, including when <code>allowUserInput</code> is false. Numeric id <code>0</code> is valid. Ignored if <code>id</code> is missing, already present, or the limit is reached.</p>
<Code code={`
instance.addChip({
  id: 1337,
  text: 'John Doe',
  image: ''
});
`} />

        <h5 class="light">.deleteChip();</h5>
        <p>Delete the chip at this index.</p>
<Code code={`
instance.deleteChip(3);
`} />

        <h5 class="light">.selectChip();</h5>
        <p>Focus the chip at this index.</p>
<Code code={`
instance.selectChip(2);
`} />

        <h5 class="light">.getData();</h5>
        <p>Return the current chips as an array of chip data objects.</p>
<Code code={`
instance.getData();
`} />

        <h5 class="light">.destroy();</h5>
        <p>Destroy the plugin instance, remove rendered chips, and tear down its event handlers. This also destroys the owned Autocomplete and its Menu.</p>
<Code code={`
instance.destroy();
`} />
  </Section>

  <Section {...S.properties}>
        <PropertiesTable el="The container the plugin was initialized with.">
            <tr>
              <td><code>chipsData</code></td>
              <td>Array</td>
              <td>The current chip data.</td>
            </tr>
            <tr>
              <td><code>hasAutocomplete</code></td>
              <td>Boolean</td>
              <td>Whether autocomplete is enabled.</td>
            </tr>
            <tr>
              <td><code>autocomplete</code></td>
              <td>Autocomplete</td>
              <td>The Autocomplete instance, if any.</td>
            </tr>
        </PropertiesTable>
  </Section>

</PageBody>
</DocsLayout>
