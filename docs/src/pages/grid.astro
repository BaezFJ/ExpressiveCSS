---
import DocsLayout from "../layouts/DocsLayout.astro";
import PageBody from "../components/PageBody.astro";
import Section from "../components/Section.astro";
import Code from "../components/Code.astro";
import { defineSections } from "../lib/sections";

const S = defineSections([
  { id: "grid-container", label: "Container", heading: false },
  { id: "grid-intro", label: "Introduction" },
  { id: "grid-offsets", label: "Offsets", tag: "h2" },
  { id: "grid-gaps", label: "Gaps", tag: "h2" },
  { id: "grid-push", label: "Push and pull", tag: "h2" },
  { id: "grid-layouts", label: "Creating layouts" },
  { id: "grid-responsive", label: "Responsive layouts", heading: "Creating responsive layouts" },
]);
---
<DocsLayout page="grid">
<PageBody sections={S}>
  <Section {...S["grid-container"]}>
                    <p class="flow-text">ExpressiveCSS uses a standard 12-column fluid responsive grid to help
                        you lay out your page.</p>
                    <h3>Container</h3>
                    <p>
                        The container class is not strictly part of the grid, but it matters for laying out content. It
                        centers the page and caps how wide it can grow, so a paragraph does not stretch across a 4K
                        monitor. Width is a percentage of the viewport (90% on Compact, 85% from Medium, 70% from
                        Expanded, 75% from Extra-large). A max-width token caps that percentage:
                        <code>1280px</code> by default and <code>1920px</code> from the extra-large breakpoint
                        (1600px). Override the tokens, or pick a modifier:
                    </p>
                    <ul>
                        <li><code>container</code> is the default, capped at 1280px and then 1920px.</li>
                        <li><code>container wide</code> raises the cap to 2400px, for dashboards and media.</li>
                        <li><code>container max</code> uses the percentage with no cap.</li>
                    </ul>

                    <h5>Demo</h5>
                    <p>Try the button below to see what the page looks like without containers.</p>
                    <a id="container-toggle-button" class="button tonal">Turn off Containers</a>

                    <div class="row">
                        <div class="s12">
                            <div class="browser-window">
                                <div class="surface-container-highest">
                                    <div class="browser-circles">
                                        <div class="circle error"></div>
                                        <div class="circle secondary"></div>
                                        <div class="circle tertiary"></div>
                                    </div>
                                </div>
                                <div>
                                    <div class="row g-0">
                                        <div class="site-layout-top s12 primary"></div>
                                        <div class="site-layout-pane s12 primary-container">
                                            <div class="container">
                                                <p class="docs-bar small surface"></p>
                                                <p class="docs-bar full surface"></p>
                                                <p class="docs-bar full surface"></p>
                                                <p class="docs-bar full surface"></p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <p>
                        To add a container, put your content inside a
                        <code>&lt;div&gt;</code>
                        tag with a <code>container</code> class. Here's an example of how your page might be set up.
                    </p>

                    <Code code={`
<body>
  <div class="container">
    <!-- Page Content goes here -->
  </div>
</body>

<!-- dashboard / media that should keep growing -->
<div class="container wide">…</div>

<!-- percentage only, no cap -->
<div class="container max">…</div>
`} />
  </Section>
  <Section {...S["grid-intro"]}>
                    <p>This section shows how the grid works.</p>
                    <h5>12 columns</h5>
                    <p>The grid has 12 columns. At every browser size, the columns have equal
                        widths.</p>
                    <div class="row">
                        <div class="s1 primary-container on-primary-container-text center-align py-3">1</div>
                        <div class="s1 primary-container on-primary-container-text center-align py-3">2</div>
                        <div class="s1 primary-container on-primary-container-text center-align py-3">3</div>
                        <div class="s1 primary-container on-primary-container-text center-align py-3">4</div>
                        <div class="s1 primary-container on-primary-container-text center-align py-3">5</div>
                        <div class="s1 primary-container on-primary-container-text center-align py-3">6</div>
                        <div class="s1 primary-container on-primary-container-text center-align py-3">7</div>
                        <div class="s1 primary-container on-primary-container-text center-align py-3">8</div>
                        <div class="s1 primary-container on-primary-container-text center-align py-3">9</div>
                        <div class="s1 primary-container on-primary-container-text center-align py-3">10</div>
                        <div class="s1 primary-container on-primary-container-text center-align py-3">11</div>
                        <div class="s1 primary-container on-primary-container-text center-align py-3">12</div>
                    </div>
                    <p>The HTML below produces a result similar to the one above.</p>
                    <Code code={`
<div class="row">
  <div class="s1">1</div>
  <div class="s1">2</div>
  <div class="s1">3</div>
  <div class="s1">4</div>
  <div class="s1">5</div>
  <div class="s1">6</div>
  <div class="s1">7</div>
  <div class="s1">8</div>
  <div class="s1">9</div>
  <div class="s1">10</div>
  <div class="s1">11</div>
  <div class="s1">12</div>
</div>
`} />
                    <p>
                        Note: <code>s1</code> is one column wide at the default Compact size and up.
                    </p>

                    <h5>Columns live inside rows</h5>
                    <p>
                        All columns must be inside a row. Size
                        each inner div with a
                        screen-prefix class such as <code>s12</code> or <code>m6</code>.
                    </p>
                    <div class="row">
                        <div class="s12 primary-container on-primary-container-text center-align py-3">
                            <span class="flow-text">This div is 12-columns wide on all screen sizes</span>
                        </div>
                        <div class="s6 primary-container on-primary-container-text center-align py-3">
                            <span class="flow-text">6-columns (one-half)</span>
                        </div>
                        <div class="s6 primary-container on-primary-container-text center-align py-3">
                            <span class="flow-text">6-columns (one-half)</span>
                        </div>
                    </div>
                    <Code code={`
<div class="row">
  <div class="s12">This div is 12-columns wide on all screen sizes</div>
  <div class="s6">6-columns (one-half)</div>
  <div class="s6">6-columns (one-half)</div>
</div>
`} />
  </Section>
  <Section {...S["grid-offsets"]}>
                    <p>
                        To offset a column, add a class such as
                        <code>offset-s2</code>, where <code>s</code> is the screen class prefix (s =
                        Compact, m = Medium, l = Expanded, xl = Large, xxl = Extra-large) and the number is how
                        many columns to offset by.
                    </p>
                    <p class="error-text">
                        Offsets count from the left edge of the row, not from the previous column. For relative
                        offsets, add empty columns to the row.
                    </p>

                    <div class="row">
                        <div class="s12 primary-container on-primary-container-text center-align py-3">
                            <span class="flow-text">This div is 12-columns wide on all screen sizes</span>
                        </div>
                        <div class="s6 offset-s6 primary-container on-primary-container-text center-align py-3">
                            <span class="flow-text">6-columns (offset-by-6)</span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="l6 primary-container on-primary-container-text center-align py-3">
                            <span class="flow-text">l6 column</span>
                        </div>
                        <div class="l4 offset-l8 primary-container on-primary-container-text center-align py-3">
                            <span class="flow-text">l4 column (offset-l8)</span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="l2 offset-l3 primary-container on-primary-container-text center-align py-3">
                            offset-l3
                        </div>
                        <div class="l2 offset-l6 primary-container on-primary-container-text center-align py-3">
                            offset-l6
                        </div>
                        <div class="l2 offset-l9 primary-container on-primary-container-text center-align py-3">
                            offset-l9
                        </div>
                    </div>
                    <div class="row">
                        <div class="l2 primary-container on-primary-container-text center-align py-3">col</div>
                        <div class="l2"></div>
                        <div class="l2 primary-container on-primary-container-text center-align py-3">relative offset
                            2
                        </div>
                    </div>

                    <Code code={`
<div class="row">
  <div class="s12">This div is 12-columns wide on all screen sizes</div>
  <div class="s6 offset-s6">6-columns (offset-by-6)</div>
</div>
<div class="row">
  <div class="l6">l6 column</div>
  <div class="l4 offset-l8">l4 column (offset-l8)</div>
</div>
<div class="row">
  <div class="l2 offset-l3">offset-l3</div>
  <div class="l2 offset-l6">offset-l6</div>
  <div class="l2 offset-l9">offset-l9</div>
</div>
<div class="row">
  <div class="l2">col</div>
  <div class="l2"></div>
  <div class="l2">relative offset 2</div>
</div>
`} />
  </Section>
  <Section {...S["grid-gaps"]}>
                    <p>
                        Columns have a default gap (g-3). To change it, add one of
                        <code>g-0</code> to <code>g-5</code> to the element with the <code>row</code> class.
                    </p>

                    <p>Standard gap (g-3)</p>
                    <div class="row">
                        <div class="s3 primary-container on-primary-container-text center-align py-3">1</div>
                        <div class="s3 primary-container on-primary-container-text center-align py-3">2</div>
                        <div class="s3 primary-container on-primary-container-text center-align py-3">3</div>
                        <div class="s3 primary-container on-primary-container-text center-align py-3">4</div>
                    </div>

                    <p>No gap (g-0)</p>
                    <div class="row g-0">
                        <div class="s4 primary-container on-primary-container-text center-align py-3">1</div>
                        <div class="s4 primary-container on-primary-container-text center-align py-3">2</div>
                        <div class="s4 primary-container on-primary-container-text center-align py-3">3</div>
                    </div>

                    <p>Bigger gap (g-4)</p>
                    <div class="row g-4">
                        <div class="s4 primary-container on-primary-container-text center-align py-3">1</div>
                        <div class="s4 primary-container on-primary-container-text center-align py-3">2</div>
                        <div class="s4 primary-container on-primary-container-text center-align py-3">3</div>
                    </div>

                    <Code code={`
<div class="row g-4">
  <div class="s4">1</div>
  <div class="s4">2</div>
  <div class="s4">3</div>
</div>
`} />
  </Section>
  <Section {...S["grid-push"]}>
                    <p class="error-text">Deprecated. The grid now uses CSS Grid, so change placement with offsets
                        or empty columns.</p>
                    <p>
                        Older versions reordered columns with
                        <code>push-s2</code> or <code>pull-s2</code>, where <code>s</code> is the screen class-prefix
                        and the number is how many
                        columns to push or pull by. Those classes are no longer part of the grid.
                    </p>
  </Section>
  <Section {...S["grid-layouts"]}>
                    <p>
                        These examples build some common layouts with the grid. To keep them simple, they are not
                        responsive.
                    </p>
                    <div class="row">
                        <div class="s12 m6">
                            <h5>Section</h5>
                            <p>
                                The <code>section</code> class adds top and bottom padding. Add it to divs that
                                contain large blocks of content.
                            </p>
                        </div>
                        <div class="s12 m6">
                            <h5>Divider</h5>
                            <p>
                                Dividers are 1 pixel lines that separate content. Add the
                                <code>divider</code> class to a div between blocks of content.
                            </p>
                        </div>
                    </div>

                    <h5>Example sections and dividers</h5>
                    <div class="divider"></div>
                    <div class="section">
                        <h5>Section 1</h5>
                        <p>Stuff</p>
                    </div>
                    <div class="divider"></div>
                    <div class="section">
                        <h5>Section 2</h5>
                        <p>Stuff</p>
                    </div>
                    <div class="divider"></div>
                    <div class="section">
                        <h5>Section 3</h5>
                        <p>Stuff</p>
                    </div>
                    <div class="divider"></div>
                    <Code code={`
<div class="divider"></div>
<div class="section">
  <h5>Section 1</h5>
  <p>Stuff</p>
</div>
<div class="divider"></div>
<div class="section">
  <h5>Section 2</h5>
  <p>Stuff</p>
</div>
<div class="divider"></div>
<div class="section">
  <h5>Section 3</h5>
  <p>Stuff</p>
</div>
`} />

                    <h5>Example promotion table</h5>
                    <p>
                        For 3 divs of equal size, give each a width of 4 columns, since 4+4+4 adds up to 12. Put your
                        content inside those divs.
                    </p>
                    <div class="row">
                        <div class="s4">
                            <div class="center-align">
                                <span class="material-symbols medium primary-text" aria-hidden="true">flash_on</span>
                                <p class="title-medium">Speeds up development</p>
                                <p class="light">
                                    Most of the heavy lifting is done for you to provide default stylings that
                                    incorporate our custom components. We also refined animations and transitions
                                    to provide a smoother experience for developers.
                                </p>
                            </div>
                        </div>
                        <div class="s4">
                            <div class="center-align">
                                <span class="material-symbols medium primary-text" aria-hidden="true">group</span>
                                <p class="title-medium">User Experience Focused</p>
                                <p class="light">By utilizing elements and principles of Material Design, we were able
                                    to create a framework that focuses on User Experience.</p>
                            </div>
                        </div>
                        <div class="s4">
                            <div class="center-align">
                                <span class="material-symbols medium primary-text" aria-hidden="true">settings</span>
                                <p class="title-medium">Easy to work with</p>
                                <p class="light">We have provided detailed documentation as well as specific code
                                    examples to help new users get started.</p>
                            </div>
                        </div>
                    </div>

                    <Code code={`
<div class="row">
  <div class="s4">
    <!-- Promo Content 1 goes here -->
  </div>
  <div class="s4">
    <!-- Promo Content 2 goes here -->
  </div>
  <div class="s4">
    <!-- Promo Content 3 goes here -->
  </div>
</div>
`} />

                    <h5>Example side navigation layout</h5>
                    <p>For an even layout, make sure your column numbers add up to 12.</p>

                    <div class="row">
                        <div class="s12">
                            <div class="browser-window">
                                <div class="surface-container-highest">
                                    <div class="browser-circles">
                                        <div class="circle error"></div>
                                        <div class="circle secondary"></div>
                                        <div class="circle tertiary"></div>
                                    </div>
                                </div>
                                <div>
                                    <div class="row g-0">
                                        <div class="site-layout-top s12 primary"></div>
                                        <div class="site-layout-pane s3 surface-container-highest">
                                            <p class="docs-bar surface"></p>
                                            <p class="docs-bar surface"></p>
                                            <p class="docs-bar surface"></p>
                                        </div>
                                        <div class="site-layout-pane s9 primary-container">
                                            <p class="docs-bar surface"></p>
                                            <p class="docs-bar surface"></p>
                                            <p class="docs-bar surface"></p>
                                            <p class="docs-bar surface"></p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <Code code={`
<!-- Navbar goes here -->
<!-- Page Layout here -->
<div class="row">
  <div class="s3">
    <!-- Grey navigation panel -->
  </div>
  <div class="s9">
    <!-- Teal page content -->
  </div>
</div>
`} />
  </Section>
  <Section {...S["grid-responsive"]}>
                    <p>The examples above lay out elements with the grid. This section shows how to make those
                        layouts adapt to each screen size.</p>
                    <h5>Screen sizes</h5>
                    <div class="docs-table-scroll">
                    <table class="highlight">
                        <thead>
                        <tr>
                            <th></th>
                            <th>Compact &lt; 600px</th>
                            <th>Medium 600 to 839px</th>
                            <th>Expanded 840 to 1199px</th>
                            <th>Large 1200 to 1599px</th>
                            <th>Extra-large ≥ 1600px</th>
                        </tr>
                        </thead>
                        <tbody>
                        <tr>
                            <td><strong>Class prefix</strong></td>
                            <td><code>.s</code></td>
                            <td><code>.m</code></td>
                            <td><code>.l</code></td>
                            <td><code>.xl</code></td>
                            <td><code>.xxl</code></td>
                        </tr>
                        <tr>
                            <td><strong>Container width</strong></td>
                            <td>90%</td>
                            <td>85%</td>
                            <td>70%</td>
                            <td>70%</td>
                            <td>75%</td>
                        </tr>
                        <tr>
                            <td><strong>Max width</strong></td>
                            <td>1280px</td>
                            <td>1280px</td>
                            <td>1280px</td>
                            <td>1280px</td>
                            <td>1920px</td>
                        </tr>
                        <tr>
                            <td><strong>Number of columns</strong></td>
                            <td>12</td>
                            <td>12</td>
                            <td>12</td>
                            <td>12</td>
                            <td>12</td>
                        </tr>
                        </tbody>
                    </table>
                    </div>
                    <p>
                        Widescreen is Material's extra-large window class. The grid keeps twelve columns there. A 4K
                        monitor gets a wider container and room to reflow, such as into three panes or four cards,
                        instead of sixteen tracks. Use <code>xxl</code> for that. <code>container wide</code> raises
                        the cap to 2400px; <code>container max</code> drops it.
                    </p>

                    <h5>Adding responsiveness</h5>
                    <p>
                        The previous examples set only the default Compact size with <code>s12</code>.
                        That works for a fixed layout, because the rules apply upward to larger sizes: s12 alone
                        means <code>s12 m12
                        l12</code>. Set the other sizes explicitly to make the layout responsive.
                    </p>

                    <div class="row">
                        <div class="s12 primary-container on-primary-container-text center-align py-3">
                            <span class="flow-text">I am always full-width (s12)</span>
                        </div>
                        <div class="s12 m6 primary-container on-primary-container-text center-align py-3">
                            <span class="flow-text">I am full-width on mobile (s12 m6)</span>
                        </div>
                    </div>
                    <Code code={`
<div class="row">
  <div class="s12">I am always full-width (s12)</div>
  <div class="s12 m6">I am full-width on mobile (s12 m6)</div>
</div>
`} />

                    <h5>Responsive side navigation layout</h5>
                    <p>
                        This example makes the same layout responsive by setting how many columns each div takes at
                        each screen size. Resize your browser to watch the layout change.
                    </p>

                    <div class="row">
                        <div class="s12">
                            <div class="browser-window">
                                <div class="surface-container-highest">
                                    <div class="browser-circles">
                                        <div class="circle error"></div>
                                        <div class="circle secondary"></div>
                                        <div class="circle tertiary"></div>
                                    </div>
                                </div>
                                <div>
                                    <div class="row g-0">
                                        <div class="site-layout-top s12 primary"></div>
                                        <div class="site-layout-pane s12 m4 l3 surface-container-highest">
                                            <p class="docs-bar surface"></p>
                                            <p class="docs-bar surface"></p>
                                            <p class="docs-bar surface"></p>
                                        </div>
                                        <div class="site-layout-pane s12 m8 l9 primary-container">
                                            <p class="docs-bar surface"></p>
                                            <p class="docs-bar surface"></p>
                                            <p class="docs-bar surface"></p>
                                            <p class="docs-bar surface"></p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <Code code={`
<!-- Navbar goes here -->
<!-- Page Layout here -->
<div class="row">
  <div class="s12 m4 l3">
    <!-- Grey navigation panel
          This content will be:
      3-columns-wide on Expanded and larger screens,
      4-columns-wide on Medium screens,
      12-columns-wide on Compact screens -->
  </div>
  <div class="s12 m8 l9">
    <!-- Teal page content
          This content will be:
      9-columns-wide on Expanded and larger screens,
      8-columns-wide on Medium screens,
      12-columns-wide on Compact screens -->
  </div>
</div>
`} />

                    <h5>More responsive grid examples</h5>
                    <div class="row">
                        <div class="s12 primary-container on-primary-container-text center-align py-3">
                            <span class="flow-text">s12</span>
                        </div>
                        <div class="s12 m4 l2 secondary-container on-secondary-container-text center-align py-3">
                            <span class="flow-text">s12 m4 l2</span>
                        </div>
                        <div class="s12 m4 l8 secondary-container on-secondary-container-text center-align py-3">
                            <span class="flow-text">s12 m4 l8</span>
                        </div>
                        <div class="s12 m4 l2 secondary-container on-secondary-container-text center-align py-3">
                            <span class="flow-text">s12 m4 l2</span>
                        </div>
                        <div class="s12 m6 l3 tertiary-container on-tertiary-container-text center-align py-3">
                            <span class="flow-text">s12 m6 l3</span>
                        </div>
                        <div class="s12 m6 l3 tertiary-container on-tertiary-container-text center-align py-3">
                            <span class="flow-text">s12 m6 l3</span>
                        </div>
                        <div class="s12 m6 l3 tertiary-container on-tertiary-container-text center-align py-3">
                            <span class="flow-text">s12 m6 l3</span>
                        </div>
                        <div class="s12 m6 l3 tertiary-container on-tertiary-container-text center-align py-3">
                            <span class="flow-text">s12 m6 l3</span>
                        </div>
                    </div>

                    <Code code={`
<div class="row">
  <div class="s12">s12</div>
  <div class="s12 m4 l2">s12 m4 l2</div>
  <div class="s12 m4 l8">s12 m4 l8</div>
  <div class="s12 m4 l2">s12 m4 l2</div>
  <div class="s12 m6 l3">s12 m6 l3</div>
  <div class="s12 m6 l3">s12 m6 l3</div>
  <div class="s12 m6 l3">s12 m6 l3</div>
  <div class="s12 m6 l3">s12 m6 l3</div>
</div>
`} />

                    <h5>Widescreen / 4K</h5>
                    <p>
                        Extra-large windows can hold a third pane that would be cramped on a laptop. The aside stacks
                        full-width until <code>xxl</code>, then sits as two columns beside an eight-column main. Four
                        equal cards drop from 6-wide on tablet to 3-wide on a 4K monitor.
                    </p>
                    <div class="row">
                        <div class="s12 l3 xxl2 primary-container on-primary-container-text center-align py-3">
                            <span class="flow-text">nav s12 l3 xxl2</span>
                        </div>
                        <div class="s12 l9 xxl8 secondary-container on-secondary-container-text center-align py-3">
                            <span class="flow-text">main s12 l9 xxl8</span>
                        </div>
                        <div class="s12 xxl2 tertiary-container on-tertiary-container-text center-align py-3">
                            <span class="flow-text">aside s12 xxl2</span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="s12 m6 l4 xxl3 primary-container on-primary-container-text center-align py-3">
                            <span class="flow-text">s12 m6 l4 xxl3</span>
                        </div>
                        <div class="s12 m6 l4 xxl3 primary-container on-primary-container-text center-align py-3">
                            <span class="flow-text">s12 m6 l4 xxl3</span>
                        </div>
