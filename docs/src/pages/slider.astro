---
import DocsLayout from "../layouts/DocsLayout.astro";
import PageBody from "../components/PageBody.astro";
import Section from "../components/Section.astro";
import Code from "../components/Code.astro";
import { defineSections } from "../lib/sections";

const S = defineSections([
  { id: "anatomy", label: "Anatomy", heading: false },
  { id: "variants", label: "Variants" },
  { id: "sizes", label: "Sizes" },
  { id: "icon", label: "Icon, stops, value", heading: "Inset icon, stops, value" },
  { id: "vertical", label: "Vertical" },
  { id: "disabled", label: "Disabled" },
  { id: "initialization", label: "Initialization" },
  { id: "methods", label: "Methods" },
]);
---
<DocsLayout page="sliders">
<PageBody sections={S}>
  <Section {...S.anatomy}>
        <p class="flow-text">
          Sliders let people pick from a range of values. An
          <code>&lt;input type="range"&gt;</code> is the control. A wrapping
          <code>.slider</code> — or <code>.range</code>, or a
          <code>&lt;label&gt;</code> — is the host. The plugin is
          <code>Expressive.Slider</code>, and <code>Expressive.Range</code>
          still resolves to it.
        </p>
        <p>
          Three variants: <strong>standard</strong> (active from the start),
          <strong>centered</strong> (active grows from the midpoint), and
          <strong>range</strong> (two handles, active between them). Horizontal
          or vertical. Five sizes: XS (the default), S, M, L, XL. Optional
          inset icon, discrete stops, and a value indicator.
        </p>
        <p>
          Tokens follow the
          <a href="https://m3.material.io/components/sliders/specs">M3 slider spec</a>
          (Expressive). The handle is a 4dp stop with a 6dp gap to each
          track. Active is <code>primary</code>; inactive is
          <code>secondary-container</code>. The end of an inactive track
          has a 4dp stop. The value label is a 40dp
          <code>inverse-surface</code> bubble.
        </p>
        <p>
          Range is not in <code>AutoInit()</code>. Importing the IIFE
          bundle calls <code>Expressive.Range.Init()</code>, which
          starts every <code>input[type=range]</code> already in the
          document and keeps the active track in sync.
        </p>
        <form>
          <label>
            Volume
            <input type="range" min="0" max="100" value="40">
          </label>
        </form>
<Code code={`
<label>
  Volume
  <input type="range" min="0" max="100" value="40">
</label>
`} />
  </Section>

  <Section {...S.variants}>
        <p>
          Standard is the default. <code>centered</code> grows the active
          track from 50%. A range slider is two inputs in one
          <code>.range</code> host.
        </p>
        <form>
          <div class="slider">
            <input type="range" min="0" max="100" value="40" aria-label="Standard">
          </div>
          <div class="slider centered">
            <input type="range" min="0" max="100" value="30" aria-label="Centered">
          </div>
          <div class="slider">
            <input type="range" min="0" max="100" value="25" aria-label="Range start">
            <input type="range" min="0" max="100" value="75" aria-label="Range end">
          </div>
        </form>
<Code code={`
<div class="slider">
  <input type="range" min="0" max="100" value="40" aria-label="Standard">
</div>

<div class="slider centered">
  <input type="range" min="0" max="100" value="30" aria-label="Centered">
</div>

<div class="slider">
  <input type="range" min="0" max="100" value="25" aria-label="Range start">
  <input type="range" min="0" max="100" value="75" aria-label="Range end">
</div>
`} />
  </Section>

  <Section {...S.sizes}>
        <p>
          Default is XS (16dp track, 44dp handle).
          <code>s</code> / <code>small</code> is S,
          <code>m</code> / <code>medium</code> is M,
          <code>l</code> / <code>large</code> is L,
          <code>xl</code> is XL. Scope them on the host.
        </p>
        <form>
          <div class="slider">
            <input type="range" min="0" max="100" value="40" aria-label="XS">
          </div>
          <div class="slider s">
            <input type="range" min="0" max="100" value="40" aria-label="S">
          </div>
          <div class="slider m">
            <input type="range" min="0" max="100" value="40" aria-label="M">
          </div>
          <div class="slider l">
            <input type="range" min="0" max="100" value="40" aria-label="L">
          </div>
          <div class="slider xl">
            <input type="range" min="0" max="100" value="40" aria-label="XL">
          </div>
        </form>
<Code code={`
<div class="slider s">…</div>
<div class="slider m">…</div>
<div class="slider l">…</div>
<div class="slider xl">…</div>
`} />
  </Section>

  <Section {...S.icon}>
        <p>
          A leading icon sits in the active track —
          M, L, and XL are tall enough. <code>stops</code> plus
          <code>step</code> paints ticks on the active track. Dragging
          shows the value in a 40dp bubble.
        </p>
        <form>
          <div class="slider m">
            <span class="material-symbols" aria-hidden="true">volume_up</span>
            <input type="range" min="0" max="100" value="55" aria-label="Volume">
          </div>
          <div class="slider stops">
            <input type="range" min="0" max="100" step="20" value="40" aria-label="Stops">
          </div>
        </form>
<Code code={`
<div class="slider m">
  <span class="material-symbols" aria-hidden="true">volume_up</span>
  <input type="range" min="0" max="100" value="55" aria-label="Volume">
</div>

<div class="slider stops">
  <input type="range" min="0" max="100" step="20" value="40" aria-label="Stops">
</div>
`} />
  </Section>

  <Section {...S.vertical}>
        <p>
          <code>vertical</code> stands the track up. Minimum is at the
          bottom.
        </p>
        <form>
          <div class="slider vertical m">
            <input type="range" min="0" max="100" value="60" aria-label="Level">
          </div>
        </form>
<Code code={`
<div class="slider vertical m">
  <input type="range" min="0" max="100" value="60" aria-label="Level">
</div>
`} />
  </Section>

  <Section {...S.disabled}>
        <p>The native <code>disabled</code> attribute drops the control to 38%.</p>
        <form>
          <label>
            Locked
            <input type="range" min="0" max="100" value="30" disabled>
          </label>
        </form>
  </Section>

  <Section {...S.initialization}>
        <p>
          Put the script after the inputs, or call <code>init</code>
          yourself. There are no options. For a slider added after load:
        </p>
<Code code={`
document.addEventListener('DOMContentLoaded', function() {
  const elems = document.querySelectorAll('input[type=range]');
  Expressive.Range.init(elems);
});

Expressive.Range.init(document.querySelector('#volume'));
`} />
  </Section>

  <Section {...S.methods}>
<Code code={`
const instance = Expressive.Range.getInstance(elem);
instance.destroy();
`} />
        <p>Destroy the plugin instance, remove the value label, and tear down its event handlers.</p>
  </Section>

</PageBody>
</DocsLayout>
