---
import DocsLayout from "../layouts/DocsLayout.astro";
import Section from "../components/Section.astro";
import Code from "../components/Code.astro";
import { defineSections } from "../lib/sections";

const S = defineSections([
  { id: "basic", label: "Basic", heading: false },
  { id: "contained", label: "Contained" },
  { id: "vs-progress", label: "Or a progress indicator?" },
  { id: "tokens", label: "Tokens" },
]);
---
<DocsLayout page="loading_indicator" sections={S}>
  <Section {...S.basic}>
        <p class="flow-text">
          The loading indicator is M3 Expressive's indicator for a short wait.
          It is a single CSS-only element and needs no JavaScript plugin. The
          shape morphs through a circle and four cookie shapes while the whole
          indicator rotates.
        </p>
        <p class="py-5 center-align">
          <span class="loading-indicator" role="status" aria-label="Loading"></span>
        </p>
<Code code={`
<span class="loading-indicator" role="status" aria-label="Loading"></span>
`} />
        <p>
          The element is empty, so it reports nothing on its own.
          Give the waiting state a name and make status text updates meaningful.
          Then check what assistive technology actually announces, because a
          name alone does not guarantee an announcement. The framework
          currently requires a named status. An indeterminate
          <code>progressbar</code>, which omits <code>aria-valuenow</code>,
          is also valid.
        </p>
  </Section>
  <Section {...S.contained}>
        <p>
          Add <code>contained</code> to put the indicator on a
          <code>secondary-container</code> circle and switch it to
          <code>on-secondary-container</code>. Use it over an image, a
          coloured surface, or anything else the plain indicator would get
          lost against.
        </p>
        <p class="py-5 center-align">
          <span class="loading-indicator contained" role="status" aria-label="Loading"></span>
        </p>
<Code code={`
<span class="loading-indicator contained" role="status" aria-label="Loading"></span>
`} />
  </Section>
  <Section {...S["vs-progress"]}>
        <p>
          Use it for short waits with unknown progress. It replaces most
          indeterminate circular uses. Keep a progress indicator for a process
          that will switch to a determinate value. Google's button guidance
          also keeps circular progress.
        </p>
        <table class="striped">
          <thead>
            <tr><th>Situation</th><th>Use</th></tr>
          </thead>
          <tbody>
            <tr><td>Under 200&nbsp;ms</td><td>Nothing. Show the result.</td></tr>
            <tr><td>Up to about 5&nbsp;s, percentage unknown</td><td><code>.loading-indicator</code></td></tr>
            <tr><td>Longer, percentage known</td><td><code>.progress</code>, determinate</td></tr>
            <tr><td>Longer, percentage unknown</td><td><code>.progress</code>, indeterminate linear</td></tr>
          </tbody>
        </table>
  </Section>
  <Section {...S.tokens}>
        <p>
          Override any of these to retheme one indicator. The colours are role
          tokens, never raw hex.
        </p>
        <table class="striped">
          <thead>
            <tr><th>Token</th><th>Default</th><th>What it sets</th></tr>
          </thead>
          <tbody>
            <tr><td><code>--md-comp-loading-indicator-active-indicator-size</code></td><td><code>38px</code></td><td>The morphing shape.</td></tr>
            <tr><td><code>--md-comp-loading-indicator-container-size</code></td><td><code>48px</code></td><td>The box it sits in, which is the visible circle when <code>contained</code>.</td></tr>
            <tr><td><code>--md-comp-loading-indicator-active-indicator-color</code></td><td><code>primary</code></td><td>The shape's fill.</td></tr>
            <tr><td><code>--md-comp-loading-indicator-container-color</code></td><td><code>transparent</code></td><td>The container fill.</td></tr>
            <tr><td><code>--md-comp-loading-indicator-duration</code></td><td><code>3000ms</code></td><td>One full morph-and-spin cycle.</td></tr>
          </tbody>
        </table>
        <div class="row py-5">
          <div class="s4 center-align">
            <span class="loading-indicator" style="--md-comp-loading-indicator-active-indicator-color: var(--md-sys-color-error)" role="status" aria-label="Loading"></span>
          </div>
          <div class="s4 center-align">
            <span class="loading-indicator" style="--md-comp-loading-indicator-active-indicator-color: var(--md-sys-color-tertiary)" role="status" aria-label="Loading"></span>
          </div>
          <div class="s4 center-align">
            <span class="loading-indicator" style="--md-comp-loading-indicator-active-indicator-size: 76px; --md-comp-loading-indicator-container-size: 96px" role="status" aria-label="Loading"></span>
          </div>
        </div>
<Code code={`
<span class="loading-indicator"
      style="--md-comp-loading-indicator-active-indicator-color: var(--md-sys-color-error)"
      role="status" aria-label="Loading"></span>
`} />
        <p>
          <code>prefers-reduced-motion: reduce</code> stops both animations
          and leaves the circle.
        </p>
  </Section>
</DocsLayout>
