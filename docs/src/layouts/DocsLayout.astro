---
import { existsSync } from "node:fs";
import { join } from "node:path";

import pkg from "../../../package.json";
import Footer from "../components/Footer.astro";
import PageHeader from "../components/PageHeader.astro";
import DocsNavigation from "../components/DocsNavigation.astro";
import PageBody from "../components/PageBody.astro";
import { NAV } from "../data/nav";
import { markdownRoute, page, route } from "../lib/catalogue";
import type { Sections } from "../lib/sections";

/**
 * Every documentation page: head, the pre-paint theme restore, the app bar and
 * navigation, the page itself, the footer, and the three scripts every page
 * loads. The title and the page header come from the shared catalogue rather
 * than being restated per page, so a page cannot call itself one thing in
 * navigation and another in its own heading.
 */
interface Props {
  /** The catalogue id of the page being rendered. */
  page: string;
  /** The page's sections, for its table of contents. */
  sections: Sections;
  /** A wider content column, for pages with wide demos. */
  wide?: boolean;
}

const { page: id, sections, wide } = Astro.props;

const entry = page(id);
const pageName = entry.title ?? entry.label;
const description = entry.description;
const markdownPath = markdownRoute(id);

// package.json is the only statement of the version the site makes, so the
// footer cannot drift from what `npm install` hands out. Semver puts a
// prerelease after a hyphen.
const version: string = pkg.version;
const prerelease = version.includes("-");

// Unminified while developing so the source maps stay usable.
const suffix = import.meta.env.DEV ? "" : ".min";
const cssUrl = `/dist/css/expressive${suffix}.css`;
const jsUrl = `/dist/js/expressive${suffix}.js`;
// Stamped in by astro.config.mjs -- see the note there.
declare const __REPO_ROOT__: string;
const buildMissing = !existsSync(join(__REPO_ROOT__, "dist/css"));

// Self-referential, on every page. Every page except the landing page has
// exactly one URL, so for them this is a formality. The landing page has two:
// a static host serves the root document at both `/` and `/index.html`, and
// making the root canonical in the *links* does nothing about the second URL,
// which stays reachable and independently indexable. Declaring it here is what
// makes the root canonical to a crawler rather than only to a reader.
//
// And `Astro.url.pathname` is `/index.html` for the index route under
// `build.format: 'file'` -- the very URL being disowned -- so it is normalised
// rather than used as given.
const path = Astro.url.pathname.replace(/\/index\.html$/, "/");
const canonical = new URL(path, Astro.site).href;
const sourceColorNames = ["Lagoon", "Harbor", "Breeze", "Cobalt", "Iris"];
const sourceColorPalettes = [
  { name: "Bold", colors: ["#179299", "#209fb5", "#04a5e5", "#1e66f5", "#8839ef"] },
  { name: "Soft", colors: ["#81c8be", "#85c1dc", "#99d1db", "#8caaee", "#ca9ee6"] },
  { name: "Mist", colors: ["#8bd5ca", "#7dc4e4", "#91d7e3", "#8aadf4", "#c6a0f6"] },
  { name: "Glow", colors: ["#94e2d5", "#74c7ec", "#89dceb", "#89b4fa", "#cba6f7"] },
];
---
<!DOCTYPE html>
<html lang="en" theme="auto">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{`${pageName} - ExpressiveCSS`}</title>
    <meta name="description" content={description}>
    <link rel="canonical" href={canonical}>
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="ExpressiveCSS">
    <meta property="og:title" content={pageName}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={canonical}>
    <meta name="twitter:card" content="summary">
    <link rel="describedby" href="/llms.txt">
    <link rel="alternate" type="text/markdown" href={markdownPath}>
    <link rel="stylesheet" href={cssUrl}>
    <link rel="stylesheet" href={`/static/docs.css?v=${version}`}>
    {/* Apply a stored --md-source before first paint so the page does not flash the default seed. */}
    <script is:inline>
        (function () {
            try {
                var t = localStorage.getItem('theme');
                if (t === 'light' || t === 'dark' || t === 'auto') {
                    document.documentElement.setAttribute('theme', t);
                }
                var c = localStorage.getItem('md-source');
                if (c && /^#[0-9A-Fa-f]{6}$/.test(c)) {
                    document.documentElement.style.setProperty('--md-source', c);
                }
                if (localStorage.getItem('glass') === 'true') {
                    document.documentElement.style.setProperty('--expressive-glass', 'true');
                }
            } catch (e) {
            }
        })();
    </script>
    {/* A page that needs its own <head> content -- an extra font, say -- fills this. */}
    <slot name="head" />
</head>
<body class="docs">
{buildMissing && (
    <div class="build-warning error-container on-error-container-text">
        No build found in <code>dist/</code> &mdash; run <code>npm run build</code> (or <code>npm run watch</code>) and
        reload.
    </div>
)}

    <a class="visually-hidden-focusable button filled docs-skip-link" href="#docs-main">Skip to content</a>

    <header class="docs-app-bar">
        <div class="bar">
            <button type="button" id="docs-navigation-trigger" class="hide-on-large-only hide-on-extra-large-only" commandfor="docs-navigation-dialog" command="show-modal" aria-label="Browse documentation" aria-haspopup="dialog" aria-controls="docs-navigation-dialog">
                <span class="material-symbols" aria-hidden="true">menu</span>
            </button>
            <h2 class="docs-brand"><a href="/">ExpressiveCSS</a></h2>
            <button type="button" class="tonal docs-search-trigger hide-on-compact-only" commandfor="docs-search" command="show-modal" aria-label="Search documentation" aria-keyshortcuts="Control+K Meta+K">
                <span class="material-symbols" aria-hidden="true">search</span>
                <span>Search</span>
                <kbd class="docs-search-shortcut">Ctrl K</kbd>
            </button>
            <button type="button" class="hide-on-med-and-up" commandfor="docs-search" command="show-modal" title="Search (Ctrl+K)" aria-label="Search documentation" aria-keyshortcuts="Control+K Meta+K">
                <span class="material-symbols" aria-hidden="true">search</span>
            </button>
            <button type="button" id="source-color-toggle" title="Choose source color" aria-label="Choose source color" aria-haspopup="dialog" aria-controls="source-color-dialog">
                <span class="material-symbols" aria-hidden="true">palette</span>
            </button>
            <button type="button" id="glass-toggle" title="Frosted glass" aria-label="Frosted glass" aria-pressed="false">
                <span class="material-symbols" aria-hidden="true">blur_on</span>
            </button>
            <button type="button" id="theme-toggle" class="menu-trigger no-autoinit" data-target="theme-menu" title="Theme" aria-label="Choose theme" aria-haspopup="menu" aria-controls="theme-menu">
                <span class="material-symbols" aria-hidden="true">contrast</span>
            </button>
        </div>
    </header>

<DocsNavigation current={id} />

    <main id="docs-main" tabindex="-1">
        <div class="docs-page">
            <PageHeader page={id} title={pageName} description={description} markdownPath={markdownPath}>
                <slot name="banner" />
            </PageHeader>
            <PageBody sections={sections} wide={wide}>
                <slot name="toc-extra" slot="toc-extra" />
                <slot />
            </PageBody>
        </div>
    </main>

    {/* Ctrl+K site search over the page catalogue: titles, then descriptions as keywords. */}
    <dialog id="docs-search" class="command-palette" aria-label="Search documentation">
        <input type="search" placeholder="Search documentation" aria-label="Search documentation">
        <ul>
            {NAV.map((group) => (
                <Fragment>
                    <li class="label">{group.label}</li>
                    {group.pages.map((p) => (
                        <li>
                            <a href={route(p.id)} data-keywords={`${p.title ?? ""} ${p.description}`}>
                                <span class="material-symbols" aria-hidden="true">{group.icon}</span>
                                {p.label}
                            </a>
                        </li>
                    ))}
                </Fragment>
            ))}
        </ul>
        <p class="command-palette-empty" role="status">No matching pages</p>
    </dialog>

    <menu id="theme-menu">
        <li data-theme="light" role="menuitemradio" aria-checked="false">
            <button type="button">
                <span class="material-symbols" aria-hidden="true">light_mode</span>
                Light
            </button>
        </li>
        <li data-theme="dark" role="menuitemradio" aria-checked="false">
            <button type="button">
                <span class="material-symbols" aria-hidden="true">dark_mode</span>
                Dark
            </button>
        </li>
        <li data-theme="auto" class="selected" role="menuitemradio" aria-checked="true">
            <button type="button">
                <span class="material-symbols" aria-hidden="true">contrast</span>
                Auto
            </button>
        </li>
    </menu>

    <dialog id="source-color-dialog" aria-labelledby="source-color-title">
        <span class="material-symbols" aria-hidden="true">palette</span>
        <h2 id="source-color-title">Source color</h2>
        <div>
            <p>
                The seed every generated ramp derives from. Pick one and browse
                the docs &mdash; the whole theme follows. Error does not: it is
                a fixed hue.
            </p>
            <div role="radiogroup" aria-label="Preset source colors">
              <p>Default source: Mist Iris.</p>
              <p>ExpressiveCSS presets: Lagoon, Harbor, Breeze, Cobalt, Iris.</p>
              {sourceColorPalettes.map(({ name, colors }) => (
                <div>
                  <p>{name}</p>
                  <div class="source-color-swatches">
                    {colors.map((color, index) => (
                      <button type="button" class="source-color-swatch" role="radio" aria-checked="false" data-source={color} title={`${name} ${sourceColorNames[index]} (${color})`} aria-label={`${name} ${sourceColorNames[index]}`} style={`background:${color}`}></button>
                    ))}
                  </div>
                </div>
              ))}
            </div>
            <div class="source-color-custom">
                <input id="source-color-input" type="color" value="#c6a0f6" aria-label="Custom source color">
                <div class="field outlined">
                    <input id="source-color-hex" type="text" spellcheck="false" maxlength="7" value="#c6a0f6" placeholder=" " autocomplete="off">
                    <label for="source-color-hex">Hex</label>
                </div>
            </div>
            <div class="source-color-preview" aria-hidden="true">
                <span class="source-color-chip primary on-primary-text">primary</span>
                <span class="source-color-chip secondary on-secondary-text">secondary</span>
                <span class="source-color-chip tertiary on-tertiary-text">tertiary</span>
                <span class="source-color-chip error on-error-text">error</span>
            </div>
        </div>
        <form method="dialog">
            <button type="button" class="text" id="source-color-reset">Reset</button>
            <button type="submit" value="done">Done</button>
        </form>
    </dialog>

<Footer version={version} prerelease={prerelease} />

<script is:inline src={jsUrl}></script>
<script is:inline src={`/static/docs.js?v=${version}`}></script>
<script is:inline src="/static/code-blocks.js"></script>
</body>
</html>
