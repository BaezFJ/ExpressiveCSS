---
/**
 * One compatibility page: an old URL that now resolves somewhere else.
 *
 * Three mechanisms, in the order they fire. `<link rel="canonical">` tells a
 * crawler which page this is, so the alias never becomes a second indexed copy
 * of its target. The script moves a reader immediately and carries whatever
 * query string and fragment they arrived with -- a deep link keeps its intent.
 * `<meta http-equiv="refresh">` is the fallback when scripting is off; it
 * cannot carry the query or the fragment, which is exactly why it is second.
 *
 * `replace`, not `assign`: the alias must not sit in history, or Back from the
 * canonical page lands on the redirect and bounces forward again.
 */
interface Props {
  /** The canonical path this alias resolves to. Root-absolute. */
  to: string;
}

const { to } = Astro.props;
const canonical = new URL(to, Astro.site).href;
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>Redirecting to {to}</title>
    <link rel="canonical" href={canonical}>
    <meta name="robots" content="noindex, follow">
    <meta http-equiv="refresh" content={`0; url=${to}`}>
    <script is:inline define:vars={{ to }}>
        location.replace(to + location.search + location.hash);
    </script>
</head>
<body>
<p>This page has moved to <a href={to}>{to}</a>.</p>
</body>
</html>
