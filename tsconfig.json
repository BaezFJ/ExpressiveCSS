{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],

    // The vendored Materialize sources predate class-field "define" semantics:
    // subclasses declare fields that the constructor assigns after super().
    // Keep assignment semantics so those values are not reset to undefined.
    "useDefineForClassFields": false,

    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "noImplicitOverride": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,

    // docs/src is imported by tests and by scripts/verify-site.mjs through
    // Node's type stripping, which does no extensionless resolution the way a
    // bundler does. Those modules therefore write the `.ts` extension, and
    // this is what lets TypeScript read it. Safe here only because nothing
    // emits: `noEmit` is set below and docs/src is outside tsconfig.build.json.
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "noEmit": true
  },
  // docs/src carries the Astro documentation site's shared page catalogue (ADR 0003).
  // Not in tsconfig.build.json: it is site source, not part of the package.
  "include": ["src/ts", "docs/src"]
}
