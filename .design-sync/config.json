{
  "projectId": "67ea944b-4c5f-432d-9451-6573f7bdb6bf",
  "shape": "package",
  "pkg": "@expressivecss/expressive",
  "globalName": "Expressive",
  "buildCmd": "npm run build && node .design-sync/build-css.mjs",
  "cssEntry": ".design-sync/.cache/expressive-ds.css",
  "guidelinesGlob": [
    "m3-guidelines.md",
    "llm.md"
  ],
  "overrides": {
