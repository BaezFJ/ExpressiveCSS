      "primaryStory": "Modal"
    },
    "BottomSheets": {
      "cardMode": "single",
      "primaryStory": "Modal"
    },
    "Snackbar": {
      "cardMode": "column"
    }
  },
  "readmeHeader": ".design-sync/conventions.md"
}
