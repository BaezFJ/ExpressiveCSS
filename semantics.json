    "chips": {
      "status": "enforced",
      "note": "Swept 0.8.0. The four Material 3 chip types plus a non-interactive display chip, across three root elements; the delete affordance is a real button.",
      "rules": [
        {
          "id": "chip-root-element",
          "kind": "forbid",
          "selector": ".chip:not(span):not(button):not(label)",
          "message": "A chip is <span> (display), <button> (assist/suggestion/input), or <label> (filter). Never <div>."
        },
        {
          "id": "chip-not-focusable-span",
          "kind": "forbid",
          "selector": "span.chip[tabindex]",
          "message": "A display chip is not a control and must not be in the tab order. Put the action on a nested <button>."
        },
        {
          "id": "chip-close-is-button",
          "kind": "forbid",
          "selector": ".chip .close:not(button)",
          "message": "The chip delete affordance is a control: use <button type=\"button\" class=\"close\">, not <i> or <span>."
        },
        {
          "id": "chip-close-type-button",
          "kind": "require-attr",
          "selector": ".chip button.close",
          "attr": "type",
          "equals": "button",
          "message": "A <button> inside a form defaults to type=submit. Chip delete buttons must set type=\"button\"."
        },
        {
          "id": "chip-close-has-label",
          "kind": "require-attr",
          "selector": ".chip button.close",
          "attr": "aria-label",
          "message": "The delete button contains only an icon, so it needs an accessible name naming the chip it removes."
        },
        {
          "id": "chip-no-i-element",
          "kind": "forbid",
          "selector": ".chip i",
          "message": "<i> means idiomatic text, not icon. Use <span class=\"material-symbols\" aria-hidden=\"true\">."
        },
        {
          "id": "chip-icon-hidden",
          "kind": "require-attr",
          "selector": ".chip :is(.material-symbols,.material-symbols-outlined,.material-symbols-rounded,.material-symbols-sharp,.material-icons)",
          "attr": "aria-hidden",
          "equals": "true",
          "message": "A ligature icon is read aloud verbatim. Decorative icons inside a labelled control must be aria-hidden."
        },
        {
          "id": "filter-chip-label-for",
          "kind": "require-attr",
          "selector": "label.chip",
          "attr": "for",
          "message": "A filter chip is <input type=\"checkbox\"> + <label class=\"chip\">; the label must point at its input."
        }
      ]
    },
