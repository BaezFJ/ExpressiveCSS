      "rules": [
        {
          "id": "icon-not-i-element",
          "kind": "forbid",
          "selector": "i.material-symbols, i.material-symbols-outlined, i.material-symbols-rounded, i.material-symbols-sharp, i.material-icons",
          "message": "<i> means idiomatic text. The canonical icon element is <span class=\"material-symbols\">."
        },
        {
          "id": "icon-hidden-from-at",
          "kind": "require-attr",
          "selector": ".material-symbols, .material-symbols-outlined, .material-symbols-rounded, .material-symbols-sharp, .material-icons",
          "attr": "aria-hidden",
          "equals": "true",
          "message": "The ligature is text and is announced. Decorative icons carry aria-hidden=\"true\"; the control carries the label."
        }
      ]
    },
